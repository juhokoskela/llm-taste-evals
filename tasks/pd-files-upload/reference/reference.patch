+// Upload adds a file by encoding content as a multipart/form-data body.
+// Unlike Add, the encoded body is replayable, so uploads participate in
+// retries even when content itself is not seekable.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+
+	contentType, body, err := multipartbody.NewFile("file", fileName, content)
+	if err != nil {
+		return nil, err
+	}
+
+	return s.Add(ctx, body, contentType, opts...)
+}
