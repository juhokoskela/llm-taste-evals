+// AddFile uploads a file to Pipedrive and optionally associates it with a
+// deal, person, organization, product, activity, lead or project.
+//
+// Unlike Add, it builds the multipart/form-data request itself: pass the
+// name the file should have in Pipedrive and a reader over its content,
+// for example an *os.File. The content is encoded into a replayable body,
+// so uploads are safely retried on 429/5xx according to the configured
+// RetryPolicy even when the source reader can only be read once.
+func (s *FilesService) AddFile(ctx context.Context, fileName string, content io.Reader, opts ...AddFileOption) (*File, error) {
+	if fileName == "" || content == nil {
+		return nil, fmt.Errorf("file name and content are required")
+	}
+	cfg := newAddFileOptions(opts)
+
+	fields := url.Values{}
+	if cfg.payload.dealID != nil {
+		if err := validateID(*cfg.payload.dealID, "deal id"); err != nil {
+			return nil, err
+		}
+		fields.Set("deal_id", strconv.FormatInt(int64(*cfg.payload.dealID), 10))
+	}
+	if cfg.payload.personID != nil {
+		if err := validateID(*cfg.payload.personID, "person id"); err != nil {
+			return nil, err
+		}
+		fields.Set("person_id", strconv.FormatInt(int64(*cfg.payload.personID), 10))
+	}
+	if cfg.payload.orgID != nil {
+		if err := validateID(*cfg.payload.orgID, "organization id"); err != nil {
+			return nil, err
+		}
+		fields.Set("org_id", strconv.FormatInt(int64(*cfg.payload.orgID), 10))
+	}
+	if cfg.payload.productID != nil {
+		if err := validateID(*cfg.payload.productID, "product id"); err != nil {
+			return nil, err
+		}
+		fields.Set("product_id", strconv.FormatInt(int64(*cfg.payload.productID), 10))
+	}
+	if cfg.payload.activityID != nil {
+		if err := validateID(*cfg.payload.activityID, "activity id"); err != nil {
+			return nil, err
+		}
+		fields.Set("activity_id", strconv.FormatInt(int64(*cfg.payload.activityID), 10))
+	}
+	if cfg.payload.leadID != nil {
+		if err := validatePathParam(string(*cfg.payload.leadID), "lead id"); err != nil {
+			return nil, err
+		}
+		fields.Set("lead_id", string(*cfg.payload.leadID))
+	}
+	if cfg.payload.projectID != nil {
+		if err := validateID(*cfg.payload.projectID, "project id"); err != nil {
+			return nil, err
+		}
+		fields.Set("project_id", strconv.FormatInt(int64(*cfg.payload.projectID), 10))
+	}
+
+	contentType, body, err := multipartbody.NewFileWithFields("file", fileName, content, fields)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
