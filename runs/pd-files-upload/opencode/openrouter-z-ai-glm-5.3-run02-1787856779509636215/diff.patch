+package multipartbody
+
+import (
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func parseForm(t *testing.T, contentType string, body io.Reader) (url.Values, map[string]string) {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %q", mediaType)
+	}
+
+	form := url.Values{}
+	files := map[string]string{}
+	reader := multipart.NewReader(body, params["boundary"])
+	for {
+		part, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("next part: %v", err)
+		}
+		content, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		if part.FormName() == "file" && part.FileName() != "" {
+			files[part.FileName()] = string(content)
+		} else {
+			form.Add(part.FormName(), string(content))
+		}
+	}
+	return form, files
+}
+
+func TestNewFile_EncodesSingleFilePart(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "doc.txt", strings.NewReader("upload me"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	if body == nil {
+		t.Fatal("expected body reader")
+	}
+
+	form, files := parseForm(t, contentType, body)
+	if len(form) != 0 {
+		t.Fatalf("unexpected form fields: %v", form)
+	}
+	if got := files["doc.txt"]; got != "upload me" {
+		t.Fatalf("unexpected file content: %q", got)
+	}
+}
+
+func TestNewFileWithFields_EncodesFieldsAndFilePart(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "12")
+	fields.Set("person_id", "34")
+	fields.Set("lead_id", "adf21080-0e10-11eb-879b-05d71fb426ec")
+
+	contentType, body, err := NewFileWithFields("file", "report.pdf", strings.NewReader("%PDF-1.4 fake"), fields)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	form, files := parseForm(t, contentType, body)
+	if got := form.Get("deal_id"); got != "12" {
+		t.Fatalf("unexpected deal_id: %q", got)
+	}
+	if got := form.Get("person_id"); got != "34" {
+		t.Fatalf("unexpected person_id: %q", got)
+	}
+	if got := form.Get("lead_id"); got != "adf21080-0e10-11eb-879b-05d71fb426ec" {
+		t.Fatalf("unexpected lead_id: %q", got)
+	}
+	if got := files["report.pdf"]; got != "%PDF-1.4 fake" {
+		t.Fatalf("unexpected file content: %q", got)
+	}
+}
+
+func TestNewFileWithFields_ReplaysIndependently(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFileWithFields("file", "doc.txt", strings.NewReader("content"), nil)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	first, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("first read: %v", err)
+	}
+	if _, err := body.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek: %v", err)
+	}
+	second, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("second read: %v", err)
+	}
+	if string(first) != string(second) {
+		t.Fatalf("body is not replayable: %q != %q", first, second)
+	}
+	_, files := parseForm(t, contentType, strings.NewReader(string(second)))
+	if got := files["doc.txt"]; got != "content" {
+		t.Fatalf("unexpected replayed file content: %q", got)
+	}
+}
+
+func TestNewFileWithFields_EmptyFieldsStillEncodesFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFileWithFields("file", "doc.txt", strings.NewReader("x"), url.Values{})
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	form, files := parseForm(t, contentType, body)
+	if len(form) != 0 {
+		t.Fatalf("unexpected form fields: %v", form)
+	}
+	if got := files["doc.txt"]; got != "x" {
+		t.Fatalf("unexpected file content: %q", got)
+	}
+}
+
+func TestNewFileWithFields_Validation(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name      string
+		fieldName string
+		fileName  string
+		src       io.Reader
+	}{
+		{"missing field name", "", "doc.txt", strings.NewReader("x")},
+		{"missing file name", "file", "", strings.NewReader("x")},
+		{"missing content", "file", "doc.txt", nil},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			if _, _, err := NewFileWithFields(tc.fieldName, tc.fileName, tc.src, nil); err == nil {
+				t.Fatal("expected error")
+			}
+		})
+	}
+}
