+	// A pipe mirrors callers that stream file content straight from disk
+	// (os.Open + io.Copy) instead of pre-buffering it.
+	content, contentWriter := io.Pipe()
+	go func() {
+		_, _ = contentWriter.Write([]byte("streamed upload body"))
+		_ = contentWriter.Close()
