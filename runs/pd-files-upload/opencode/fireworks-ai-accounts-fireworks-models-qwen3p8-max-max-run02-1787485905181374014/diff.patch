@@ -0,0 +1,149 @@
+package multipartbody
+
+import (
+	"bytes"
+	"io"
+	"mime"
+	"mime/multipart"
+	"strings"
+	"testing"
+)
+
+func newMultipartReader(t *testing.T, contentType string, body *bytes.Reader) *multipart.Reader {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+	return multipart.NewReader(body, params["boundary"])
+}
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.pdf", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	reader := newMultipartReader(t, contentType, body)
+	part, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("read part: %v", err)
+	}
+	if part.FormName() != "file" {
+		t.Fatalf("unexpected form name: %s", part.FormName())
+	}
+	if part.FileName() != "report.pdf" {
+		t.Fatalf("unexpected file name: %s", part.FileName())
+	}
+	payload, err := io.ReadAll(part)
+	if err != nil {
+		t.Fatalf("read part payload: %v", err)
+	}
+	if string(payload) != "payload" {
+		t.Fatalf("unexpected payload: %q", payload)
+	}
+	if _, err := reader.NextPart(); err != io.EOF {
+		t.Fatalf("expected single part, got error %v", err)
+	}
+}
+
+func TestNewFileWithFields(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.pdf", strings.NewReader("payload"),
+		FormField{Name: "deal_id", Value: "3"},
+		FormField{Name: "lead_id", Value: "abc-123"},
+	)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	reader := newMultipartReader(t, contentType, body)
+
+	part, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if part.FormName() != "file" || part.FileName() != "report.pdf" {
+		t.Fatalf("unexpected file part: %s/%s", part.FormName(), part.FileName())
+	}
+
+	fields := map[string]string{}
+	for {
+		field, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("read field part: %v", err)
+		}
+		value, err := io.ReadAll(field)
+		if err != nil {
+			t.Fatalf("read field value: %v", err)
+		}
+		fields[field.FormName()] = string(value)
+	}
+	if len(fields) != 2 || fields["deal_id"] != "3" || fields["lead_id"] != "abc-123" {
+		t.Fatalf("unexpected fields: %#v", fields)
+	}
+}
+
+func TestNewFileBodyIsReplayable(t *testing.T) {
+	t.Parallel()
+
+	_, body, err := NewFile("file", "report.pdf", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	first, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	if _, err := body.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind body: %v", err)
+	}
+	second, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("re-read body: %v", err)
+	}
+	if !bytes.Equal(first, second) {
+		t.Fatalf("replayed body differs from original")
+	}
+}
+
+func TestNewFileValidation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "report.pdf", strings.NewReader("payload")); err == nil {
+		t.Fatal("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("payload")); err == nil {
+		t.Fatal("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "report.pdf", nil); err == nil {
+		t.Fatal("expected error for nil content")
+	}
+}
+
+func TestNewFileSourceReadError(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("file", "report.pdf", &errReader{err: io.ErrUnexpectedEOF}); err == nil {
+		t.Fatal("expected source read error")
+	}
+}
+
+type errReader struct {
+	err error
+}
+
+func (r *errReader) Read([]byte) (int, error) {
+	return 0, r.err
+}
