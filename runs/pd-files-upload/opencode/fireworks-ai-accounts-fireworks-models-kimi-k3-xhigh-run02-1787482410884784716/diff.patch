+func TestFilesService_Add_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("file")
+
+	var mu sync.Mutex
+	var bodies [][]byte
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     3,
+			BaseDelay:       time.Millisecond,
+			MaxDelay:        time.Millisecond,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, body)
+		calls := len(bodies)
+		mu.Unlock()
+
+		if calls == 1 {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limited"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), "upload.txt", bytes.NewReader(content))
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	if !bytes.Equal(bodies[0], bodies[1]) {
+		t.Fatalf("expected retried request to replay the same body")
+	}
+	if !bytes.Contains(bodies[0], content) {
+		t.Fatalf("expected request body to contain file content, got %q", bodies[0])
+	}
+}
