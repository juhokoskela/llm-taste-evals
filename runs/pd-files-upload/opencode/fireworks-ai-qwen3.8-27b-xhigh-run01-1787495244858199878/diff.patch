@@ -49,6 +53,61 @@ func WithRetryPolicy(policy RetryPolicy) RequestOption {
 	}
 }
 
+// BodyReplacer produces a fresh request body. It is invoked before the first
+// send and again before every retry, so it can re-read one-shot sources such
+// as an open file. Every call must return a reader serving the complete body
+// content; the reader is closed after each attempt.
+type BodyReplacer func() (io.Reader, error)
+
+// WithBodyReplacer replaces the request body with the replacer's output,
+// making one-shot uploads (for example streamed file uploads) replayable.
+// Retries are only possible when the body can be re-sent, so without a
+// replacer or a built-in replayable body, 429 and 5xx responses on POST and
+// PUT requests fail immediately. The replacer's output also becomes the body
+// of the first attempt, and its errors surface as request errors.
+func WithBodyReplacer(replacer BodyReplacer) RequestOption {
+	return func(o *requestOptions) {
+		if replacer == nil {
+			return
+		}
+		o.bodyReplacer = replacer
+	}
+}
+
+func bodyReplacerEditor(replacer BodyReplacer) RequestEditorFunc {
+	return func(_ context.Context, req *http.Request) error {
+		body, err := newReplacerBody(replacer)
+		if err != nil {
+			return err
+		}
+		if req.Body != nil {
+			_ = req.Body.Close()
+		}
+		req.Body = body
+		req.ContentLength = -1
+		req.Header.Del("Transfer-Encoding")
+		req.GetBody = func() (io.ReadCloser, error) {
+			body, err := newReplacerBody(replacer)
+			if err != nil {
+				return nil, err
+			}
+			return body, nil
+		}
+		return nil
+	}
+}
+
+func newReplacerBody(replacer BodyReplacer) (io.ReadCloser, error) {
+	body, err := replacer()
+	if err != nil {
+		return nil, fmt.Errorf("pipedrive: replace request body: %w", err)
+	}
+	if body == nil {
+		return nil, errors.New("pipedrive: body replacer returned a nil reader")
+	}
+	return io.NopCloser(body), nil
+}
+
