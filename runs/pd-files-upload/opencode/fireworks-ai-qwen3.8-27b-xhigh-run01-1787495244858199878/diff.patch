diff --git a/internal/multipartbody/multipartbody_test.go b/internal/multipartbody/multipartbody_test.go
new file mode 100644
index 0000000..18ed25a
--- /dev/null
+++ b/internal/multipartbody/multipartbody_test.go
@@ -0,0 +1,182 @@
+package multipartbody
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type parsedBody struct {
+	fields map[string]string
+	files  map[string]parsedFile
+}
+
+type parsedFile struct {
+	fileName string
+	content  []byte
+}
+
+func parseBody(t *testing.T, contentType string, body *bytes.Reader) parsedBody {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+
+	reader := multipart.NewReader(body, params["boundary"])
+	parsed := parsedBody{
+		fields: map[string]string{},
+		files:  map[string]parsedFile{},
+	}
+	for {
+		part, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		content, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part %q: %v", part.FormName(), err)
+		}
+		if part.FileName() != "" {
+			parsed.files[part.FormName()] = parsedFile{fileName: part.FileName(), content: content}
+		} else {
+			parsed.fields[part.FormName()] = string(content)
+		}
+	}
+	return parsed
+}
+
+func TestNewFile_SingleFilePart(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.pdf", strings.NewReader("pdf-bytes"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	parsed := parseBody(t, contentType, body)
+	if len(parsed.fields) != 0 {
+		t.Fatalf("unexpected fields: %#v", parsed.fields)
+	}
+	file, ok := parsed.files["file"]
+	if !ok {
+		t.Fatalf("missing file part: %#v", parsed)
+	}
+	if file.fileName != "report.pdf" {
+		t.Fatalf("unexpected file name: %q", file.fileName)
+	}
+	if !bytes.Equal(file.content, []byte("pdf-bytes")) {
+		t.Fatalf("unexpected file content: %q", file.content)
+	}
+}
+
+func TestNewFileWithFields_WritesFieldsAndFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFileWithFields("file", "report.pdf", strings.NewReader("pdf-bytes"), []Field{
+		{Name: "deal_id", Value: "1"},
+		{Name: "person_id", Value: "2"},
+	})
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	parsed := parseBody(t, contentType, body)
+	if parsed.fields["deal_id"] != "1" || parsed.fields["person_id"] != "2" {
+		t.Fatalf("unexpected fields: %#v", parsed.fields)
+	}
+	file, ok := parsed.files["file"]
+	if !ok {
+		t.Fatalf("missing file part: %#v", parsed)
+	}
+	if file.fileName != "report.pdf" {
+		t.Fatalf("unexpected file name: %q", file.fileName)
+	}
+	if !bytes.Equal(file.content, []byte("pdf-bytes")) {
+		t.Fatalf("unexpected file content: %q", file.content)
+	}
+}
+
+func TestNewFile_Replayable(t *testing.T) {
+	t.Parallel()
+
+	_, body, err := NewFile("file", "a.txt", strings.NewReader("data"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	// http.NewRequest only sets GetBody for readers it knows how to replay.
+	// The whole point of returning *bytes.Reader is that the retry transport
+	// can re-send the body, so verify that contract directly.
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.test", body)
+	if err != nil {
+		t.Fatalf("NewRequestWithContext error: %v", err)
+	}
+	if req.GetBody == nil {
+		t.Fatalf("expected request GetBody to be set")
+	}
+
+	first, err := io.ReadAll(req.Body)
+	if err != nil {
+		t.Fatalf("read first pass: %v", err)
+	}
+	replayed, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	defer replayed.Close()
+	second, err := io.ReadAll(replayed)
+	if err != nil {
+		t.Fatalf("read second pass: %v", err)
+	}
+	if !bytes.Equal(first, second) {
+		t.Fatalf("body is not replayable: %q vs %q", first, second)
+	}
+}
+
+func TestNewFile_Validation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "a.txt", strings.NewReader("data")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("data")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "a.txt", nil); err == nil {
+		t.Fatalf("expected error for nil source")
+	}
+}
+
+func TestNewFileWithFields_Validation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFileWithFields("file", "a.txt", strings.NewReader("data"), []Field{{Name: "", Value: "x"}}); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+}
+
+func TestNewFile_SourceReadError(t *testing.T) {
+	t.Parallel()
+
+	_, _, err := NewFile("file", "a.txt", &errReader{err: io.ErrUnexpectedEOF})
+	if err == nil {
+		t.Fatalf("expected source read error")
+	}
+}
+
+type errReader struct{ err error }
+
+func (r *errReader) Read(p []byte) (int, error) { return 0, r.err }
diff --git a/pipedrive/body_replacer_test.go b/pipedrive/body_replacer_test.go
new file mode 100644
index 0000000..ffc0bc5
--- /dev/null
+++ b/pipedrive/body_replacer_test.go
@@ -0,0 +1,136 @@
+package pipedrive
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+// eofReader serves its content exactly one full time; later reads return
+// io.EOF without error, mimicking an *os.File that has been read to the end.
+// If a retry re-sends the exhausted reader, the request body is empty.
+type eofReader struct {
+	data []byte
+	pos  int
+}
+
+func (r *eofReader) Read(p []byte) (int, error) {
+	if r.pos >= len(r.data) {
+		return 0, io.EOF
+	}
+	n := copy(p, r.data[r.pos:])
+	r.pos += n
+	return n, nil
+}
+
+func TestWithBodyReplacer_RetriesOneShotBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	var (
+		mu     sync.Mutex
+		calls  int
+		bodies [][]byte
+	)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		mu.Lock()
+		calls++
+		bodies = append(bodies, data)
+		mu.Unlock()
+
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	policy := DefaultRetryPolicy()
+	policy.BaseDelay = 0
+	policy.MaxDelay = 0
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	payload := []byte("upload-payload")
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	err = raw.Do(
+		context.Background(),
+		http.MethodPost,
+		"/files",
+		nil,
+		&eofReader{data: payload},
+		&out,
+		WithBodyReplacer(func() (io.Reader, error) {
+			return &eofReader{data: payload}, nil
+		}),
+	)
+	if err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok=true")
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+	for i, body := range bodies {
+		if string(body) != string(payload) {
+			t.Fatalf("attempt %d body = %q, want %q", i+1, body, payload)
+		}
+	}
+}
+
+func TestWithBodyReplacer_FailsFastWhenSourceUnavailable(t *testing.T) {
+	t.Parallel()
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	raw, err := NewRawClient(srv.URL, srv.Client())
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	boom := errFileUnavailable{}
+	err = raw.Do(
+		context.Background(),
+		http.MethodPost,
+		"/files",
+		nil,
+		&eofReader{data: []byte("payload")},
+		nil,
+		WithBodyReplacer(func() (io.Reader, error) { return nil, boom }),
+	)
+	if err == nil || !errors.Is(err, boom) {
+		t.Fatalf("expected replacer error to surface, got %v", err)
+	}
+}
+
+type errFileUnavailable struct{}
+
+func (errFileUnavailable) Error() string { return "source file unavailable" }
