+// v1EOFReader serves its content exactly one full time; later reads return
+// io.EOF without error, mimicking an *os.File read to the end.
+type v1EOFReader struct {
+	data []byte
+	pos  int
+}
+
+func (r *v1EOFReader) Read(p []byte) (int, error) {
+	if r.pos >= len(r.data) {
+		return 0, io.EOF
+	}
+	n := copy(p, r.data[r.pos:])
+	r.pos += n
+	return n, nil
+}
+
+type v1ErrReader struct{ err error }
+
+func (r *v1ErrReader) Read(p []byte) (int, error) { return 0, r.err }
