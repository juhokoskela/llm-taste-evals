+func TestFilesService_AddFile_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("bulk-import-bytes")
+
+	var (
+		mu     sync.Mutex
+		calls  int
+		bodies [][]byte
+	)
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		mu.Lock()
+		calls++
+		bodies = append(bodies, data)
+		mu.Unlock()
+
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"report.pdf"}}`))
+	}
+
+	policy := pipedrive.DefaultRetryPolicy()
+	policy.BaseDelay = 0
+	policy.MaxDelay = 0
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, handler)
+
+	// The source can only be read one full time (like an *os.File read to
+	// the end), so a retry that re-sends the exhausted body uploads nothing.
+	file, err := client.Files.AddFile(context.Background(), "report.pdf", &v1EOFReader{data: content})
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+	for i, body := range bodies {
+		if !bytes.Contains(body, content) {
+			t.Fatalf("attempt %d did not carry the full file content", i+1)
+		}
+	}
