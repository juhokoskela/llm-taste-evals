+// AddFile uploads a single file as multipart/form-data and associates it
+// with an item through options such as WithFileDealID.
+//
+// The content is read into memory so the request body can be replayed, which
+// means the upload participates in the client retry policy (429 always, and
+// 502/503/504 with RetryAllMethods) like every other request. For streaming
+// uploads that must not be buffered, build the body yourself and call Add
+// with pipedrive.WithBodyReplacer so retries can re-read the source.
+func (s *FilesService) AddFile(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	cfg := newFilesOptions(opts)
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+
+	contentType, body, err := multipartbody.NewFileWithFields("file", fileName, content, cfg.uploadFields)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", cfg.query, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
+}
