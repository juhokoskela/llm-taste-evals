+func TestRetryTransport_RetriesReplayableBodyOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var gotBodies []string
+	next := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		body, err := io.ReadAll(req.Body)
+		if err != nil {
+			return nil, err
+		}
+		_ = req.Body.Close()
+		gotBodies = append(gotBodies, string(body))
+
+		status := 429
+		if calls == 2 {
+			status = 200
+		}
+		return &http.Response{
+			StatusCode: status,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader("")),
+			Request:    req,
+		}, nil
+	})
+
+	rt := newRetryTransport(next, RetryPolicy{
+		MaxAttempts:     3,
+		RetryAllMethods: true,
+		Jitter:          func(d time.Duration) time.Duration { return 0 },
+	}, retryTransportOptions{
+		sleep: func(context.Context, time.Duration) error { return nil },
+		now:   time.Now,
+	})
+
+	req, _ := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.test", strings.NewReader("payload"))
+	resp, err := rt.RoundTrip(req)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	_ = resp.Body.Close()
+
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if resp.StatusCode != 200 {
+		t.Fatalf("expected status 200, got %d", resp.StatusCode)
+	}
+	for i, got := range gotBodies {
+		if got != "payload" {
+			t.Fatalf("attempt %d: expected replayed body %q, got %q", i+1, "payload", got)
+		}
+	}
+}
