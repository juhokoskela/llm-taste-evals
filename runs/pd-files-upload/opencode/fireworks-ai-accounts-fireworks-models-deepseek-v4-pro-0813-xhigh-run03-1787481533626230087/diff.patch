+// AddFile uploads content to Pipedrive, associating it with an optional deal,
+// person, organization, product, activity, or lead.
+//
+// It encodes the file as a multipart/form-data body in memory, so the request
+// body is replayable and uploads retry safely on 429 / 5xx responses.
+func (s *FilesService) AddFile(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	cfg := newFilesOptions(opts)
+	if fileName == "" || content == nil {
+		return nil, fmt.Errorf("file name and content are required")
+	}
+
+	var fields []multipartbody.Field
+	if cfg.dealID != nil {
+		fields = append(fields, multipartbody.Field{Name: "deal_id", Value: strconv.FormatInt(int64(*cfg.dealID), 10)})
+	}
+	if cfg.personID != nil {
+		fields = append(fields, multipartbody.Field{Name: "person_id", Value: strconv.FormatInt(int64(*cfg.personID), 10)})
+	}
+	if cfg.orgID != nil {
+		fields = append(fields, multipartbody.Field{Name: "org_id", Value: strconv.FormatInt(int64(*cfg.orgID), 10)})
+	}
+	if cfg.productID != nil {
+		fields = append(fields, multipartbody.Field{Name: "product_id", Value: strconv.FormatInt(int64(*cfg.productID), 10)})
+	}
+	if cfg.activityID != nil {
+		fields = append(fields, multipartbody.Field{Name: "activity_id", Value: strconv.FormatInt(int64(*cfg.activityID), 10)})
+	}
+	if cfg.leadID != nil {
+		fields = append(fields, multipartbody.Field{Name: "lead_id", Value: string(*cfg.leadID)})
+	}
+
+	contentType, body, err := multipartbody.NewFile("file", fileName, content, fields...)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", cfg.query, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
+}
