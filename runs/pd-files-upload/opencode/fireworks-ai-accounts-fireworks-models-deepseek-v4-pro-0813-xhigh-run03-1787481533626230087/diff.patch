+func TestFilesService_AddFile_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	policy := pipedrive.DefaultRetryPolicy()
+	policy.BaseDelay = time.Millisecond
+	policy.MaxDelay = time.Millisecond
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+
+	var calls int
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.AddFile(context.Background(), "upload.txt", strings.NewReader("hello"))
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
