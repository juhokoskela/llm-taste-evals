+func TestFilesService_AddFile(t *testing.T) {
+	t.Parallel()
+
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.Header.Get("Content-Type"); !strings.HasPrefix(got, "multipart/form-data; boundary=") {
+			t.Fatalf("unexpected content type: %q", got)
+		}
+
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Fatalf("parse multipart form: %v", err)
+		}
+		f, h, err := r.FormFile("file")
+		if err != nil {
+			t.Fatalf("missing file part: %v", err)
+		}
+		defer f.Close()
+		if h.Filename != "upload.txt" {
+			t.Fatalf("unexpected filename: %q", h.Filename)
+		}
+		data, err := io.ReadAll(f)
+		if err != nil {
+			t.Fatalf("read file part: %v", err)
+		}
+		if string(data) != "hello" {
+			t.Fatalf("unexpected file content: %q", string(data))
+		}
+		if got := r.FormValue("deal_id"); got != "42" {
+			t.Fatalf("unexpected deal_id: %q", got)
+		}
+		if got := r.FormValue("person_id"); got != "7" {
+			t.Fatalf("unexpected person_id: %q", got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.AddFile(
+		context.Background(),
+		"upload.txt",
+		strings.NewReader("hello"),
+		WithFileDealID(DealID(42)),
+		WithFilePersonID(PersonID(7)),
+	)
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
