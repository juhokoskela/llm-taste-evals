+func TestFilesService_Add_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var bodies []string
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &pipedrive.RetryPolicy{
+		MaxAttempts:     3,
+		BaseDelay:       time.Millisecond,
+		MaxDelay:        time.Millisecond,
+		RetryAllMethods: true,
+	}}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		bodies = append(bodies, string(body))
+		if calls == 1 {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	// io.NopCloser mimics bodies without a working GetBody, such as *os.File
+	// or io.Pipe readers users stream uploads from.
+	file, err := client.Files.Add(
+		context.Background(),
+		io.NopCloser(strings.NewReader("file")),
+		"multipart/form-data; boundary=test",
+	)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+	if len(bodies) != 2 || bodies[0] != "file" || bodies[1] != "file" {
+		t.Fatalf("expected identical replayed bodies, got %q", bodies)
+	}
+}
