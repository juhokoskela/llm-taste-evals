+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("pdf-bytes")
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.URL.Query().Get("return_fields"); got != "id" {
+			t.Fatalf("unexpected return_fields: %q", got)
+		}
+		if got := r.Header.Get("X-Test"); got != "1" {
+			t.Fatalf("unexpected header X-Test: %q", got)
+		}
+
+		mediaType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			t.Fatalf("parse content type: %v", err)
+		}
+		if mediaType != "multipart/form-data" {
+			t.Fatalf("unexpected media type: %s", mediaType)
+		}
+
+		part, err := multipart.NewReader(r.Body, params["boundary"]).NextPart()
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		if part.FormName() != "file" {
+			t.Fatalf("unexpected form name: %s", part.FormName())
+		}
+		if part.FileName() != "contract.pdf" {
+			t.Fatalf("unexpected filename: %s", part.FileName())
+		}
+		payload, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		if !bytes.Equal(payload, content) {
+			t.Fatalf("unexpected payload: %q", payload)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"contract.pdf"}}`))
+	})
+
+	file, err := client.Files.Upload(
+		context.Background(),
+		"contract.pdf",
+		bytes.NewReader(content),
+		WithFilesQuery(url.Values{"return_fields": {"id"}}),
+		WithFilesRequestOptions(pipedrive.WithHeader("X-Test", "1")),
+	)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "contract.pdf" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
