@@ -0,0 +1,126 @@
+package multipartbody
+
+import (
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "upload.txt", strings.NewReader("content"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	assertMultipart(t, contentType, body, nil, "upload.txt", "content")
+}
+
+func TestNewForm(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "1")
+	fields.Set("person_id", "2")
+	contentType, body, err := NewForm(fields, "file", "upload.txt", strings.NewReader("content"))
+	if err != nil {
+		t.Fatalf("NewForm error: %v", err)
+	}
+	assertMultipart(t, contentType, body, fields, "upload.txt", "content")
+}
+
+func TestNewForm_Validation(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "1")
+
+	if _, _, err := NewForm(fields, "", "upload.txt", strings.NewReader("content")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewForm(fields, "file", "", strings.NewReader("content")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewForm(fields, "file", "upload.txt", nil); err == nil {
+		t.Fatalf("expected error for nil content")
+	}
+}
+
+func TestNewFile_BodyIsReplayable(t *testing.T) {
+	t.Parallel()
+
+	_, body, err := NewFile("file", "upload.txt", strings.NewReader("content"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	// The whole point of buffering: http.NewRequest must wire up GetBody so
+	// the retry transport can replay the body on 429/5xx.
+	req, err := http.NewRequest(http.MethodPost, "https://example.test", body)
+	if err != nil {
+		t.Fatalf("NewRequest error: %v", err)
+	}
+	if req.GetBody == nil {
+		t.Fatalf("expected GetBody to be set")
+	}
+	replay, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	replayed, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatalf("read replayed body: %v", err)
+	}
+	original, err := io.ReadAll(req.Body)
+	if err != nil {
+		t.Fatalf("read original body: %v", err)
+	}
+	if string(replayed) != string(original) {
+		t.Fatalf("replayed body differs from original")
+	}
+}
+
+func assertMultipart(t *testing.T, contentType string, body io.Reader, fields url.Values, fileName, content string) {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %q", mediaType)
+	}
+
+	form, err := multipart.NewReader(body, params["boundary"]).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read form: %v", err)
+	}
+	for key, want := range fields {
+		if got := form.Value[key]; len(got) != len(want) || got[0] != want[0] {
+			t.Fatalf("unexpected field %s: %v, want %v", key, got, want)
+		}
+	}
+	parts := form.File["file"]
+	if len(parts) != 1 {
+		t.Fatalf("expected 1 file part, got %d", len(parts))
+	}
+	if parts[0].Filename != fileName {
+		t.Fatalf("unexpected file name: %q", parts[0].Filename)
+	}
+	fh, err := parts[0].Open()
+	if err != nil {
+		t.Fatalf("open file part: %v", err)
+	}
+	defer fh.Close()
+	got, err := io.ReadAll(fh)
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if string(got) != content {
+		t.Fatalf("unexpected file content: %q", string(got))
+	}
+}
