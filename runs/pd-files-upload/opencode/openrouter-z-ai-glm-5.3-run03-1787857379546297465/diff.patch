+func parseForm(t *testing.T, contentType string, body io.Reader) (url.Values, *multipart.FileHeader) {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+	if params["boundary"] == "" {
+		t.Fatalf("missing boundary in content type: %s", contentType)
+	}
+
+	form, err := multipart.NewReader(body, params["boundary"]).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read multipart form: %v", err)
+	}
+	t.Cleanup(func() { _ = form.RemoveAll() })
+
+	fhs := form.File["file"]
+	if len(fhs) != 1 {
+		t.Fatalf("expected one file part, got %d", len(fhs))
+	}
+	return form.Value, fhs[0]
+}
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.pdf", strings.NewReader("pdf bytes"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	if body == nil {
+		t.Fatalf("expected body reader")
+	}
+
+	values, fh := parseForm(t, contentType, body)
+	if len(values) != 0 {
+		t.Fatalf("expected no extra form values, got %v", values)
+	}
+	if fh.Filename != "report.pdf" {
+		t.Fatalf("unexpected filename: %q", fh.Filename)
+	}
+	f, err := fh.Open()
+	if err != nil {
+		t.Fatalf("open file part: %v", err)
+	}
+	defer f.Close()
+	content, err := io.ReadAll(f)
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if string(content) != "pdf bytes" {
+		t.Fatalf("unexpected content: %q", string(content))
+	}
+}
