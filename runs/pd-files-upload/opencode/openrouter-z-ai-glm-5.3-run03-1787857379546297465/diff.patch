+func TestRawClient_Do_SetsGetBodyForSeekableReaderBody(t *testing.T) {
+	t.Parallel()
+
+	var captured *http.Request
+	var firstBody string
+	rt := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		captured = req
+		body, err := io.ReadAll(req.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+			return nil, err
+		}
+		firstBody = string(body)
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader("")),
+			Request:    req,
+		}, nil
+	})
+
+	raw, err := NewRawClient("https://example.test", &http.Client{Transport: rt})
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	f := newTempFile(t, "upload payload")
+	t.Cleanup(func() { _ = f.Close() })
+
+	if err := raw.Do(context.Background(), http.MethodPost, "/x", nil, f, nil); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+
+	if captured == nil {
+		t.Fatalf("expected request to be captured")
+	}
+	if captured.GetBody == nil {
+		t.Fatalf("expected GetBody to be set for seekable reader body")
+	}
+	if captured.ContentLength != int64(len("upload payload")) {
+		t.Fatalf("expected content length %d, got %d", len("upload payload"), captured.ContentLength)
+	}
+	if firstBody != "upload payload" {
+		t.Fatalf("unexpected first body: %q", firstBody)
+	}
+	for i := 0; i < 2; i++ {
+		rc, err := captured.GetBody()
+		if err != nil {
+			t.Fatalf("GetBody error: %v", err)
+		}
+		replayed, err := io.ReadAll(rc)
+		if err != nil {
+			t.Fatalf("read replayed body: %v", err)
+		}
+		if string(replayed) != "upload payload" {
+			t.Fatalf("unexpected replayed body: %q", string(replayed))
+		}
+	}
+}
