+
+func TestNewFileWithFields_BodyIsReplayable(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "7")
+
+	contentType, body, err := NewFileWithFields("file", "report.pdf", strings.NewReader("pdf bytes"), fields)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	first, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	if _, err := body.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek body: %v", err)
+	}
+	second, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("read body again: %v", err)
+	}
+	if string(first) != string(second) {
+		t.Fatalf("expected replayable body")
+	}
+	if contentType == "" {
+		t.Fatalf("expected content type")
+	}
+}
