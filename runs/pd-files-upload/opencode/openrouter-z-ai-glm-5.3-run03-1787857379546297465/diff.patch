+func TestNewFile_Errors(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "report.pdf", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected field name error")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected file name error")
+	}
+	if _, _, err := NewFile("file", "report.pdf", nil); err == nil {
+		t.Fatalf("expected content error")
+	}
+	if _, _, err := NewFileWithFields("", "report.pdf", strings.NewReader("x"), nil); err == nil {
+		t.Fatalf("expected field name error")
+	}
+	if _, _, err := NewFileWithFields("file", "", strings.NewReader("x"), nil); err == nil {
+		t.Fatalf("expected file name error")
