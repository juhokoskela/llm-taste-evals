+func TestRawClient_Do_ReplaysSeekableReaderBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	calls := 0
+	var bodies []string
+	var contentLengths []int64
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+			body = nil
+		}
+		mu.Lock()
+		calls++
+		attempt := calls
+		bodies = append(bodies, string(body))
+		contentLengths = append(contentLengths, r.ContentLength)
+		mu.Unlock()
+
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	policy := RetryPolicy{
+		MaxAttempts:     3,
+		BaseDelay:       time.Millisecond,
+		MaxDelay:        time.Millisecond,
+		Jitter:          func(d time.Duration) time.Duration { return d },
+		RetryAllMethods: true,
+	}
+	httpClient := NewHTTPClient(Config{HTTPClient: srv.Client(), RetryPolicy: &policy})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	f := newTempFile(t, "upload payload")
+	t.Cleanup(func() { _ = f.Close() })
+
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, f, nil); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if bodies[0] != "upload payload" || bodies[1] != "upload payload" {
+		t.Fatalf("expected body to be replayed on retry, got %q then %q", bodies[0], bodies[1])
+	}
+	for i, cl := range contentLengths {
+		if cl != int64(len("upload payload")) {
+			t.Fatalf("attempt %d: expected content length %d, got %d", i+1, len("upload payload"), cl)
+		}
+	}
+}
