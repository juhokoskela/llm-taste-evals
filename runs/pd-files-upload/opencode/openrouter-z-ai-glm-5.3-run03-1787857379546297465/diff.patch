+func TestFilesService_Add_RetriesSeekableReaderBody(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	calls := 0
+	var bodies []string
+
+	policy := pipedrive.RetryPolicy{
+		MaxAttempts:     3,
+		BaseDelay:       time.Millisecond,
+		MaxDelay:        time.Millisecond,
+		Jitter:          func(d time.Duration) time.Duration { return d },
+		RetryAllMethods: true,
+	}
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+			body = nil
+		}
+		mu.Lock()
+		calls++
+		attempt := calls
+		bodies = append(bodies, string(body))
+		mu.Unlock()
+
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	f := newUploadTempFile(t, "file content")
+	defer f.Close()
+
+	file, err := client.Files.Add(context.Background(), f, "multipart/form-data; boundary=test")
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if bodies[0] != "file content" || bodies[1] != "file content" {
+		t.Fatalf("expected body to be replayed on retry, got %q then %q", bodies[0], bodies[1])
