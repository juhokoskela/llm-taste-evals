+func TestRawClient_Do_RetriesSeekableBody(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var bodies []string
+	var contentLengths []int64
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		bodies = append(bodies, string(data))
+		contentLengths = append(contentLengths, r.ContentLength)
+
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	httpClient := NewHTTPClient(Config{
+		HTTPClient: srv.Client(),
+		RetryPolicy: &RetryPolicy{
+			MaxAttempts:     3,
+			BaseDelay:       time.Millisecond,
+			MaxDelay:        time.Millisecond,
+			Jitter:          func(d time.Duration) time.Duration { return d },
+			RetryAllMethods: true,
+		},
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	path := filepath.Join(t.TempDir(), "upload.bin")
+	if err := os.WriteFile(path, []byte("file-payload"), 0o600); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	defer f.Close()
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/upload", nil, f, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok")
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if len(bodies) != 2 || bodies[0] != "file-payload" || bodies[1] != "file-payload" {
+		t.Fatalf("expected replayed body %q on both attempts, got %q", "file-payload", bodies)
+	}
+	for i, cl := range contentLengths {
+		if cl != int64(len("file-payload")) {
+			t.Fatalf("expected content length %d on attempt %d, got %d", len("file-payload"), i+1, cl)
+		}
+	}
+}
+
