+			t.Fatalf("unexpected file content: %q", string(data))
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"notes.txt"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "notes.txt", strings.NewReader("file content"))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "notes.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
