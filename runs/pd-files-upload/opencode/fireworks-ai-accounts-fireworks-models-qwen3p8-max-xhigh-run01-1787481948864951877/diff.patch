+package multipartbody
+
+import (
+	"bytes"
+	"io"
+	"mime"
+	"mime/multipart"
+	"strings"
+	"testing"
+)
+
+func readForm(t *testing.T, contentType string, body *bytes.Reader) *multipart.Form {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+
+	form, err := multipart.NewReader(body, params["boundary"]).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read form: %v", err)
+	}
+	return form
+}
+
+func filePartPayload(t *testing.T, form *multipart.Form, fieldName, wantName string) []byte {
+	t.Helper()
+
+	parts := form.File[fieldName]
+	if len(parts) != 1 {
+		t.Fatalf("expected 1 %q file part, got %d", fieldName, len(parts))
+	}
+	if parts[0].Filename != wantName {
+		t.Fatalf("unexpected filename: %q", parts[0].Filename)
+	}
+	part, err := parts[0].Open()
+	if err != nil {
+		t.Fatalf("open part: %v", err)
+	}
+	defer part.Close()
+	payload, err := io.ReadAll(part)
+	if err != nil {
+		t.Fatalf("read part: %v", err)
+	}
+	return payload
+}
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.pdf", strings.NewReader("file-content"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	form := readForm(t, contentType, body)
+	if got := filePartPayload(t, form, "file", "report.pdf"); string(got) != "file-content" {
+		t.Fatalf("unexpected payload: %q", got)
+	}
+	if len(form.Value) != 0 {
+		t.Fatalf("unexpected form values: %#v", form.Value)
+	}
+}
+
+func TestNewFileWithFields(t *testing.T) {
+	t.Parallel()
+
+	fields := []Field{
+		{Name: "deal_id", Value: "7"},
+		{Name: "lead_id", Value: "b4a5c0d0-0e10-11eb-879b-05d71fb426ec"},
+	}
+	contentType, body, err := NewFileWithFields("file", "report.pdf", fields, strings.NewReader("file-content"))
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	form := readForm(t, contentType, body)
+	if got := filePartPayload(t, form, "file", "report.pdf"); string(got) != "file-content" {
+		t.Fatalf("unexpected payload: %q", got)
+	}
+	if got := form.Value["deal_id"]; len(got) != 1 || got[0] != "7" {
+		t.Fatalf("unexpected deal_id: %#v", got)
+	}
+	if got := form.Value["lead_id"]; len(got) != 1 || got[0] != "b4a5c0d0-0e10-11eb-879b-05d71fb426ec" {
+		t.Fatalf("unexpected lead_id: %#v", got)
+	}
+}
+
+func TestNewFileWithFields_BodyIsReplayable(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFileWithFields("file", "report.pdf", nil, strings.NewReader("file-content"))
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	first, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	if _, err := body.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek body: %v", err)
+	}
+	second, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("re-read body: %v", err)
+	}
+	if !bytes.Equal(first, second) {
+		t.Fatalf("replayed body differs from original")
+	}
+	if contentType == "" {
+		t.Fatalf("expected content type")
+	}
+}
+
+func TestNewFileWithFields_Validation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFileWithFields("", "report.pdf", nil, strings.NewReader("x")); err == nil {
+		t.Fatalf("expected field name error")
+	}
+	if _, _, err := NewFileWithFields("file", "", nil, strings.NewReader("x")); err == nil {
+		t.Fatalf("expected file name error")
+	}
+	if _, _, err := NewFileWithFields("file", "report.pdf", nil, nil); err == nil {
+		t.Fatalf("expected content error")
+	}
+	if _, _, err := NewFileWithFields("file", "report.pdf", []Field{{Name: "", Value: "1"}}, strings.NewReader("x")); err == nil {
+		t.Fatalf("expected empty form field name error")
+	}
+}
