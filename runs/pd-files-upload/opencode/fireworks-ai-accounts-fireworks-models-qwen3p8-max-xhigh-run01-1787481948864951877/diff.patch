+// Upload sends content as a multipart/form-data file named fileName and
+// optionally associates it with a deal, person, organization, product,
+// activity, lead or project.
+//
+// The multipart body is buffered in memory and is replayable, so uploads are
+// retried on 429/502/503/504 according to the retry policy.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...FilesUploadOption) (*File, error) {
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+	cfg := newFilesUploadOptions(opts)
+
+	fields, err := cfg.formFields()
+	if err != nil {
+		return nil, err
+	}
+	contentType, body, err := multipartbody.NewFileWithFields("file", fileName, fields, content)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", nil, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
