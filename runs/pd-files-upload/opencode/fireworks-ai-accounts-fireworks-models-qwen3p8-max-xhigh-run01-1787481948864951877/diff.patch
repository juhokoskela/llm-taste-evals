+func TestFilesService_Add_RetriesSeekableBodyOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var bodies []string
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{MaxAttempts: 3, BaseDelay: time.Millisecond, MaxDelay: time.Millisecond},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		payload, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		bodies = append(bodies, string(payload))
+		calls++
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	path := filepath.Join(t.TempDir(), "upload.bin")
+	if err := os.WriteFile(path, []byte("multipart-body"), 0o600); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = file.Close() })
+
+	added, err := client.Files.Add(context.Background(), file, "multipart/form-data; boundary=test")
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if added.ID != 12 {
+		t.Fatalf("unexpected file: %#v", added)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	for i, body := range bodies {
+		if body != "multipart-body" {
+			t.Fatalf("attempt %d body = %q, want %q", i+1, body, "multipart-body")
+		}
+	}
+}
