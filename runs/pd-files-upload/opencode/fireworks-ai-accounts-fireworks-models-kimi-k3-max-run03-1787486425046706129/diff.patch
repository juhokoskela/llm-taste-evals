+// Upload uploads a single file as multipart/form-data, mirroring
+// CallLogsService.AddRecording: pass a file name and a reader and the SDK
+// builds the body. The body is encoded in memory with a replayable GetBody,
+// so uploads participate in retries (429, and 502/503/504 with
+// RetryPolicy.RetryAllMethods) like every other call. Use the WithFile*ID
+// options to associate the upload with a deal, person, organization,
+// product, activity or lead.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	cfg := newFilesOptions(opts)
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+
+	contentType, body, err := multipartbody.NewFileWithFields("file", fileName, content, cfg.form...)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", cfg.query, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
+}
