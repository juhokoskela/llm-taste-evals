+)
+
+func TestNewFileWithFields(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFileWithFields("file", "doc.txt", strings.NewReader("payload"),
+		Field{Name: "deal_id", Value: "7"},
+		Field{Name: "lead_id", Value: "lead-1"},
+	)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+
+	reader := multipart.NewReader(body, params["boundary"])
+
+	for _, want := range []struct{ name, value string }{
+		{name: "deal_id", value: "7"},
+		{name: "lead_id", value: "lead-1"},
+	} {
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("read field part: %v", err)
+		}
+		if part.FormName() != want.name {
+			t.Fatalf("unexpected field name: %q", part.FormName())
+		}
+		value, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read field value: %v", err)
+		}
+		if string(value) != want.value {
+			t.Fatalf("unexpected field value: %q", value)
+		}
+	}
+
+	part, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if part.FormName() != "file" || part.FileName() != "doc.txt" {
+		t.Fatalf("unexpected file part: form=%q file=%q", part.FormName(), part.FileName())
+	}
+	payload, err := io.ReadAll(part)
+	if err != nil {
+		t.Fatalf("read file payload: %v", err)
+	}
+	if string(payload) != "payload" {
+		t.Fatalf("unexpected file payload: %q", payload)
+	}
+	if _, err := reader.NextPart(); err != io.EOF {
+		t.Fatalf("expected end of multipart body, got %v", err)
+	}
+}
+
+func TestNewFile_ReplayableBody(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "doc.txt", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	if !strings.HasPrefix(contentType, "multipart/form-data; boundary=") {
+		t.Fatalf("unexpected content type: %q", contentType)
+	}
+
+	// http.NewRequest must recognize the body so retries can replay it.
+	req, err := http.NewRequest(http.MethodPost, "https://example.test", body)
+	if err != nil {
+		t.Fatalf("build request: %v", err)
+	}
+	if req.GetBody == nil {
+		t.Fatalf("expected GetBody to be set")
+	}
+	replay, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	replayed, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatalf("read replayed body: %v", err)
+	}
+	original, err := io.ReadAll(req.Body)
+	if err != nil {
+		t.Fatalf("read original body: %v", err)
+	}
+	if string(replayed) != string(original) {
+		t.Fatalf("replayed body mismatch")
+	}
+}
+
+func TestNewFileWithFields_Validation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFileWithFields("", "doc.txt", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewFileWithFields("file", "", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewFileWithFields("file", "doc.txt", nil); err == nil {
+		t.Fatalf("expected error for nil content")
+	}
+	if _, _, err := NewFileWithFields("file", "doc.txt", strings.NewReader("x"), Field{Value: "1"}); err == nil {
+		t.Fatalf("expected error for empty form field name")
+	}
+}
