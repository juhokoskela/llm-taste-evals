+// makeBodyReplayable wires up req.GetBody so the retry transport can replay
+// the request body across retries. http.NewRequest only sets GetBody for
+// in-memory types (bytes.Buffer, bytes.Reader, strings.Reader); arbitrary
+// io.Readers such as *os.File get a Body but no GetBody, which would make
+// the retry transport skip retries entirely. Non-replayable bodies are
+// buffered into memory once so each retry can be served from a fresh reader.
+// (A seeker cannot be reused because the HTTP transport closes the request
+// body after each attempt, so we buffer rather than rewind the source.)
+func makeBodyReplayable(req *http.Request) {
+	if req.GetBody != nil || req.Body == nil || req.Body == http.NoBody {
+		return
