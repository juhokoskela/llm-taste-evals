+// AddFileOption configures FilesService.Upload.
+type AddFileOption interface {
+	applyAddFile(*addFileOptions)
+}
+
+type addFileOptions struct {
+	query          url.Values
+	requestOptions []pipedrive.RequestOption
+	fields         map[string]string
+}
+
+type addFileOptionFunc func(*addFileOptions)
+
+func (f addFileOptionFunc) applyAddFile(cfg *addFileOptions) {
+	f(cfg)
+}
+
+func WithAddFileQuery(values url.Values) AddFileOption {
+	return addFileOptionFunc(func(cfg *addFileOptions) {
+		cfg.query = mergeQueryValues(cfg.query, values)
+	})
+}
+
+func WithAddFileRequestOptions(opts ...pipedrive.RequestOption) AddFileOption {
+	return addFileOptionFunc(func(cfg *addFileOptions) {
+		cfg.requestOptions = append(cfg.requestOptions, opts...)
+	})
+}
+
+func withFileField(key string, value string) AddFileOption {
+	return addFileOptionFunc(func(cfg *addFileOptions) {
+		if cfg.fields == nil {
+			cfg.fields = make(map[string]string)
+		}
+		cfg.fields[key] = value
+	})
+}
+
+func WithFileDealID(id DealID) AddFileOption {
+	return withFileField("deal_id", strconv.FormatInt(int64(id), 10))
+}
+
+func WithFilePersonID(id PersonID) AddFileOption {
+	return withFileField("person_id", strconv.FormatInt(int64(id), 10))
+}
+
+func WithFileOrganizationID(id OrganizationID) AddFileOption {
+	return withFileField("org_id", strconv.FormatInt(int64(id), 10))
+}
+
+func WithFileProductID(id ProductID) AddFileOption {
+	return withFileField("product_id", strconv.FormatInt(int64(id), 10))
+}
+
+func WithFileActivityID(id ActivityID) AddFileOption {
+	return withFileField("activity_id", strconv.FormatInt(int64(id), 10))
+}
+
+func WithFileProjectID(id ProjectID) AddFileOption {
+	return withFileField("project_id", strconv.FormatInt(int64(id), 10))
+}
+
+func WithFileLeadID(id LeadID) AddFileOption {
+	return withFileField("lead_id", string(id))
+}
+
+func newAddFileOptions(opts []AddFileOption) addFileOptions {
+	var cfg addFileOptions
+	for _, opt := range opts {
+		if opt == nil {
+			continue
+		}
+		opt.applyAddFile(&cfg)
+	}
+	return cfg
+}
+
+// Upload adds a file to Pipedrive. Unlike Add, it builds the multipart/form-data
+// request body for you: pass a file name and a reader, and optionally associate
+// the file with a deal, person, organization, product, activity, project, or
+// lead. The body is buffered in memory (like call-log recordings), which also
+// makes it replayable so retries on 429/5xx work correctly.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...AddFileOption) (*File, error) {
+	if fileName == "" || content == nil {
+		return nil, fmt.Errorf("file name and content are required")
+	}
+	cfg := newAddFileOptions(opts)
+
+	contentType, body, err := multipartbody.NewFileWithFields("file", fileName, content, cfg.fields)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", cfg.query, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
+}
