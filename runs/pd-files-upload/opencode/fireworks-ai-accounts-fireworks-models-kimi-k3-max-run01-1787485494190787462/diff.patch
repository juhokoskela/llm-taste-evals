+// replayableReader returns a reader http.NewRequest can replay through
+// Request.GetBody, which the retry transport needs to resend a request.
+// Reader types it recognizes natively are returned as-is; any other reader
+// is buffered in full.
+func replayableReader(r io.Reader) (io.Reader, error) {
+	switch r.(type) {
+	case *bytes.Buffer, *bytes.Reader, *strings.Reader:
+		return r, nil
+	}
+	buf, err := io.ReadAll(r)
+	if err != nil {
+		return nil, fmt.Errorf("read request body: %w", err)
+	}
+	return bytes.NewReader(buf), nil
+}
