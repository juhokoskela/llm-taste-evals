+package multipartbody
+
+import (
+	"bytes"
+	"io"
+	"mime"
+	"mime/multipart"
+	"strings"
+	"testing"
+)
+
+func TestNewFileWithFields(t *testing.T) {
+	t.Parallel()
+
+	contentType, reader, err := NewFileWithFields(
+		"file",
+		"test.txt",
+		strings.NewReader("hello world"),
+		FormField{Name: "deal_id", Value: "123"},
+		FormField{Name: "person_id", Value: "456"},
+	)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+
+	mr := multipart.NewReader(reader, params["boundary"])
+
+	// Part 1: deal_id
+	p1, err := mr.NextPart()
+	if err != nil {
+		t.Fatalf("next part 1: %v", err)
+	}
+	if p1.FormName() != "deal_id" {
+		t.Fatalf("unexpected part 1 name: %s", p1.FormName())
+	}
+	v1, _ := io.ReadAll(p1)
+	if string(v1) != "123" {
+		t.Fatalf("unexpected deal_id: %s", string(v1))
+	}
+
+	// Part 2: person_id
+	p2, err := mr.NextPart()
+	if err != nil {
+		t.Fatalf("next part 2: %v", err)
+	}
+	if p2.FormName() != "person_id" {
+		t.Fatalf("unexpected part 2 name: %s", p2.FormName())
+	}
+	v2, _ := io.ReadAll(p2)
+	if string(v2) != "456" {
+		t.Fatalf("unexpected person_id: %s", string(v2))
+	}
+
+	// Part 3: file
+	p3, err := mr.NextPart()
+	if err != nil {
+		t.Fatalf("next part 3: %v", err)
+	}
+	if p3.FormName() != "file" {
+		t.Fatalf("unexpected part 3 name: %s", p3.FormName())
+	}
+	if p3.FileName() != "test.txt" {
+		t.Fatalf("unexpected part 3 filename: %s", p3.FileName())
+	}
+	v3, _ := io.ReadAll(p3)
+	if string(v3) != "hello world" {
+		t.Fatalf("unexpected file content: %s", string(v3))
+	}
+}
+
+func TestNewFileWithFields_Validation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFileWithFields("", "test.txt", strings.NewReader("hi")); err == nil {
+		t.Fatalf("expected error for empty fieldName")
+	}
+	if _, _, err := NewFileWithFields("file", "", strings.NewReader("hi")); err == nil {
+		t.Fatalf("expected error for empty fileName")
+	}
+	if _, _, err := NewFileWithFields("file", "test.txt", nil); err == nil {
+		t.Fatalf("expected error for nil src")
+	}
+}
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, reader, err := NewFile("file", "doc.pdf", bytes.NewReader([]byte("bytes")))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	if !strings.HasPrefix(contentType, "multipart/form-data; boundary=") {
+		t.Fatalf("unexpected content type: %s", contentType)
+	}
+	if reader.Len() == 0 {
+		t.Fatalf("expected non-empty reader")
+	}
+}
