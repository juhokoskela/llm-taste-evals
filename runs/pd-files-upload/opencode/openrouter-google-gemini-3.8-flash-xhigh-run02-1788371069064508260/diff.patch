+func TestRawClient_Do_RetriesWithReadSeekerBody(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var bodies []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read body: %v", err)
+		}
+		bodies = append(bodies, string(b))
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	tmp, err := os.CreateTemp("", "raw-body-*")
+	if err != nil {
+		t.Fatalf("create temp: %v", err)
+	}
+	defer os.Remove(tmp.Name())
+	if _, err := tmp.WriteString("file content"); err != nil {
+		t.Fatalf("write temp: %v", err)
+	}
+	_ = tmp.Close()
+
+	f, err := os.Open(tmp.Name())
+	if err != nil {
+		t.Fatalf("open temp: %v", err)
+	}
+	defer f.Close()
+
+	httpClient := NewHTTPClient(Config{
+		HTTPClient: srv.Client(),
+		RetryPolicy: &RetryPolicy{
+			MaxAttempts: 2,
+			BaseDelay:   1 * time.Millisecond,
+			MaxDelay:    1 * time.Millisecond,
+			Jitter:      func(d time.Duration) time.Duration { return d },
+		},
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient: %v", err)
+	}
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/upload", nil, f, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok=true")
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if len(bodies) != 2 || bodies[0] != "file content" || bodies[1] != "file content" {
+		t.Fatalf("expected file content on both attempts, got %#v", bodies)
+	}
+}
