+func TestRetryTransport_RetriesWhenBodyIsReadSeeker(t *testing.T) {
+	t.Parallel()
+
+	var attempts int
+	var receivedBodies []string
+
+	next := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		attempts++
+		b, err := io.ReadAll(req.Body)
+		if err != nil {
+			return nil, err
+		}
+		_ = req.Body.Close()
+		receivedBodies = append(receivedBodies, string(b))
+
+		if attempts == 1 {
+			return &http.Response{
+				StatusCode: 429,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader(`{"error":"rate limited"}`)),
+				Request:    req,
+			}, nil
+		}
+
+		return &http.Response{
+			StatusCode: 200,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader(`{"ok":true}`)),
+			Request:    req,
+		}, nil
+	})
+
+	rt := newRetryTransport(next, DefaultRetryPolicy(), retryTransportOptions{
+		sleep: func(context.Context, time.Duration) error { return nil },
+		now:   time.Now,
+	})
+
+	payload := "document content"
+	f, err := os.CreateTemp(t.TempDir(), "upload-test-*.txt")
+	if err != nil {
+		t.Fatalf("CreateTemp error: %v", err)
+	}
+	defer f.Close()
+	if _, err := f.WriteString(payload); err != nil {
+		t.Fatalf("WriteString error: %v", err)
+	}
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("Seek error: %v", err)
+	}
+
+	req, _ := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.test", f)
+	// Explicitly clear req.GetBody to verify retryTransport reconstructs it from io.ReadSeeker
+	req.GetBody = nil
+
+	resp, err := rt.RoundTrip(req)
+	if err != nil {
+		t.Fatalf("RoundTrip error: %v", err)
+	}
+	_ = resp.Body.Close()
+
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
