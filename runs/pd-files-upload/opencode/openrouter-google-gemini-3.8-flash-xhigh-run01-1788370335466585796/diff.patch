@@ -0,0 +1,145 @@
+package multipartbody
+
+import (
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	data := "hello world"
+	contentType, reader, err := NewFile("file", "test.txt", strings.NewReader(data),
+		Field{Name: "deal_id", Value: "42"},
+		Field{Name: "", Value: "ignored"},
+		Field{Name: "lead_id", Value: "uuid-123"},
+	)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse media type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("expected multipart/form-data, got %s", mediaType)
+	}
+
+	mr := multipart.NewReader(reader, params["boundary"])
+
+	// Check first field
+	p1, err := mr.NextPart()
+	if err != nil {
+		t.Fatalf("read first part: %v", err)
+	}
+	if p1.FormName() != "deal_id" {
+		t.Fatalf("expected form name 'deal_id', got %s", p1.FormName())
+	}
+	val1, err := io.ReadAll(p1)
+	if err != nil {
+		t.Fatalf("read val1: %v", err)
+	}
+	if string(val1) != "42" {
+		t.Fatalf("expected '42', got %s", string(val1))
+	}
+
+	// Check second field
+	p2, err := mr.NextPart()
+	if err != nil {
+		t.Fatalf("read second part: %v", err)
+	}
+	if p2.FormName() != "lead_id" {
+		t.Fatalf("expected form name 'lead_id', got %s", p2.FormName())
+	}
+	val2, err := io.ReadAll(p2)
+	if err != nil {
+		t.Fatalf("read val2: %v", err)
+	}
+	if string(val2) != "uuid-123" {
+		t.Fatalf("expected 'uuid-123', got %s", string(val2))
+	}
+
+	// Check file part
+	p3, err := mr.NextPart()
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if p3.FormName() != "file" {
+		t.Fatalf("expected form name 'file', got %s", p3.FormName())
+	}
+	if p3.FileName() != "test.txt" {
+		t.Fatalf("expected filename 'test.txt', got %s", p3.FileName())
+	}
+	fileBytes, err := io.ReadAll(p3)
+	if err != nil {
+		t.Fatalf("read file content: %v", err)
+	}
+	if string(fileBytes) != data {
+		t.Fatalf("expected %q, got %q", data, string(fileBytes))
+	}
+
+	// Ensure no more parts
+	_, err = mr.NextPart()
+	if !errors.Is(err, io.EOF) {
+		t.Fatalf("expected EOF, got %v", err)
+	}
+
+	// Verify that http.NewRequest automatically gets a working GetBody
+	req, err := http.NewRequest(http.MethodPost, "https://example.test", reader)
+	if err != nil {
+		t.Fatalf("NewRequest error: %v", err)
+	}
+	if req.GetBody == nil {
+		t.Fatalf("expected non-nil GetBody")
+	}
+	bodyCopy, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	defer bodyCopy.Close()
+	allBytes, err := io.ReadAll(bodyCopy)
+	if err != nil {
+		t.Fatalf("read from bodyCopy: %v", err)
+	}
+	if len(allBytes) != int(req.ContentLength) {
+		t.Fatalf("expected %d bytes, got %d", req.ContentLength, len(allBytes))
+	}
+}
+
+func TestNewFile_ValidationErrors(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "f.txt", strings.NewReader("hi")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("hi")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "f.txt", nil); err == nil {
+		t.Fatalf("expected error for nil src")
+	}
+}
+
+func TestNewFile_SourceReadError(t *testing.T) {
+	t.Parallel()
+
+	boom := errors.New("boom")
+	_, _, err := NewFile("file", "f.txt", &errReader{err: boom})
+	if err == nil || !errors.Is(err, boom) {
+		t.Fatalf("expected boom error, got %v", err)
+	}
+}
+
+type errReader struct {
+	err error
+}
+
+func (r *errReader) Read(p []byte) (int, error) {
+	return 0, r.err
+}
