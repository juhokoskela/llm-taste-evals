+func TestRawClient_Do_RetriesWithReadSeekerBody(t *testing.T) {
+	t.Parallel()
+
+	var attempts int
+	var bodies []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		bodies = append(bodies, string(b))
+
+		if attempts == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limited"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"id":42}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	cfg := Config{
+		BaseURL: srv.URL,
+		RetryPolicy: &RetryPolicy{
+			MaxAttempts: 2,
+			BaseDelay:   0,
+		},
+	}
+	httpClient := NewHTTPClient(cfg)
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	content := "multipart or file payload to retry"
+	tmpFile, err := os.CreateTemp(t.TempDir(), "raw-retry-*.txt")
+	if err != nil {
+		t.Fatalf("CreateTemp error: %v", err)
+	}
+	defer tmpFile.Close()
+
+	if _, err := tmpFile.WriteString(content); err != nil {
+		t.Fatalf("WriteString error: %v", err)
+	}
+	if _, err := tmpFile.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("Seek error: %v", err)
+	}
+
+	var out struct {
+		Success bool `json:"success"`
+		ID      int  `json:"id"`
+	}
+	err = raw.Do(context.Background(), http.MethodPost, "/upload", nil, tmpFile, &out)
+	if err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Success || out.ID != 42 {
+		t.Fatalf("unexpected response: %+v", out)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 received bodies, got %d", len(bodies))
+	}
+	for i, b := range bodies {
+		if b != content {
+			t.Fatalf("attempt %d received %q, want %q", i+1, b, content)
+		}
+	}
+}
