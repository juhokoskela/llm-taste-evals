+func TestFilesService_AddReader(t *testing.T) {
+	t.Parallel()
+
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/files" {
+			t.Fatalf("unexpected request: %s %s", r.Method, r.URL.Path)
+		}
+		if got := r.Header.Get("Content-Type"); got != "multipart/form-data; boundary=custom" {
+			t.Fatalf("unexpected content type: %s", got)
+		}
+		b, err := io.ReadAll(r.Body)
+		if err != nil || string(b) != "custom raw multipart body" {
+			t.Fatalf("unexpected body: %q, err: %v", b, err)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":99,"name":"custom.txt"}}`))
+	})
+
+	file, err := client.Files.AddReader(
+		context.Background(),
+		strings.NewReader("custom raw multipart body"),
+		"multipart/form-data; boundary=custom",
+	)
+	if err != nil {
+		t.Fatalf("AddReader error: %v", err)
+	}
+	if file.ID != 99 || file.Name != "custom.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	if _, err := client.Files.AddReader(context.Background(), nil, "ct"); err == nil {
+		t.Fatal("expected error for nil body")
+	}
+	if _, err := client.Files.AddReader(context.Background(), strings.NewReader("b"), ""); err == nil {
+		t.Fatal("expected error for empty content type")
+	}
+}
