+func TestFilesService_Add_RetriesOnRateLimitWithOSFile(t *testing.T) {
+	t.Parallel()
+
+	fileContent := []byte("important document data for bulk import")
+	tmpFile, err := os.CreateTemp(t.TempDir(), "pipedrive-upload-*.pdf")
+	if err != nil {
+		t.Fatalf("CreateTemp error: %v", err)
+	}
+	defer tmpFile.Close()
+
+	if _, err := tmpFile.Write(fileContent); err != nil {
+		t.Fatalf("Write error: %v", err)
+	}
+	if _, err := tmpFile.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("Seek error: %v", err)
+	}
+
+	var attempts int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		mediaType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if mediaType != "multipart/form-data" {
+			http.Error(w, "bad media type", http.StatusBadRequest)
+			return
+		}
+		mr := multipart.NewReader(r.Body, params["boundary"])
+		part, err := mr.NextPart()
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		payload, err := io.ReadAll(part)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if !bytes.Equal(payload, fileContent) {
+			http.Error(w, "body mismatch", http.StatusBadRequest)
+			return
+		}
+
+		if attempts == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limit exceeded"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":88,"name":"upload.pdf"}}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	client, err := NewClient(pipedrive.Config{
+		BaseURL: srv.URL,
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     3,
+			BaseDelay:       0,
+			RetryAllMethods: true,
+		},
+		HTTPClient: srv.Client(),
+	})
+	if err != nil {
+		t.Fatalf("NewClient error: %v", err)
+	}
+
+	file, err := client.Files.Add(context.Background(), "upload.pdf", tmpFile)
+	if err != nil {
+		t.Fatalf("Add error on retry: %v", err)
+	}
+	if file.ID != 88 || file.Name != "upload.pdf" {
+		t.Fatalf("unexpected file result: %#v", file)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+}
