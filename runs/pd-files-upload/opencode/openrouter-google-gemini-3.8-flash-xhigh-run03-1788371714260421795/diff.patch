+		content, err := io.ReadAll(file)
+		if err != nil {
+			t.Fatalf("attempt %d: read form file: %v", attempts, err)
+		}
+		if string(content) != payload {
+			t.Fatalf("attempt %d: unexpected content: %q", attempts, string(content))
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":99,"name":"document.txt"}}`))
+	})
+
+	f, err := os.Open(tmpFile.Name())
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	defer f.Close()
+
+	file, err := client.Files.Add(context.Background(), "document.txt", f)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
