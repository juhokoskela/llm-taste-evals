+// Regression: uploads must retry on 429 like every other call. The
+// multipart body is built internally as a *bytes.Reader, so the retry
+// transport can replay it.
+func TestFilesService_Add_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:   4,
+			BaseDelay:     time.Millisecond,
+			MaxDelay:      time.Millisecond,
+			MaxRetryAfter: time.Minute,
+			Jitter:        func(d time.Duration) time.Duration { return d },
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		capture := parseMultipartUpload(t, r)
+		if capture.fileName != "upload.txt" {
+			t.Fatalf("attempt %d: unexpected file name: %s", calls, capture.fileName)
+		}
+		if string(capture.payload) != "file" {
+			t.Fatalf("attempt %d: unexpected payload: %q", calls, capture.payload)
+		}
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"error":{"code":1041,"message":"rate limit exceeded"}}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), "upload.txt", strings.NewReader("file"))
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+}
