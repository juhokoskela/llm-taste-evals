+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+
+	reader := multipart.NewReader(r.Body, params["boundary"])
+	capture := multipartUpload{fields: make(map[string]string)}
+	for {
+		part, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		if part.FileName() != "" {
+			if capture.fileName != "" {
+				t.Fatalf("unexpected second file part")
+			}
+			if part.FormName() != "file" {
+				t.Fatalf("unexpected form name: %s", part.FormName())
+			}
+			capture.fileName = part.FileName()
+			capture.payload, err = io.ReadAll(part)
+			if err != nil {
+				t.Fatalf("read file part: %v", err)
+			}
+			continue
+		}
+		data, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read field %q: %v", part.FormName(), err)
+		}
+		capture.fields[part.FormName()] = string(data)
+	}
