+package multipartbody
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+type capturedPart struct {
+	formName string
+	fileName string
+	data     []byte
+}
+
+func readParts(t *testing.T, contentType string, body *bytes.Reader) (filePart *capturedPart, fields map[string]string) {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %s", mediaType)
+	}
+
+	reader := multipart.NewReader(body, params["boundary"])
+	fields = make(map[string]string)
+	for {
+		part, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		data, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part %q: %v", part.FormName(), err)
+		}
+		if part.FileName() != "" {
+			if filePart != nil {
+				t.Fatalf("unexpected second file part")
+			}
+			filePart = &capturedPart{formName: part.FormName(), fileName: part.FileName(), data: data}
+			continue
+		}
+		fields[part.FormName()] = string(data)
+	}
+	if filePart == nil {
+		t.Fatalf("missing file part")
+	}
+	return filePart, fields
+}
+
+func TestNewFile(t *testing.T) {
+	content := []byte("hello world")
+
+	contentType, body, err := NewFile("file", "notes.txt", bytes.NewReader(content), nil)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	filePart, fields := readParts(t, contentType, body)
+	if filePart.formName != "file" {
+		t.Fatalf("unexpected form name: %s", filePart.formName)
+	}
+	if filePart.fileName != "notes.txt" {
+		t.Fatalf("unexpected file name: %s", filePart.fileName)
+	}
+	if !bytes.Equal(filePart.data, content) {
+		t.Fatalf("unexpected payload: %q", filePart.data)
+	}
+	if len(fields) != 0 {
+		t.Fatalf("unexpected fields: %#v", fields)
+	}
+}
+
+func TestNewFile_WithFields(t *testing.T) {
+	fields := url.Values{}
+	fields.Set("deal_id", "10")
+	fields.Set("person_id", "11")
+
+	contentType, body, err := NewFile("file", "doc.pdf", strings.NewReader("payload"), fields)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	filePart, got := readParts(t, contentType, body)
+	if string(filePart.data) != "payload" {
+		t.Fatalf("unexpected payload: %q", filePart.data)
+	}
+	if got["deal_id"] != "10" || got["person_id"] != "11" {
+		t.Fatalf("unexpected fields: %#v", got)
+	}
+}
+
+func TestNewFile_Validation(t *testing.T) {
+	src := strings.NewReader("x")
+
+	if _, _, err := NewFile("", "a.txt", src, nil); err == nil {
+		t.Fatal("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", src, nil); err == nil {
+		t.Fatal("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "a.txt", nil, nil); err == nil {
+		t.Fatal("expected error for nil source")
+	}
+}
+
+func TestNewFile_SourceReadError(t *testing.T) {
+	_, _, err := NewFile("file", "a.txt", &errReader{}, nil)
+	if err == nil || !strings.Contains(err.Error(), "boom") {
+		t.Fatalf("expected source read error, got %v", err)
+	}
+}
+
+type errReader struct{}
+
+func (r *errReader) Read(p []byte) (int, error) {
+	return 0, errors.New("boom")
+}
