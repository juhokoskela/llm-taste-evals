+func TestRetryTransport_Retries429WhenBodyIsReplayable(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var secondBody []byte
+	next := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		if req.Method == http.MethodPost && req.Body != nil {
+			data, err := io.ReadAll(req.Body)
+			if err != nil {
+				t.Fatalf("read request body: %v", err)
+			}
+			if calls == 2 {
+				secondBody = data
+			}
+		}
+		status := 429
+		if calls == 2 {
+			status = 200
+		}
+		return &http.Response{
+			StatusCode: status,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader("")),
+			Request:    req,
+		}, nil
+	})
+
+	rt := newRetryTransport(next, DefaultRetryPolicy(), retryTransportOptions{
+		sleep: func(context.Context, time.Duration) error { return nil },
+		now:   time.Now,
+	})
+
+	req, _ := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.test", strings.NewReader("upload-payload"))
+	resp, err := rt.RoundTrip(req)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	_ = resp.Body.Close()
+
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if resp.StatusCode != 200 {
+		t.Fatalf("expected status 200, got %d", resp.StatusCode)
+	}
+	if string(secondBody) != "upload-payload" {
+		t.Fatalf("replayed body mismatch: %q", secondBody)
+	}
+}
+
