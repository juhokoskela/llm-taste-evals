+func TestRawClient_Do_RetriesSeekableUploadBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	var bodies [][]byte
+	var attempts int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, body)
+		attempts++
+		current := attempts
+		mu.Unlock()
+
+		if r.URL.Path != "/files" {
+			t.Errorf("unexpected path: %s", r.URL.Path)
+		}
+		if r.ContentLength != int64(len("file-content")) {
+			t.Errorf("attempt %d content length = %d, want %d", current, r.ContentLength, len("file-content"))
+		}
+
+		if current == 1 {
+			w.Header().Set("Retry-After", "1")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"code":"rate_limit","message":"Too many requests"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"data":{"id":12,"name":"upload.txt"}}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	path := filepath.Join(t.TempDir(), "upload.txt")
+	if err := os.WriteFile(path, []byte("file-content"), 0o644); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = file.Close() })
+
+	policy := RetryPolicy{
+		MaxAttempts: 3,
+		BaseDelay:   time.Millisecond,
+		MaxDelay:    2 * time.Millisecond,
+		Jitter:      func(d time.Duration) time.Duration { return d },
+	}
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	var out struct {
+		Data struct {
+			ID   int    `json:"id"`
+			Name string `json:"name"`
+		} `json:"data"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, file, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	for i, body := range bodies {
+		if string(body) != "file-content" {
+			t.Fatalf("attempt %d body = %q, want full content", i+1, body)
+		}
+	}
+	if out.Data.ID != 12 || out.Data.Name != "upload.txt" {
+		t.Fatalf("unexpected data: %#v", out.Data)
+	}
+}
+
+func TestRawClient_Do_RetriesStreamedBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	var bodies [][]byte
+	var attempts int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, body)
+		attempts++
+		current := attempts
+		mu.Unlock()
+
+		if current == 1 {
+			w.Header().Set("Retry-After", "1")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"code":"rate_limit","message":"Too many requests"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	pipeReader, pipeWriter := io.Pipe()
+	go func() {
+		_, _ = pipeWriter.Write([]byte("streaming"))
+		_ = pipeWriter.Close()
+	}()
+
+	policy := RetryPolicy{
+		MaxAttempts: 3,
+		BaseDelay:   time.Millisecond,
+		MaxDelay:    2 * time.Millisecond,
+		Jitter:      func(d time.Duration) time.Duration { return d },
+	}
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, pipeReader, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok=true")
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	for i, body := range bodies {
+		if string(body) != "streaming" {
+			t.Fatalf("attempt %d body = %q, want full content", i+1, body)
+		}
+	}
+}
