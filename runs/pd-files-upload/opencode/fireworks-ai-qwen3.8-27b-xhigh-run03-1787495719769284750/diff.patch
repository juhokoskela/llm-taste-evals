+package multipartbody
+
+import (
+	"io"
+	"mime/multipart"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func decodeParts(t *testing.T, contentType string, body io.Reader) (fileNames []string, fileContents map[string]string, fields map[string][]string) {
+	t.Helper()
+
+	boundary := ""
+	for _, param := range strings.Split(contentType, ";") {
+		param = strings.TrimSpace(param)
+		if strings.HasPrefix(param, "boundary=") {
+			boundary = strings.TrimPrefix(param, "boundary=")
+		}
+	}
+	if boundary == "" {
+		t.Fatalf("missing boundary in content type %q", contentType)
+	}
+
+	reader := multipart.NewReader(body, boundary)
+	fields = map[string][]string{}
+	fileContents = map[string]string{}
+	for {
+		part, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("next part: %v", err)
+		}
+		data, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part %s: %v", part.FormName(), err)
+		}
+		if part.FileName() != "" {
+			fileNames = append(fileNames, part.FileName())
+			fileContents[part.FormName()] = string(data)
+		} else {
+			fields[part.FormName()] = append(fields[part.FormName()], string(data))
+		}
+		_ = part.Close()
+	}
+	return fileNames, fileContents, fields
+}
+
+func TestNewFile_SingleFilePart(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "doc.pdf", strings.NewReader("pdf-bytes"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	if !strings.HasPrefix(contentType, "multipart/form-data; boundary=") {
+		t.Fatalf("unexpected content type: %q", contentType)
+	}
+
+	fileNames, fileContents, fields := decodeParts(t, contentType, body)
+	if len(fileNames) != 1 || fileNames[0] != "doc.pdf" {
+		t.Fatalf("unexpected file names: %#v", fileNames)
+	}
+	if fileContents["file"] != "pdf-bytes" {
+		t.Fatalf("unexpected file content: %q", fileContents["file"])
+	}
+	if len(fields) != 0 {
+		t.Fatalf("unexpected fields: %#v", fields)
+	}
+}
+
+func TestNewFile_RejectsMissingInput(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "doc.pdf", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected field name error")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected file name error")
+	}
+	if _, _, err := NewFile("file", "doc.pdf", nil); err == nil {
+		t.Fatalf("expected content error")
+	}
+}
+
+func TestNew_FilePartAndFields(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "77")
+	fields.Set("person_id", "88")
+
+	contentType, body, err := New(fields, "file", "doc.pdf", strings.NewReader("pdf-bytes"))
+	if err != nil {
+		t.Fatalf("New error: %v", err)
+	}
+
+	fileNames, fileContents, gotFields := decodeParts(t, contentType, body)
+	if len(fileNames) != 1 || fileNames[0] != "doc.pdf" {
+		t.Fatalf("unexpected file names: %#v", fileNames)
+	}
+	if fileContents["file"] != "pdf-bytes" {
+		t.Fatalf("unexpected file content: %q", fileContents["file"])
+	}
+	if got := gotFields["deal_id"]; len(got) != 1 || got[0] != "77" {
+		t.Fatalf("unexpected deal_id field: %#v", got)
+	}
+	if got := gotFields["person_id"]; len(got) != 1 || got[0] != "88" {
+		t.Fatalf("unexpected person_id field: %#v", got)
+	}
+}
+
+func TestNew_EmptyFieldsMatchesNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentTypeA, bodyA, err := New(url.Values{}, "file", "doc.pdf", strings.NewReader("pdf-bytes"))
+	if err != nil {
+		t.Fatalf("New error: %v", err)
+	}
+	contentTypeB, bodyB, err := NewFile("file", "doc.pdf", strings.NewReader("pdf-bytes"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	namesA, contentsA, fieldsA := decodeParts(t, contentTypeA, bodyA)
+	namesB, contentsB, fieldsB := decodeParts(t, contentTypeB, bodyB)
+	if namesA[0] != namesB[0] || contentsA["file"] != contentsB["file"] || len(fieldsA) != len(fieldsB) {
+		t.Fatalf("mismatch: %#v/%#v vs %#v/%#v", namesA, contentsA, namesB, contentsB)
+	}
+}
