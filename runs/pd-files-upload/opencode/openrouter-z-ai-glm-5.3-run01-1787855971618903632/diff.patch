+func TestReplayableRequestBody(t *testing.T) {
+	t.Parallel()
+
+	if got, err := replayableRequestBody(nil); err != nil || got != nil {
+		t.Fatalf("nil body: got %v, %v", got, err)
+	}
+
+	// Readers http.NewRequest already makes replayable pass through
+	// unchanged, so buffering cannot observe or consume them.
+	reader := bytes.NewReader([]byte("payload"))
+	if got, err := replayableRequestBody(reader); err != nil || got != io.Reader(reader) {
+		t.Fatalf("bytes.Reader body: got %#v, %v", got, err)
+	}
+
+	// A reader that can only be read once (a multipart body streamed from
+	// an *os.File, say) is buffered so retries can resend it.
+	streamed := io.MultiReader(strings.NewReader("part-one,"), strings.NewReader("part-two"))
+	got, err := replayableRequestBody(streamed)
+	if err != nil {
+		t.Fatalf("streaming body error: %v", err)
+	}
+	content, err := io.ReadAll(got)
+	if err != nil {
+		t.Fatalf("read buffered body: %v", err)
+	}
+	if string(content) != "part-one,part-two" {
+		t.Fatalf("unexpected buffered body: %q", string(content))
+	}
+
+	failing := io.MultiReader(strings.NewReader("partial"), iotest.ErrReader(io.ErrClosedPipe))
+	if _, err := replayableRequestBody(failing); err == nil {
+		t.Fatalf("expected read error to propagate")
+	}
+}
+
+func TestRawClient_Do_RetriesNonReplayableReaderBody(t *testing.T) {
+	t.Parallel()
+
+	var bodies []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		bodies = append(bodies, string(body))
+		if len(bodies) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"error":"rate limited"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	policy := DefaultRetryPolicy()
+	policy.BaseDelay = time.Millisecond
+	policy.MaxDelay = time.Millisecond
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	// MultiReader is not one of the types http.NewRequest gives a GetBody,
+	// so without buffering the body it can never be replayed on retry.
+	body := io.MultiReader(strings.NewReader("part-one,"), strings.NewReader("part-two"))
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, body, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok")
+	}
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	if bodies[0] != "part-one,part-two" || bodies[1] != bodies[0] {
+		t.Fatalf("expected identical replayed bodies, got %q", bodies)
+	}
+}
