+func TestFilesService_AddFile_RetriesRateLimitedUpload(t *testing.T) {
+	t.Parallel()
+
+	var attempts int
+	client := newTestClientWithConfig(t, retryTestConfig(), func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		if _, _, err := r.FormFile("file"); err != nil {
+			t.Fatalf("form file: %v", err)
+		}
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"error":"rate limited"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"file_name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.AddFile(context.Background(), "upload.txt", strings.NewReader("file content"))
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if file.ID != 12 || attempts != 2 {
+		t.Fatalf("unexpected result: file=%#v attempts=%d", file, attempts)
+	}
+}
