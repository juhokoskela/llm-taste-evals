+	}
+
+	contentType, body, err := NewFileWithFields("file", "upload.txt", strings.NewReader("content"), fields)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	reader := multipart.NewReader(body, strings.TrimPrefix(contentType, "multipart/form-data; boundary="))
+	form, err := reader.ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("parse multipart body: %v", err)
