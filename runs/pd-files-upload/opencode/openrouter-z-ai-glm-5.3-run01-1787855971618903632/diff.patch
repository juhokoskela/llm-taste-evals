+
+func TestNewFile_EncodesReplayableBody(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "upload.txt", strings.NewReader("content"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	if !strings.HasPrefix(contentType, "multipart/form-data; boundary=") {
+		t.Fatalf("unexpected content type: %q", contentType)
+	}
+
+	// The body must stay seekable so http.NewRequest installs a GetBody,
+	// which is what makes the request replayable for retries.
+	if _, err := body.Seek(0, 0); err != nil {
+		t.Fatalf("expected seekable body: %v", err)
+	}
+	encoded, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	if !strings.Contains(string(encoded), "content") {
+		t.Fatalf("expected body to contain file content: %q", string(encoded))
+	}
+
+	if _, _, err := NewFile("", "upload.txt", strings.NewReader("content")); err == nil {
+		t.Fatalf("expected error for missing field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("content")); err == nil {
+		t.Fatalf("expected error for missing file name")
+	}
+	if _, _, err := NewFile("file", "upload.txt", nil); err == nil {
+		t.Fatalf("expected error for missing content")
+	}
+}
