+// retryTestConfig returns a config whose retry policy retries quickly,
+// for tests that exercise retry behavior against a rate-limiting server.
+func retryTestConfig() pipedrive.Config {
+	policy := pipedrive.DefaultRetryPolicy()
+	policy.BaseDelay = time.Millisecond
+	policy.MaxDelay = time.Millisecond
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+	return pipedrive.Config{RetryPolicy: &policy}
+}
