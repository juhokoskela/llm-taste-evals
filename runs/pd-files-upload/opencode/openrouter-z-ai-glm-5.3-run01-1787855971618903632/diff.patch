+		if header.Filename != "upload.txt" {
+			t.Fatalf("unexpected file name: %q", header.Filename)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"file_name":"upload.txt"}}`))
+	})
+
+	f, err := client.Files.AddFile(context.Background(), "upload.txt", strings.NewReader("file content"))
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if f.ID != 12 || f.FileName != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", f)
