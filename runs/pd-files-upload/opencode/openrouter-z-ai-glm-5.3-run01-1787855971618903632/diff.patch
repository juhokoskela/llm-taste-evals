+
+// replayableRequestBody returns a body reader http.NewRequest can replay
+// through GetBody, buffering src in memory when needed. Bodies that already
+// qualify — and nil, so requests without a body stay bodyless — are returned
+// unchanged.
+func replayableRequestBody(src io.Reader) (io.Reader, error) {
+	switch src.(type) {
+	case nil, *bytes.Reader, *bytes.Buffer, *strings.Reader:
+		return src, nil
+	}
+
+	buf, err := io.ReadAll(src)
+	if err != nil {
+		return nil, err
+	}
+	return bytes.NewReader(buf), nil
+}
