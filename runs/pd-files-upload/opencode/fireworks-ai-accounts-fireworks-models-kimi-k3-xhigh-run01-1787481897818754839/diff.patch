+package multipartbody
+
+import (
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func readParts(t *testing.T, contentType string, body io.Reader) []struct {
+	Name     string
+	FileName string
+	Content  string
+} {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if !strings.HasPrefix(mediaType, "multipart/form-data") {
+		t.Fatalf("unexpected media type: %q", mediaType)
+	}
+
+	var parts []struct {
+		Name     string
+		FileName string
+		Content  string
+	}
+	reader := multipart.NewReader(body, params["boundary"])
+	for {
+		part, err := reader.NextPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("next part: %v", err)
+		}
+		data, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		parts = append(parts, struct {
+			Name     string
+			FileName string
+			Content  string
+		}{part.FormName(), part.FileName(), string(data)})
+	}
+	return parts
+}
+
+func TestNewFileEncodesSingleFilePart(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "upload.txt", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	parts := readParts(t, contentType, body)
+	if len(parts) != 1 {
+		t.Fatalf("expected 1 part, got %d", len(parts))
+	}
+	if parts[0].Name != "file" || parts[0].FileName != "upload.txt" || parts[0].Content != "payload" {
+		t.Fatalf("unexpected part: %#v", parts[0])
+	}
+}
+
+func TestNewFileEncodesExtraFormFields(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "upload.txt", strings.NewReader("payload"),
+		Field{Name: "deal_id", Value: "7"},
+		Field{Name: "lead_id", Value: "adf21080-0e10-11eb-879b-05d71fb426ec"},
+	)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	parts := readParts(t, contentType, body)
+	if len(parts) != 3 {
+		t.Fatalf("expected 3 parts, got %d", len(parts))
+	}
+	if parts[0].Name != "deal_id" || parts[0].FileName != "" || parts[0].Content != "7" {
+		t.Fatalf("unexpected deal_id part: %#v", parts[0])
+	}
+	if parts[1].Name != "lead_id" || parts[1].Content != "adf21080-0e10-11eb-879b-05d71fb426ec" {
+		t.Fatalf("unexpected lead_id part: %#v", parts[1])
+	}
+	if parts[2].Name != "file" || parts[2].FileName != "upload.txt" || parts[2].Content != "payload" {
+		t.Fatalf("unexpected file part: %#v", parts[2])
+	}
+}
+
+func TestNewFileProducesReplayableRequestBody(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "upload.txt", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	req, err := http.NewRequest(http.MethodPost, "https://example.test", body)
+	if err != nil {
+		t.Fatalf("build request: %v", err)
+	}
+	req.Header.Set("Content-Type", contentType)
+	if req.GetBody == nil {
+		t.Fatalf("expected GetBody to be set so uploads can be retried")
+	}
+	clone, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	again, err := io.ReadAll(clone)
+	if err != nil {
+		t.Fatalf("read replayed body: %v", err)
+	}
+	if readParts(t, contentType, strings.NewReader(string(again)))[0].Content != "payload" {
+		t.Fatalf("replayed body does not match original")
+	}
+}
+
+func TestNewFileValidatesInputs(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "upload.txt", strings.NewReader("payload")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("payload")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "upload.txt", nil); err == nil {
+		t.Fatalf("expected error for nil content")
+	}
+	if _, _, err := NewFile("file", "upload.txt", strings.NewReader("payload"), Field{Name: "", Value: "x"}); err == nil {
+		t.Fatalf("expected error for empty extra field name")
+	}
+}
