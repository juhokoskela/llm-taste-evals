+func TestFilesService_AddUpload_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	var attempts int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     3,
+			BaseDelay:       time.Millisecond,
+			MaxDelay:        time.Millisecond,
+			Jitter:          func(d time.Duration) time.Duration { return d },
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		if !strings.Contains(string(body), "recording-bytes") {
+			t.Errorf("attempt %d: incomplete multipart body", attempts)
+		}
+		if attempts == 1 {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":77,"name":"recording.mp3"}}`))
+	})
+
+	file, err := client.Files.AddUpload(context.Background(), "recording.mp3", strings.NewReader("recording-bytes"))
+	if err != nil {
+		t.Fatalf("AddUpload error: %v", err)
+	}
+	if file.ID != 77 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+}
