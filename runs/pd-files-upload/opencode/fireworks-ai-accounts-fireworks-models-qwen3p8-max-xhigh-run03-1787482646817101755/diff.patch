+func newSeekableFile(fieldName, fileName string, src io.ReadSeeker) (string, io.Reader, error) {
+	start, err := src.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return "", nil, fmt.Errorf("measure multipart file: %w", err)
+	}
+	end, err := src.Seek(0, io.SeekEnd)
+	if err != nil {
+		return "", nil, fmt.Errorf("measure multipart file: %w", err)
+	}
+	if _, err := src.Seek(start, io.SeekStart); err != nil {
+		return "", nil, fmt.Errorf("rewind multipart file: %w", err)
+	}
+	if end < start {
+		return "", nil, fmt.Errorf("multipart file has negative size")
+	}
+
+	var buf bytes.Buffer
+	writer := multipart.NewWriter(&buf)
+	if _, err := writer.CreateFormFile(fieldName, fileName); err != nil {
+		return "", nil, fmt.Errorf("create multipart file: %w", err)
+	}
+
+	body := &seekableFileBody{
+		header: bytes.Clone(buf.Bytes()),
+		footer: []byte("\r\n--" + writer.Boundary() + "--\r\n"),
+		src:    src,
+		start:  start,
+		size:   end - start,
+	}
+	return writer.FormDataContentType(), body, nil
+}
+
+// seekableFileBody assembles a multipart/form-data body from a fixed header,
+// the file source, and a fixed footer. It replays from the beginning when
+// rewound, without buffering the file content in memory.
+type seekableFileBody struct {
+	header []byte
+	footer []byte
+	src    io.ReadSeeker
+	start  int64
+	size   int64
+
+	offset int64
+}
+
+func (b *seekableFileBody) total() int64 {
+	return int64(len(b.header)) + b.size + int64(len(b.footer))
+}
+
+func (b *seekableFileBody) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	total := b.total()
+	if b.offset >= total {
+		return 0, io.EOF
+	}
+
+	headerEnd := int64(len(b.header))
+	srcEnd := headerEnd + b.size
+
+	n := 0
+	for n < len(p) && b.offset < total {
+		switch {
+		case b.offset < headerEnd:
+			c := copy(p[n:], b.header[b.offset:])
+			b.offset += int64(c)
+			n += c
+		case b.offset < srcEnd:
+			c, err := b.src.Read(p[n:])
+			b.offset += int64(c)
+			n += c
+			if err != nil && !(errors.Is(err, io.EOF) && b.offset >= srcEnd) {
+				return n, err
+			}
+		default:
+			c := copy(p[n:], b.footer[b.offset-srcEnd:])
+			b.offset += int64(c)
+			n += c
+		}
+	}
+	return n, nil
+}
+
+func (b *seekableFileBody) Seek(offset int64, whence int) (int64, error) {
+	var abs int64
+	switch whence {
+	case io.SeekStart:
+		abs = offset
+	case io.SeekCurrent:
+		abs = b.offset + offset
+	case io.SeekEnd:
+		abs = b.total() + offset
+	default:
+		return 0, fmt.Errorf("multipart body: invalid whence %d", whence)
+	}
+	if abs < 0 {
+		return 0, fmt.Errorf("multipart body: negative seek position %d", abs)
+	}
+
+	headerEnd := int64(len(b.header))
+	srcEnd := headerEnd + b.size
+	switch {
+	case abs >= headerEnd && abs < srcEnd:
+		if _, err := b.src.Seek(b.start+(abs-headerEnd), io.SeekStart); err != nil {
+			return 0, err
+		}
+	case abs < headerEnd:
+		if _, err := b.src.Seek(b.start, io.SeekStart); err != nil {
+			return 0, err
+		}
+	}
+
+	b.offset = abs
+	return abs, nil
+}
+
+func (b *seekableFileBody) Close() error {
+	return nil
+}
