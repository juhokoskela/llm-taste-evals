+package multipartbody
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"strings"
+	"testing"
+)
+
+type plainReader struct {
+	r io.Reader
+}
+
+func (p plainReader) Read(b []byte) (int, error) { return p.r.Read(b) }
+
+func readAllAt(t *testing.T, body io.Reader, bufSize int) []byte {
+	t.Helper()
+
+	var out bytes.Buffer
+	buf := make([]byte, bufSize)
+	if _, err := io.CopyBuffer(&out, body, buf); err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	return out.Bytes()
+}
+
+func wantEncoding(t *testing.T, boundary, fieldName, fileName, content string) []byte {
+	t.Helper()
+
+	var buf bytes.Buffer
+	w := multipart.NewWriter(&buf)
+	if err := w.SetBoundary(boundary); err != nil {
+		t.Fatalf("set boundary: %v", err)
+	}
+	part, err := w.CreateFormFile(fieldName, fileName)
+	if err != nil {
+		t.Fatalf("create form file: %v", err)
+	}
+	if _, err := io.WriteString(part, content); err != nil {
+		t.Fatalf("write form file: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("close multipart writer: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func boundaryFromContentType(t *testing.T, contentType string) string {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %q", mediaType)
+	}
+	if params["boundary"] == "" {
+		t.Fatalf("missing boundary in content type %q", contentType)
+	}
+	return params["boundary"]
+}
+
+func TestNewFile_BufferedSource(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.txt", plainReader{strings.NewReader("hello")})
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	boundary := boundaryFromContentType(t, contentType)
+	want := wantEncoding(t, boundary, "file", "report.txt", "hello")
+
+	if got, ok := body.(*bytes.Reader); !ok {
+		t.Fatalf("expected *bytes.Reader for non-seekable source, got %T", got)
+	}
+	if got := readAllAt(t, body, 3); !bytes.Equal(got, want) {
+		t.Fatalf("unexpected body:\ngot  %q\nwant %q", got, want)
+	}
+}
+
+func TestNewFile_SeekableSourceMatchesBufferedEncoding(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "report.txt", strings.NewReader("hello"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	boundary := boundaryFromContentType(t, contentType)
+	want := wantEncoding(t, boundary, "file", "report.txt", "hello")
+
+	rs, ok := body.(io.ReadSeeker)
+	if !ok {
+		t.Fatalf("expected io.ReadSeeker body for seekable source, got %T", body)
+	}
+	if _, ok := body.(io.Closer); !ok {
+		t.Fatalf("expected io.Closer body so http.Request keeps it unwrapped, got %T", body)
+	}
+
+	if got := readAllAt(t, rs, 3); !bytes.Equal(got, want) {
+		t.Fatalf("unexpected body:\ngot  %q\nwant %q", got, want)
+	}
+
+	size, err := rs.Seek(0, io.SeekEnd)
+	if err != nil {
+		t.Fatalf("seek end: %v", err)
+	}
+	if size != int64(len(want)) {
+		t.Fatalf("expected size %d, got %d", len(want), size)
+	}
+}
+
+func TestNewFile_SeekableSourceReplaysAfterRewind(t *testing.T) {
+	t.Parallel()
+
+	_, body, err := NewFile("file", "report.txt", strings.NewReader("hello world"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	rs := body.(io.ReadSeeker)
+
+	first := readAllAt(t, rs, 4)
+	if _, err := rs.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind: %v", err)
+	}
+	second := readAllAt(t, rs, 5)
+	if !bytes.Equal(first, second) {
+		t.Fatalf("replayed body differs:\nfirst  %q\nsecond %q", first, second)
+	}
+}
+
+func TestNewFile_SeekableSourceStartsAtCurrentPosition(t *testing.T) {
+	t.Parallel()
+
+	src := strings.NewReader("PREFIXcontent")
+	if _, err := src.Seek(6, io.SeekStart); err != nil {
+		t.Fatalf("seek source: %v", err)
+	}
+
+	contentType, body, err := NewFile("file", "part.bin", src)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	boundary := boundaryFromContentType(t, contentType)
+	want := wantEncoding(t, boundary, "file", "part.bin", "content")
+
+	rs := body.(io.ReadSeeker)
+	if got := readAllAt(t, rs, 2); !bytes.Equal(got, want) {
+		t.Fatalf("unexpected body:\ngot  %q\nwant %q", got, want)
+	}
+
+	if _, err := rs.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind: %v", err)
+	}
+	if got := readAllAt(t, rs, 1024); !bytes.Equal(got, want) {
+		t.Fatalf("unexpected replayed body:\ngot  %q\nwant %q", got, want)
+	}
+}
+
+func TestNewFile_SeekableSourceSeek(t *testing.T) {
+	t.Parallel()
+
+	_, body, err := NewFile("file", "report.txt", strings.NewReader("hello"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+	rs := body.(io.ReadSeeker)
+
+	full := readAllAt(t, rs, 1024)
+	if _, err := rs.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek start: %v", err)
+	}
+
+	head := make([]byte, 5)
+	if _, err := io.ReadFull(rs, head); err != nil {
+		t.Fatalf("read head: %v", err)
+	}
+
+	if _, err := rs.Seek(-5, io.SeekCurrent); err != nil {
+		t.Fatalf("seek current: %v", err)
+	}
+	headAgain := readAllAt(t, rs, 5)
+	if !bytes.Equal(headAgain[:5], head) {
+		t.Fatalf("unexpected head after rewind: %q", headAgain[:5])
+	}
+
+	if _, err := rs.Seek(5, io.SeekStart); err != nil {
+		t.Fatalf("seek offset: %v", err)
+	}
+	rest := readAllAt(t, rs, 5)
+	if !bytes.Equal(append(head, rest...), full) {
+		t.Fatalf("split reads differ from full body")
+	}
+
+	if _, err := rs.Seek(-int64(len(full)), io.SeekEnd); err != nil {
+		t.Fatalf("seek end: %v", err)
+	}
+	if got := readAllAt(t, rs, 1024); !bytes.Equal(got, full) {
+		t.Fatalf("unexpected body after seek from end")
+	}
+
+	if _, err := rs.Seek(-1, io.SeekStart); err == nil {
+		t.Fatalf("expected error seeking before start")
+	}
+	if _, err := rs.Seek(0, 42); err == nil {
+		t.Fatalf("expected error for invalid whence")
+	}
+}
+
+func TestNewFile_SeekableSourceEmptyContent(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "empty.txt", strings.NewReader(""))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	boundary := boundaryFromContentType(t, contentType)
+	want := wantEncoding(t, boundary, "file", "empty.txt", "")
+
+	rs := body.(io.ReadSeeker)
+	if got := readAllAt(t, rs, 3); !bytes.Equal(got, want) {
+		t.Fatalf("unexpected body:\ngot  %q\nwant %q", got, want)
+	}
+	if _, err := rs.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind: %v", err)
+	}
+	if got := readAllAt(t, rs, 3); !bytes.Equal(got, want) {
+		t.Fatalf("unexpected replayed body:\ngot  %q\nwant %q", got, want)
+	}
+}
+
+type failingSeeker struct {
+	seekErr error
+}
+
+func (f failingSeeker) Read(b []byte) (int, error)     { return 0, io.EOF }
+func (f failingSeeker) Seek(int64, int) (int64, error) { return 0, f.seekErr }
+func TestNewFile_SeekableSourceMeasureError(t *testing.T) {
+	t.Parallel()
+
+	_, _, err := NewFile("file", "bad.bin", failingSeeker{seekErr: errors.New("boom")})
+	if err == nil {
+		t.Fatalf("expected error for failing seeker")
+	}
+}
+
+func TestNewFile_ValidationErrors(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "f.txt", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "f.txt", nil); err == nil {
+		t.Fatalf("expected error for nil source")
+	}
+}
