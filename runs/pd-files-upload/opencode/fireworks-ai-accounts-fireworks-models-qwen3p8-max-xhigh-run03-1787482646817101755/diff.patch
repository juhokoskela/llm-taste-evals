+func TestRawClient_Do_RetriesSeekableUploadOn429(t *testing.T) {
+	t.Parallel()
+
+	fileContent := "file upload payload"
+	var calls int
+	var bodies [][]byte
+	var contentLengths []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		bodies = append(bodies, body)
+		contentLengths = append(contentLengths, r.Header.Get("Content-Length"))
+
+		if calls == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	policy := DefaultRetryPolicy()
+	policy.BaseDelay = time.Millisecond
+	policy.MaxDelay = time.Millisecond
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+	policy.RetryAllMethods = true
+
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	file, err := os.CreateTemp(t.TempDir(), "upload-*")
+	if err != nil {
+		t.Fatalf("create temp file: %v", err)
+	}
+	if _, err := file.WriteString(fileContent); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	if _, err := file.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = file.Close() })
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, file, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok")
+	}
+
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+	for i, body := range bodies {
+		if string(body) != fileContent {
+			t.Fatalf("attempt %d body mismatch: got %q want %q", i+1, body, fileContent)
+		}
+	}
+	for i, cl := range contentLengths {
+		if cl != "19" {
+			t.Fatalf("attempt %d content length %q, want %q", i+1, cl, "19")
+		}
+	}
+}
