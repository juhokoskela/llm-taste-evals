+func TestRetryTransport_RetriesSeekableBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var bodies [][]byte
+	next := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		body, err := io.ReadAll(req.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		bodies = append(bodies, body)
+		status := 429
+		if calls == 2 {
+			status = 200
+		}
+		return &http.Response{
+			StatusCode: status,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader("")),
+			Request:    req,
+		}, nil
+	})
+
+	policy := DefaultRetryPolicy()
+	policy.BaseDelay = 0
+	policy.Jitter = func(d time.Duration) time.Duration { return d }
+
+	rt := newRetryTransport(next, policy, retryTransportOptions{
+		sleep: func(context.Context, time.Duration) error { return nil },
+		now:   time.Now,
+	})
+
+	body := readSeekCloser{strings.NewReader("upload payload")}
+	req, _ := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.test", body)
+	resp, err := rt.RoundTrip(req)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	_ = resp.Body.Close()
+
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if resp.StatusCode != 200 {
+		t.Fatalf("expected status 200, got %d", resp.StatusCode)
+	}
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 captured bodies, got %d", len(bodies))
+	}
+	if string(bodies[0]) != "upload payload" || string(bodies[1]) != "upload payload" {
+		t.Fatalf("replayed body mismatch: %q then %q", bodies[0], bodies[1])
+	}
+	if req.ContentLength != int64(len("upload payload")) {
+		t.Fatalf("expected content length %d, got %d", len("upload payload"), req.ContentLength)
+	}
+	if req.GetBody == nil {
+		t.Fatalf("expected GetBody to be wired for seekable request body")
+	}
+}
