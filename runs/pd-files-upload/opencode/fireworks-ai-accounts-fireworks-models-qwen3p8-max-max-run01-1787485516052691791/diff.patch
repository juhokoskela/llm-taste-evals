+// wireSeekableRequestBody makes a seekable request body replayable so the
+// retry transport can resend it. If the offset or size cannot be
+// determined the request is left untouched and simply is not retryable.
+//
+// The body is wrapped in a closer that does nothing: the HTTP transport
+// closes the request body after every attempt and would otherwise close
+// the caller's reader (for example an *os.File) before a retry could
+// rewind it. The caller keeps ownership of the reader.
+func wireSeekableRequestBody(req *http.Request, rs io.ReadSeeker) {
+	start, err := rs.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return
+	}
+	end, err := rs.Seek(0, io.SeekEnd)
+	if err != nil {
+		return
+	}
+	if _, err := rs.Seek(start, io.SeekStart); err != nil {
+		return
+	}
+
+	req.ContentLength = end - start
+	req.Body = &seekableBody{reader: rs}
+	req.GetBody = func() (io.ReadCloser, error) {
+		if _, err := rs.Seek(start, io.SeekStart); err != nil {
+			return nil, fmt.Errorf("rewind request body: %w", err)
+		}
+		return &seekableBody{reader: rs}, nil
+	}
+}
+
+type seekableBody struct {
+	reader io.ReadSeeker
+}
+
+func (b *seekableBody) Read(p []byte) (int, error) { return b.reader.Read(p) }
+
+func (b *seekableBody) Close() error { return nil }
