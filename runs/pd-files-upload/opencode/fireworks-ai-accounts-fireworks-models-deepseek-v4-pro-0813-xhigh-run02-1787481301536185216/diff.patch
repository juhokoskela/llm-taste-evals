+func TestFilesService_Add_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("file-content")
+
+	var calls int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			BaseDelay:       0,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if calls == 1 {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limited"}`))
+			return
+		}
+
+		contentType := r.Header.Get("Content-Type")
+		_, params, err := mime.ParseMediaType(contentType)
+		if err != nil {
+			t.Fatalf("parse content type: %v", err)
+		}
+		reader := multipart.NewReader(r.Body, params["boundary"])
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		payload, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		if !bytes.Equal(payload, content) {
+			t.Fatalf("unexpected payload on retry: %q", payload)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), "upload.txt", bytes.NewReader(content))
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls (retry after 429), got %d", calls)
+	}
+}
