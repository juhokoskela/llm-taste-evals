+func TestFilesService_Add_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	tmp, err := os.CreateTemp(t.TempDir(), "upload-*.txt")
+	if err != nil {
+		t.Fatalf("create temp file: %v", err)
+	}
+	if _, err := tmp.WriteString("file content"); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	if err := tmp.Close(); err != nil {
+		t.Fatalf("close temp file: %v", err)
+	}
+
+	var mu sync.Mutex
+	var bodies [][]byte
+	var calls int
+
+	policy := pipedrive.RetryPolicy{
+		MaxAttempts:     3,
+		BaseDelay:       time.Millisecond,
+		MaxDelay:        time.Millisecond,
+		Jitter:          func(d time.Duration) time.Duration { return d },
+		RetryAllMethods: true,
+	}
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, body)
+		calls++
+		attempt := calls
+		mu.Unlock()
+
+		if attempt == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	// *os.File is not one of the body types http.NewRequest equips with
+	// GetBody, so without a buffered upload body the 429 response would not
+	// be retried.
+	f, err := os.Open(tmp.Name())
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	defer f.Close()
+
+	file, err := client.Files.Add(context.Background(), "upload.txt", f)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if !bytes.Equal(bodies[0], bodies[1]) {
+		t.Fatalf("expected retried request to replay the same body")
+	}
+	if !bytes.Contains(bodies[1], []byte(`filename="upload.txt"`)) || !bytes.Contains(bodies[1], []byte("file content")) {
+		t.Fatalf("retried request body is missing the file part: %q", bodies[1])
+	}
+}
