+// Add uploads content as a file with fileName.
+//
+// The content is encoded into a replayable multipart request before it is
+// sent, so retry policies can safely resend uploads after a rate-limit or
+// transient response.
+func (s *FilesService) Add(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	if fileName == "" || content == nil {
+		return nil, fmt.Errorf("file name and content are required")
+	}
+
+	contentType, body, err := multipartbody.NewFile("file", fileName, content)
+	if err != nil {
+		return nil, err
+	}
+
+	return s.AddRaw(ctx, body, contentType, opts...)
+}
+
