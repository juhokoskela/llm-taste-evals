+func TestFilesService_Add_RetriesFileReaderAfterRateLimit(t *testing.T) {
+	filePath := t.TempDir() + "/upload.txt"
+	if err := os.WriteFile(filePath, []byte("file contents"), 0o600); err != nil {
+		t.Fatalf("write upload: %v", err)
+	}
+	file, err := os.Open(filePath)
+	if err != nil {
+		t.Fatalf("open upload: %v", err)
+	}
+	t.Cleanup(func() { _ = file.Close() })
+
+	var attempts int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			BaseDelay:       0,
+			Jitter:          func(d time.Duration) time.Duration { return d },
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+
+		contentType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			t.Fatalf("parse content type: %v", err)
+		}
+		if contentType != "multipart/form-data" {
+			t.Fatalf("unexpected content type: %q", contentType)
+		}
+		part, err := multipart.NewReader(r.Body, params["boundary"]).NextPart()
+		if err != nil {
+			t.Fatalf("read multipart part: %v", err)
+		}
+		if part.FormName() != "file" || part.FileName() != "upload.txt" {
+			t.Fatalf("unexpected multipart file: form=%q name=%q", part.FormName(), part.FileName())
+		}
+		body, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read upload: %v", err)
+		}
+		if string(body) != "file contents" {
+			t.Fatalf("unexpected upload body: %q", body)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":13,"name":"upload.txt"}}`))
+	})
+
+	got, err := client.Files.Add(context.Background(), "upload.txt", file)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if got.ID != 13 {
+		t.Fatalf("unexpected file: %#v", got)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+}
