+		if err != nil {
+			t.Fatalf("read body: %v", err)
+		}
+		if string(body) != "prebuilt multipart body" {
+			t.Fatalf("unexpected body: %q", body)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":13,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), strings.NewReader("prebuilt multipart body"), contentType)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 13 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
