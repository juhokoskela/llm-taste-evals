+// Add uploads content as a file. Pass a file name and reader, for example:
+//
+//	client.Files.Add(ctx, "document.pdf", file)
+//
+// The multipart body is buffered so retryable responses can safely replay the
+// upload. For backwards compatibility, Add also accepts a raw body and content
+// type as (io.Reader, string). New callers should use Add with a file name and
+// reader, or use AddRaw when sending a prebuilt multipart body.
+func (s *FilesService) Add(ctx context.Context, fileNameOrBody any, contentOrContentType any, opts ...FilesOption) (*File, error) {
+	switch fileName := fileNameOrBody.(type) {
+	case string:
+		content, ok := contentOrContentType.(io.Reader)
+		if !ok || content == nil {
+			return nil, fmt.Errorf("file content is required")
+		}
+		contentType, body, err := multipartbody.NewFile("file", fileName, content)
+		if err != nil {
+			return nil, err
+		}
+		return s.addRaw(ctx, body, contentType, opts...)
+	case io.Reader:
+		contentType, ok := contentOrContentType.(string)
+		if !ok {
+			return nil, fmt.Errorf("content type is required")
+		}
+		return s.addRaw(ctx, fileName, contentType, opts...)
+	default:
+		return nil, fmt.Errorf("file name and content are required")
+	}
+}
+
+// AddRaw uploads a prebuilt request body with its Content-Type header value.
