+func TestFilesService_AddFile_RetriesWithReplayableMultipartBody(t *testing.T) {
+	t.Parallel()
+
+	payload := []byte("file payload")
+	var calls int
+	policy := pipedrive.RetryPolicy{
+		MaxAttempts:     2,
+		BaseDelay:       0,
+		RetryAllMethods: true,
+	}
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.Header.Get("X-Test"); got != "upload" {
+			t.Fatalf("unexpected header X-Test: %q", got)
+		}
+		if ct := r.Header.Get("Content-Type"); !strings.HasPrefix(ct, "multipart/form-data;") {
+			t.Fatalf("unexpected content type: %q", ct)
+		}
+
+		reader, err := r.MultipartReader()
+		if err != nil {
+			t.Fatalf("multipart reader: %v", err)
+		}
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		if part.FormName() != "file" {
+			t.Fatalf("unexpected form name: %s", part.FormName())
+		}
+		if part.FileName() != "document.txt" {
+			t.Fatalf("unexpected filename: %s", part.FileName())
+		}
+		body, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read part body: %v", err)
+		}
+		if !bytes.Equal(body, payload) {
+			t.Fatalf("unexpected payload: %q", body)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"error":"rate limited"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":15,"name":"document.txt"}}`))
+	})
+
+	file, err := client.Files.AddFile(
+		context.Background(),
+		"document.txt",
+		bytes.NewReader(payload),
+		WithFilesRequestOptions(pipedrive.WithHeader("X-Test", "upload")),
+	)
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if file.ID != 15 || file.Name != "document.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
