+// Upload encodes content as a multipart file upload. The content is buffered
+// before the request so retries can safely replay it.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	contentType, body, err := multipartbody.NewFile("file", fileName, content)
+	if err != nil {
+		return nil, err
+	}
+	return s.add(ctx, body, contentType, opts...)
+}
+
