+func TestFilesService_Add_RetriesOpenFile(t *testing.T) {
+	t.Parallel()
+
+	bodyFile, err := os.CreateTemp(t.TempDir(), "multipart-body-*")
+	if err != nil {
+		t.Fatalf("create body file: %v", err)
+	}
+	const requestBody = "multipart body"
+	if _, err := bodyFile.WriteString(requestBody); err != nil {
+		t.Fatalf("write body file: %v", err)
+	}
+	if _, err := bodyFile.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind body file: %v", err)
+	}
+	t.Cleanup(func() { _ = bodyFile.Close() })
+
+	var attempts int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request body: %v", err)
+		}
+		if got := string(body); got != requestBody {
+			t.Fatalf("unexpected request body on attempt %d: %q", attempts, got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), bodyFile, "multipart/form-data; boundary=test")
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
+
+func TestFilesService_Upload_RetriesMultipartFile(t *testing.T) {
+	t.Parallel()
+
+	source, err := os.CreateTemp(t.TempDir(), "document-*")
+	if err != nil {
+		t.Fatalf("create source file: %v", err)
+	}
+	const fileContent = "file content"
+	if _, err := source.WriteString(fileContent); err != nil {
+		t.Fatalf("write source file: %v", err)
+	}
+	if _, err := source.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("rewind source file: %v", err)
+	}
+	t.Cleanup(func() { _ = source.Close() })
+
+	var attempts int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		part, err := r.MultipartReader()
+		if err != nil {
+			t.Fatalf("multipart reader on attempt %d: %v", attempts, err)
+		}
+		filePart, err := part.NextPart()
+		if err != nil {
+			t.Fatalf("multipart file part on attempt %d: %v", attempts, err)
+		}
+		if got := filePart.FormName(); got != "file" {
+			t.Fatalf("unexpected form name on attempt %d: %q", attempts, got)
+		}
+		if got := filePart.FileName(); got != "document.txt" {
+			t.Fatalf("unexpected file name on attempt %d: %q", attempts, got)
+		}
+		content, err := io.ReadAll(filePart)
+		if err != nil {
+			t.Fatalf("read multipart file on attempt %d: %v", attempts, err)
+		}
+		if got := string(content); got != fileContent {
+			t.Fatalf("unexpected file content on attempt %d: %q", attempts, got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":13,"file_name":"document.txt"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "document.txt", source)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	if file.ID != 13 || file.FileName != "document.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
