+func TestFilesService_Add_RetriesSeekableBodyOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("file contents")
+	body, contentType := newMultipartTempFile(t, "file", "document.txt", content)
+
+	policy := pipedrive.RetryPolicy{
+		MaxAttempts:     2,
+		BaseDelay:       0,
+		RetryAllMethods: true,
+	}
+	var attempts atomic.Int32
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		attempt := attempts.Add(1)
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.Header.Get("Content-Type"); got != contentType {
+			t.Fatalf("unexpected content type: %q", got)
+		}
+		assertMultipartFile(t, r, "file", "document.txt", content)
+
+		w.Header().Set("Content-Type", "application/json")
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"document.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), body, contentType)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if got := attempts.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+	if file.ID != 12 || file.Name != "document.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
