+func newMultipartTempFile(t *testing.T, fieldName, fileName string, content []byte) (*os.File, string) {
+	t.Helper()
+
+	file, err := os.CreateTemp(t.TempDir(), "multipart-*.body")
+	if err != nil {
+		t.Fatalf("create temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = file.Close() })
+
+	writer := multipart.NewWriter(file)
+	part, err := writer.CreateFormFile(fieldName, fileName)
+	if err != nil {
+		t.Fatalf("create form file: %v", err)
+	}
+	if _, err := part.Write(content); err != nil {
+		t.Fatalf("write form file: %v", err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatalf("close multipart writer: %v", err)
+	}
+	if _, err := file.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek temp file: %v", err)
+	}
+	return file, writer.FormDataContentType()
+}
+
+func assertMultipartFile(t *testing.T, r *http.Request, fieldName, fileName string, content []byte) {
+	t.Helper()
+
+	reader, err := r.MultipartReader()
+	if err != nil {
+		t.Fatalf("multipart reader: %v", err)
+	}
+	part, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("multipart part: %v", err)
+	}
+	if part.FormName() != fieldName {
+		t.Fatalf("unexpected form name: %q", part.FormName())
+	}
+	if part.FileName() != fileName {
+		t.Fatalf("unexpected file name: %q", part.FileName())
+	}
+	body, err := io.ReadAll(part)
+	if err != nil {
+		t.Fatalf("read part: %v", err)
+	}
+	if !bytes.Equal(body, content) {
+		t.Fatalf("unexpected body: %q", string(body))
+	}
+}
