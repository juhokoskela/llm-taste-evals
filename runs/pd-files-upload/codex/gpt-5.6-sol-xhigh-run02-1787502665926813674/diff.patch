+func TestFilesService_Upload_RetriesReplayableUploadFromFile(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("retryable file contents")
+	path := filepath.Join(t.TempDir(), "document.txt")
+	if err := os.WriteFile(path, content, 0o600); err != nil {
+		t.Fatalf("write upload: %v", err)
+	}
+	upload, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open upload: %v", err)
+	}
+	defer upload.Close()
+
+	attempts := 0
+	policy := pipedrive.RetryPolicy{MaxAttempts: 2, RetryAllMethods: true}
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		reader, err := r.MultipartReader()
+		if err != nil {
+			t.Fatalf("attempt %d multipart reader: %v", attempts, err)
+		}
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("attempt %d multipart part: %v", attempts, err)
+		}
+		if got := part.FileName(); got != "document.txt" {
+			t.Fatalf("attempt %d unexpected file name: %q", attempts, got)
+		}
+		got, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("attempt %d read multipart part: %v", attempts, err)
+		}
+		if !bytes.Equal(got, content) {
+			t.Fatalf("attempt %d unexpected file contents: %q", attempts, got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":13,"name":"document.txt"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "document.txt", upload)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	if file.ID != 13 || file.Name != "document.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
