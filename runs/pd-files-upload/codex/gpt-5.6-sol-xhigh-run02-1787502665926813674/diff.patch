+func TestFilesService_Add_RetriesReplayableBody(t *testing.T) {
+	t.Parallel()
+
+	const body = "one-shot multipart body"
+	const contentType = "multipart/form-data; boundary=test"
+	attempts := 0
+	policy := pipedrive.RetryPolicy{MaxAttempts: 2, RetryAllMethods: true}
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		got, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("attempt %d read body: %v", attempts, err)
+		}
+		if string(got) != body {
+			t.Fatalf("attempt %d unexpected body: %q", attempts, got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	oneShotBody := io.NopCloser(strings.NewReader(body))
+	file, err := client.Files.Add(context.Background(), oneShotBody, contentType)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
