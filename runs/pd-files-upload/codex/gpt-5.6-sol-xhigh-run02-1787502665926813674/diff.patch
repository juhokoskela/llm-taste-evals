+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("file contents")
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+
+		reader, err := r.MultipartReader()
+		if err != nil {
+			t.Fatalf("multipart reader: %v", err)
+		}
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("multipart part: %v", err)
+		}
+		if got := part.FormName(); got != "file" {
+			t.Fatalf("unexpected form name: %q", got)
+		}
+		if got := part.FileName(); got != "upload.txt" {
+			t.Fatalf("unexpected file name: %q", got)
+		}
+		got, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read multipart part: %v", err)
+		}
+		if !bytes.Equal(got, content) {
+			t.Fatalf("unexpected file contents: %q", got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "upload.txt", bytes.NewReader(content))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
