+// Upload adds a file, encoding content as a replayable multipart body.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	cfg := newFilesOptions(opts)
+	if fileName == "" || content == nil {
+		return nil, fmt.Errorf("file name and content are required")
+	}
+
+	contentType, body, err := multipartbody.NewFile("file", fileName, content)
+	if err != nil {
+		return nil, err
+	}
+	return s.add(ctx, body, contentType, cfg)
+}
