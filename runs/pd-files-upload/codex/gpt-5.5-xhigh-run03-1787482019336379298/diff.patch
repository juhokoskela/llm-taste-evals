+func prepareReaderForRequest(body io.Reader) (io.Reader, func() (io.ReadCloser, error), error) {
+	switch body.(type) {
+	case *bytes.Buffer, *bytes.Reader, *strings.Reader:
+		return body, nil, nil
+	}
+
+	seeker, ok := body.(io.ReadSeeker)
+	if !ok {
+		return body, nil, nil
+	}
+
+	start, err := seeker.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return nil, nil, fmt.Errorf("record body position: %w", err)
+	}
+	if readerAt, ok := body.(io.ReaderAt); ok {
+		end, err := seeker.Seek(0, io.SeekEnd)
+		if err != nil {
+			return nil, nil, fmt.Errorf("measure body length: %w", err)
+		}
+		if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+			return nil, nil, fmt.Errorf("restore body position: %w", err)
+		}
+		getBody := func() (io.ReadCloser, error) {
+			return io.NopCloser(io.NewSectionReader(readerAt, start, end-start)), nil
+		}
+		body, err := getBody()
+		if err != nil {
+			return nil, nil, err
+		}
+		return body, getBody, nil
+	}
+
+	getBody := func() (io.ReadCloser, error) {
+		if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+			return nil, err
+		}
+		return replayableReadCloser{ReadSeeker: seeker}, nil
+	}
+	return replayableReadCloser{ReadSeeker: seeker}, getBody, nil
+}
+
+type replayableReadCloser struct {
+	io.ReadSeeker
+}
+
+func (replayableReadCloser) Close() error {
+	return nil
+}
