+func TestFilesService_Add_RetriesMultipartUploadAfterRateLimit(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "bulk.pdf")
+	if err := os.WriteFile(path, []byte("bulk-file"), 0o600); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	defer f.Close()
+
+	var calls int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			BaseDelay:       0,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		reader, err := r.MultipartReader()
+		if err != nil {
+			t.Fatalf("multipart reader: %v", err)
+		}
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("multipart part: %v", err)
+		}
+		if part.FileName() != "bulk.pdf" {
+			t.Fatalf("unexpected file name: %q", part.FileName())
+		}
+		content, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read multipart part: %v", err)
+		}
+		if string(content) != "bulk-file" {
+			t.Fatalf("unexpected body on attempt %d: %q", calls, string(content))
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":14,"name":"bulk.pdf"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), "bulk.pdf", f)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if file.ID != 14 || file.Name != "bulk.pdf" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
