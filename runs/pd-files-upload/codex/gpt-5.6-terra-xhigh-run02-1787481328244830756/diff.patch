+func TestFilesService_Add_RetriesReplayableUpload(t *testing.T) {
+	contents := []byte("file contents")
+	path := t.TempDir() + "/upload.txt"
+	if err := os.WriteFile(path, contents, 0o600); err != nil {
+		t.Fatalf("write upload fixture: %v", err)
+	}
+
+	var calls int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			BaseDelay:       0,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+
+		mediaType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			t.Fatalf("parse content type: %v", err)
+		}
+		if mediaType != "multipart/form-data" {
+			t.Fatalf("unexpected media type: %q", mediaType)
+		}
+		reader := multipart.NewReader(r.Body, params["boundary"])
+		part, err := reader.NextPart()
+		if err != nil {
+			t.Fatalf("read multipart part: %v", err)
+		}
+		if got := part.FormName(); got != "file" {
+			t.Fatalf("unexpected form name: %q", got)
+		}
+		if got := part.FileName(); got != "upload.txt" {
+			t.Fatalf("unexpected file name: %q", got)
+		}
+		body, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read multipart content: %v", err)
+		}
+		if !bytes.Equal(body, contents) {
+			t.Fatalf("unexpected multipart content: %q", body)
+		}
+
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	content, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open upload fixture: %v", err)
+	}
+	t.Cleanup(func() { _ = content.Close() })
+
+	file, err := client.Files.Add(context.Background(), "upload.txt", content)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+	if file.ID != 12 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
