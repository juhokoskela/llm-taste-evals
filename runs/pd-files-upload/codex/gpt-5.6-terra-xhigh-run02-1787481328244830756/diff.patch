+// Add uploads a file as multipart/form-data.
+//
+// Pass a file name and its contents:
+//
+//	client.Files.Add(ctx, "contract.pdf", file)
+//
+// The multipart body is replayable, so retry policies can safely retry the
+// upload after a retryable response. The legacy raw-body form
+// Add(ctx, body, contentType) remains supported for compatibility.
+func (s *FilesService) Add(ctx context.Context, fileNameOrBody, contentOrContentType any, opts ...FilesOption) (*File, error) {
+	switch fileNameOrBody := fileNameOrBody.(type) {
+	case string:
+		content, ok := contentOrContentType.(io.Reader)
+		if fileNameOrBody == "" || !ok || content == nil {
+			return nil, fmt.Errorf("file name and content are required")
+		}
+		contentType, body, err := multipartbody.NewFile("file", fileNameOrBody, content)
+		if err != nil {
+			return nil, err
+		}
+		return s.add(ctx, body, contentType, opts...)
+	case io.Reader:
+		contentType, ok := contentOrContentType.(string)
+		if !ok || contentType == "" {
+			return nil, fmt.Errorf("content type is required")
+		}
+		return s.add(ctx, fileNameOrBody, contentType, opts...)
+	default:
+		return nil, fmt.Errorf("file name and content are required")
+	}
+}
