+func TestFilesService_Add_RetriesMultipartUpload(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("file contents")
+	path := filepath.Join(t.TempDir(), "upload.txt")
+	if err := os.WriteFile(path, content, 0o600); err != nil {
+		t.Fatalf("write upload fixture: %v", err)
+	}
+	fileHandle, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open upload fixture: %v", err)
+	}
+	t.Cleanup(func() { _ = fileHandle.Close() })
+
+	var attempts int
+	policy := pipedrive.DefaultRetryPolicy()
+	policy.MaxAttempts = 2
+	policy.BaseDelay = 0
+	policy.RetryAllMethods = true
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+
+		mediaType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			t.Fatalf("parse content type: %v", err)
+		}
+		part, err := multipart.NewReader(r.Body, params["boundary"]).NextPart()
+		if err != nil {
+			t.Fatalf("read multipart part: %v", err)
+		}
+		if mediaType != "multipart/form-data" || part.FileName() != "upload.txt" {
+			t.Fatalf("unexpected multipart upload: media type=%q filename=%q", mediaType, part.FileName())
+		}
+		got, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read multipart content: %v", err)
+		}
+		if !bytes.Equal(got, content) {
+			t.Fatalf("unexpected multipart content on attempt %d: %q", attempts, got)
+		}
+
+		if attempts == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Add(context.Background(), "upload.txt", fileHandle)
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if attempts != 2 {
+		t.Fatalf("expected 2 attempts, got %d", attempts)
+	}
+	if file.ID != 12 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
