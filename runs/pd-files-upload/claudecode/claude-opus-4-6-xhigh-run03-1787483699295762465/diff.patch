+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		ct := r.Header.Get("Content-Type")
+		if !strings.HasPrefix(ct, "multipart/form-data") {
+			t.Fatalf("unexpected content type: %q", ct)
+		}
+		f, fh, err := r.FormFile("file")
+		if err != nil {
+			t.Fatalf("FormFile: %v", err)
+		}
+		defer f.Close()
+		if fh.Filename != "upload.txt" {
+			t.Fatalf("unexpected filename: %q", fh.Filename)
+		}
+		var buf bytes.Buffer
+		if _, err := buf.ReadFrom(f); err != nil {
+			t.Fatalf("read file: %v", err)
+		}
+		if buf.String() != "hello" {
+			t.Fatalf("unexpected file content: %q", buf.String())
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "upload.txt", strings.NewReader("hello"))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+}
