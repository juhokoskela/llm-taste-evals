+func TestFilesService_Upload_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts: 3,
+			BaseDelay:   time.Millisecond,
+			MaxDelay:    time.Millisecond,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if calls < 3 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":99,"name":"retry.txt"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "retry.txt", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 99 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if calls != 3 {
+		t.Fatalf("expected 3 calls (2 retries), got %d", calls)
+	}
+}
