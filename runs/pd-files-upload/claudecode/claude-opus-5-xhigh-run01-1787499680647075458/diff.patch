+package pipedrive
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// retryingRawClient wires a RawClient to a client whose transport retries
+// every method, mirroring the RetryPolicy{RetryAllMethods: true} setup users
+// reach for during bulk imports.
+func retryingRawClient(t *testing.T, handler http.HandlerFunc) *RawClient {
+	t.Helper()
+
+	srv := httptest.NewServer(handler)
+	t.Cleanup(srv.Close)
+
+	policy := RetryPolicy{
+		MaxAttempts:     3,
+		BaseDelay:       time.Millisecond,
+		MaxDelay:        time.Millisecond,
+		RetryAllMethods: true,
+	}
+	httpClient := NewHTTPClient(Config{
+		BaseURL:     srv.URL,
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+	return raw
+}
+
+type recordedAttempts struct {
+	mu     sync.Mutex
+	bodies []string
+	length []int64
+}
+
+func (r *recordedAttempts) record(t *testing.T, req *http.Request) int {
+	t.Helper()
+
+	body, err := io.ReadAll(req.Body)
+	if err != nil {
+		t.Errorf("read request body: %v", err)
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.bodies = append(r.bodies, string(body))
+	r.length = append(r.length, req.ContentLength)
+	return len(r.bodies)
+}
+
+func (r *recordedAttempts) snapshot() ([]string, []int64) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]string(nil), r.bodies...), append([]int64(nil), r.length...)
+}
+
+func tempFile(t *testing.T, content string) *os.File {
+	t.Helper()
+
+	path := filepath.Join(t.TempDir(), "upload.bin")
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = f.Close() })
+	return f
+}
+
+// A seekable body (the *os.File case from os.Open) must be replayed on 429
+// instead of failing the upload on the first attempt.
+func TestRawClient_Do_RetriesSeekableBody(t *testing.T) {
+	t.Parallel()
+
+	var attempts recordedAttempts
+	raw := retryingRawClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if attempts.record(t, r) == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	})
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	err := raw.Do(context.Background(), http.MethodPost, "/files", nil, tempFile(t, "file-contents"), &out)
+	if err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok")
+	}
+
+	bodies, lengths := attempts.snapshot()
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	for i, body := range bodies {
+		if body != "file-contents" {
+			t.Fatalf("attempt %d sent %q, want %q", i+1, body, "file-contents")
+		}
+		if lengths[i] != int64(len("file-contents")) {
+			t.Fatalf("attempt %d had content length %d, want %d", i+1, lengths[i], len("file-contents"))
+		}
+	}
+}
+
+// A seekable body that has already been partially consumed must replay from
+// the position it was handed over at, not from the start of the file.
+func TestRawClient_Do_RetriesPartiallyReadSeekableBody(t *testing.T) {
+	t.Parallel()
+
+	var attempts recordedAttempts
+	raw := retryingRawClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if attempts.record(t, r) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		_, _ = w.Write([]byte(`{}`))
+	})
+
+	f := tempFile(t, "skip:payload")
+	if _, err := f.Seek(int64(len("skip:")), io.SeekStart); err != nil {
+		t.Fatalf("seek: %v", err)
+	}
+
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, f, nil); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+
+	bodies, _ := attempts.snapshot()
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	for i, body := range bodies {
+		if body != "payload" {
+			t.Fatalf("attempt %d sent %q, want %q", i+1, body, "payload")
+		}
+	}
+}
+
+// bytes/strings readers were already replayable through net/http; keep them
