index 0000000..9056bad
--- /dev/null
+++ b/pipedrive/requestbody.go
@@ -0,0 +1,72 @@
+package pipedrive
+
+import (
+	"io"
+	"net/http"
+)
+
+// adoptRequestBody adjusts how net/http treats a caller-supplied body reader.
+//
+// http.NewRequest only knows how to rebuild the body types it recognizes
+// (*bytes.Buffer, *bytes.Reader, *strings.Reader); everything else is sent
+// with a nil GetBody. The retry transport refuses to replay a request whose
+// body it cannot rebuild, so an upload streamed from, say, an *os.File would
+// fail on the first 429 while every other call retried normally.
+//
+// Two things are fixed here:
+//
+//   - A body that can seek gets a GetBody that rewinds to the offset the
+//     caller handed it over at, plus the exact Content-Length that offset
+//     implies. Nothing is buffered, so large uploads keep streaming.
+//   - A body that is also an io.Closer is wrapped, because these methods take
+//     an io.Reader: closing it is the caller's job, and letting the transport
+//     close the file after the first attempt would break the replay anyway.
+//
+// A body that can neither be recognized nor rewound (an io.Pipe, say) is left
+// alone. Replaying it would resend a drained reader and upload a truncated
+// file, so not retrying is the correct outcome.
+func adoptRequestBody(req *http.Request, body io.Reader) {
+	if req.Body == nil || req.Body == http.NoBody {
+		return
+	}
+	if _, ok := body.(io.Closer); ok {
+		req.Body = io.NopCloser(body)
+	}
+	if req.GetBody != nil {
+		return
+	}
+
+	seeker, ok := body.(io.Seeker)
+	if !ok {
+		return
+	}
+	start, err := seeker.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return
+	}
+	end, err := seeker.Seek(0, io.SeekEnd)
+	if err != nil {
+		// Leave the reader where it was found; the request is sent
+		// unreplayable rather than from an unknown offset.
+		_, _ = seeker.Seek(start, io.SeekStart)
+		return
+	}
+	if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+		return
+	}
+
+	if end <= start {
+		req.Body = http.NoBody
+		req.ContentLength = 0
+		req.GetBody = func() (io.ReadCloser, error) { return http.NoBody, nil }
+		return
+	}
+
+	req.ContentLength = end - start
+	req.GetBody = func() (io.ReadCloser, error) {
+		if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+			return nil, err
+		}
+		return io.NopCloser(body), nil
+	}
+}
