+package pipedrive
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+// failingSeeker fails the nth Seek call it receives, counting from 1.
+type failingSeeker struct {
+	io.Reader
+	failOn int
+	calls  int
+	offset int64
+}
+
+func (f *failingSeeker) Seek(offset int64, whence int) (int64, error) {
+	f.calls++
+	if f.calls == f.failOn {
+		return 0, errors.New("seek not supported")
+	}
+	switch whence {
+	case io.SeekStart:
+		f.offset = offset
+	case io.SeekCurrent:
+		f.offset += offset
+	case io.SeekEnd:
+		f.offset = int64(len("payload")) + offset
+	}
+	return f.offset, nil
+}
+
+func newTestRequest(t *testing.T, body io.Reader) *http.Request {
+	t.Helper()
+
+	req, err := http.NewRequest(http.MethodPost, "https://example.test/files", body)
+	if err != nil {
+		t.Fatalf("NewRequest error: %v", err)
+	}
+	return req
+}
+
+// A reader that cannot report its position is left alone: no GetBody, so the
+// retry transport will not resend a body it cannot rebuild.
+func TestAdoptRequestBody_LeavesUnseekableBodyUnreplayable(t *testing.T) {
+	t.Parallel()
+
+	cases := map[string]int{
+		"current position fails": 1,
+		"end position fails":     2,
+		"rewind fails":           3,
+	}
+
+	for name, failOn := range cases {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			body := &failingSeeker{Reader: strings.NewReader("payload"), failOn: failOn}
+			req := newTestRequest(t, body)
+			adoptRequestBody(req, body)
+
+			if req.GetBody != nil {
+				t.Fatalf("expected no GetBody")
+			}
+			if req.ContentLength > 0 {
+				t.Fatalf("expected no content length, got %d", req.ContentLength)
+			}
+		})
+	}
+}
+
+// A rewind that starts working and then fails must surface as an error rather
+// than a silently truncated retry.
+func TestAdoptRequestBody_PropagatesReplayError(t *testing.T) {
+	t.Parallel()
+
+	body := &failingSeeker{Reader: strings.NewReader("payload"), failOn: 4}
+	req := newTestRequest(t, body)
+	adoptRequestBody(req, body)
+
+	if req.GetBody == nil {
+		t.Fatalf("expected GetBody")
+	}
+	if req.ContentLength != int64(len("payload")) {
+		t.Fatalf("unexpected content length: %d", req.ContentLength)
+	}
+	if _, err := req.GetBody(); err == nil {
+		t.Fatalf("expected replay error")
+	}
+}
+
+func TestAdoptRequestBody_ReplaysEmptySeekableBody(t *testing.T) {
+	t.Parallel()
+
+	body := strings.NewReader("")
+	req := newTestRequest(t, body)
+	// http.NewRequest already collapses an empty *strings.Reader, so drive
+	// the empty branch through a type it does not recognize.
+	req.Body = io.NopCloser(body)
+	req.GetBody = nil
+	req.ContentLength = -1
+
+	adoptRequestBody(req, struct{ io.ReadSeeker }{body})
+
+	if req.Body != http.NoBody {
+		t.Fatalf("expected http.NoBody")
+	}
+	if req.ContentLength != 0 {
+		t.Fatalf("unexpected content length: %d", req.ContentLength)
+	}
+	replay, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	if replay != http.NoBody {
+		t.Fatalf("expected http.NoBody replay")
+	}
+}
+
+// Bodies net/http already knows how to rebuild keep their own GetBody.
+func TestAdoptRequestBody_KeepsRecognizedBody(t *testing.T) {
+	t.Parallel()
+
+	body := strings.NewReader("payload")
+	req := newTestRequest(t, body)
+	original := req.GetBody
+
+	adoptRequestBody(req, body)
+
+	if req.GetBody == nil {
+		t.Fatalf("expected GetBody")
+	}
+	replay, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	content, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatalf("read replay: %v", err)
+	}
+	if string(content) != "payload" {
+		t.Fatalf("unexpected replay: %q", string(content))
+	}
+	if original == nil {
+		t.Fatalf("expected net/http to have set GetBody")
+	}
+}
