+}
+
+// A body that cannot be rewound still must not be replayed: resending a
+// drained reader would upload a truncated file.
+func TestRawClient_Do_DoesNotRetryUnrewindableBody(t *testing.T) {
+	t.Parallel()
+
+	var attempts recordedAttempts
+	raw := retryingRawClient(t, func(w http.ResponseWriter, r *http.Request) {
+		attempts.record(t, r)
+		w.WriteHeader(http.StatusTooManyRequests)
+	})
+
+	pr, pw := io.Pipe()
+	go func() {
+		_, _ = io.WriteString(pw, "streamed")
+		_ = pw.Close()
+	}()
+
+	err := raw.Do(context.Background(), http.MethodPost, "/files", nil, pr, nil)
+	if err == nil {
+		t.Fatalf("expected rate limit error")
+	}
+
+	bodies, _ := attempts.snapshot()
+	if len(bodies) != 1 {
+		t.Fatalf("expected 1 attempt, got %d", len(bodies))
+	}
+}
+
+type closeTrackingReader struct {
+	io.ReadSeeker
+	closed bool
+}
+
+func (c *closeTrackingReader) Close() error {
+	c.closed = true
+	return nil
+}
+
+// Do takes an io.Reader, so closing it stays the caller's job — and closing
+// it early would break the replay on retry.
+func TestRawClient_Do_DoesNotCloseCallerBody(t *testing.T) {
+	t.Parallel()
+
+	raw := retryingRawClient(t, func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		_, _ = w.Write([]byte(`{}`))
+	})
+
+	body := &closeTrackingReader{ReadSeeker: strings.NewReader("payload")}
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, body, nil); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if body.closed {
+		t.Fatalf("caller-supplied body was closed by the SDK")
+	}
+}
+
+// http.NoBody is already the canonical empty body; leave it recognizable so
+// the retry transport keeps treating the request as replayable.
+func TestRawClient_Do_RetriesNoBody(t *testing.T) {
+	t.Parallel()
+
+	var attempts recordedAttempts
+	raw := retryingRawClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if attempts.record(t, r) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		_, _ = w.Write([]byte(`{}`))
+	})
+
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, http.NoBody, nil); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+
+	bodies, _ := attempts.snapshot()
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+}
+
+func TestRawClient_Do_SendsEmptySeekableBody(t *testing.T) {
+	t.Parallel()
+
+	var attempts recordedAttempts
+	raw := retryingRawClient(t, func(w http.ResponseWriter, r *http.Request) {
+		attempts.record(t, r)
+		_, _ = w.Write([]byte(`{}`))
+	})
+
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, tempFile(t, ""), nil); err != nil {
