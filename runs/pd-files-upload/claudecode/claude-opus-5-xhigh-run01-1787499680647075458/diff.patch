+
+	path := filepath.Join(t.TempDir(), "doc.bin")
+	if err := os.WriteFile(path, []byte("file-contents"), 0o600); err != nil {
+		t.Fatalf("write file: %v", err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open file: %v", err)
+	}
+	t.Cleanup(func() { _ = f.Close() })
+
+	file, err := client.Files.Add(context.Background(), f, "application/octet-stream")
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 3 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(attempts) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(attempts))
+	}
+	for i, body := range attempts {
+		if body != "file-contents" {
+			t.Fatalf("attempt %d sent %q, want %q", i+1, body, "file-contents")
+		}
+	}
+
+	// The caller still owns the file handle.
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("file was closed by the SDK: %v", err)
+	}
+}
