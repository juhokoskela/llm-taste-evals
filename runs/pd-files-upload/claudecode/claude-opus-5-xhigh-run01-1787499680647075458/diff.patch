+	}
+
+	bodies, _ := attempts.snapshot()
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	if bodies[1] != "payload" {
+		t.Fatalf("replayed body was %q, want %q", bodies[1], "payload")
