+)
+
+type uploadAttempt struct {
+	values   url.Values
+	fileName string
+	content  string
+}
+
+type uploadRecorder struct {
+	mu       sync.Mutex
+	attempts []uploadAttempt
+}
+
+func (u *uploadRecorder) record(t *testing.T, r *http.Request) int {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil {
+		t.Errorf("parse content type: %v", err)
+		return 0
+	}
+	if mediaType != "multipart/form-data" {
+		t.Errorf("unexpected media type: %q", mediaType)
+		return 0
+	}
+
+	form, err := multipart.NewReader(r.Body, params["boundary"]).ReadForm(1 << 20)
+	if err != nil {
+		t.Errorf("read form: %v", err)
+		return 0
+	}
+	defer func() { _ = form.RemoveAll() }()
+
+	attempt := uploadAttempt{values: url.Values(form.Value)}
+	if files := form.File["file"]; len(files) == 1 {
+		attempt.fileName = files[0].Filename
+		opened, err := files[0].Open()
+		if err != nil {
+			t.Errorf("open file part: %v", err)
+			return 0
+		}
+		defer func() { _ = opened.Close() }()
+		content, err := io.ReadAll(opened)
+		if err != nil {
+			t.Errorf("read file part: %v", err)
+			return 0
+		}
+		attempt.content = string(content)
+	}
+
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.attempts = append(u.attempts, attempt)
+	return len(u.attempts)
+}
+
+func (u *uploadRecorder) snapshot() []uploadAttempt {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return append([]uploadAttempt(nil), u.attempts...)
+}
+
+func retryAllClient(t *testing.T, handler http.HandlerFunc) *Client {
+	t.Helper()
+
+	policy := pipedrive.RetryPolicy{
+		MaxAttempts:     3,
+		BaseDelay:       time.Millisecond,
+		MaxDelay:        time.Millisecond,
+		RetryAllMethods: true,
+	}
+	return newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, handler)
+}
