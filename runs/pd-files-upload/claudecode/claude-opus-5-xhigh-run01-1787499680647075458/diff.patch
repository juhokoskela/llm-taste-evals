+package multipartbody
+
+import (
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func parseParts(t *testing.T, contentType string, body io.Reader) *multipart.Reader {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse media type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %q", mediaType)
+	}
+	return multipart.NewReader(body, params["boundary"])
+}
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "doc.txt", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	form, err := parseParts(t, contentType, body).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read form: %v", err)
+	}
+	t.Cleanup(func() { _ = form.RemoveAll() })
+
+	files := form.File["file"]
+	if len(files) != 1 {
+		t.Fatalf("expected one file part, got %d", len(files))
+	}
+	if files[0].Filename != "doc.txt" {
+		t.Fatalf("unexpected file name: %q", files[0].Filename)
+	}
+}
+
+func TestNewFileWithFields(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "42")
+	fields.Set("person_id", "7")
+
+	contentType, body, err := NewFileWithFields("file", "doc.txt", strings.NewReader("payload"), fields)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	form, err := parseParts(t, contentType, body).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read form: %v", err)
+	}
+	t.Cleanup(func() { _ = form.RemoveAll() })
+
+	if got := form.Value["deal_id"]; len(got) != 1 || got[0] != "42" {
+		t.Fatalf("unexpected deal_id: %#v", got)
+	}
+	if got := form.Value["person_id"]; len(got) != 1 || got[0] != "7" {
+		t.Fatalf("unexpected person_id: %#v", got)
+	}
+
+	files := form.File["file"]
+	if len(files) != 1 {
+		t.Fatalf("expected one file part, got %d", len(files))
+	}
+	opened, err := files[0].Open()
+	if err != nil {
+		t.Fatalf("open file part: %v", err)
+	}
+	t.Cleanup(func() { _ = opened.Close() })
+	content, err := io.ReadAll(opened)
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if string(content) != "payload" {
+		t.Fatalf("unexpected file content: %q", string(content))
+	}
+}
+
+func TestNewFileWithFieldsRepeatedValues(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{"tag": {"a", "b"}}
+
+	contentType, body, err := NewFileWithFields("file", "doc.txt", strings.NewReader("payload"), fields)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	form, err := parseParts(t, contentType, body).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read form: %v", err)
+	}
+	t.Cleanup(func() { _ = form.RemoveAll() })
+
+	if got := form.Value["tag"]; len(got) != 2 || got[0] != "a" || got[1] != "b" {
+		t.Fatalf("unexpected tag values: %#v", got)
+	}
+}
+
+// The encoded body must be replayable so the retry transport can resend an
+// upload after a 429.
+func TestNewFileIsRewindable(t *testing.T) {
+	t.Parallel()
+
+	_, body, err := NewFile("file", "doc.txt", strings.NewReader("payload"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	first, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	if _, err := body.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek: %v", err)
+	}
+	second, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatalf("re-read body: %v", err)
+	}
+	if string(first) != string(second) {
+		t.Fatalf("replayed body differs")
+	}
+}
+
+func TestNewFileValidation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFile("", "doc.txt", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected error for empty field name")
+	}
+	if _, _, err := NewFile("file", "", strings.NewReader("x")); err == nil {
+		t.Fatalf("expected error for empty file name")
+	}
+	if _, _, err := NewFile("file", "doc.txt", nil); err == nil {
+		t.Fatalf("expected error for nil content")
+	}
+}
