+// Upload uploads content as a new file. It encodes content as a
+// multipart/form-data body under the "file" field with the given file name, so
+// callers do not have to build the multipart body themselves as Add requires.
+//
+// content is buffered in memory before sending so that retries (for example on
+// 429 during bulk imports) can safely replay it. The reader is only read, never
+// closed; the caller retains ownership.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...FilesOption) (*File, error) {
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+	cfg := newFilesOptions(opts)
+
+	contentType, body, err := multipartbody.NewFile("file", fileName, content)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", cfg.query, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
+}
+
