+// enableBodyReplay makes an outgoing request body replayable across retries
+// when the caller supplied a seekable reader.
+//
+// http.NewRequestWithContext only wires up GetBody (which the retry transport
+// needs to re-send the body) for its known in-memory reader types:
+// *bytes.Reader, *bytes.Buffer and *strings.Reader. A caller streaming a file
+// with, say, os.Open passes an *os.File, which is seekable but unrecognized,
+// so GetBody stays nil and the retry transport treats the request as
+// non-replayable — a rate-limited (429) upload then fails on the first attempt
+// instead of retrying.
+//
+// For any other seekable reader we record the current offset and install a
+// GetBody that rewinds to it. The body is wrapped in io.NopCloser so the
+// transport's per-attempt Close does not close the caller's reader between
+// attempts; the caller retains ownership and is responsible for closing it.
+// Non-seekable readers cannot be replayed without buffering the whole body in
+// memory, which would be surprising here, so they are left as single-attempt.
+func enableBodyReplay(req *http.Request, body io.Reader) {
+	if req.Body == nil || req.GetBody != nil || body == nil {
+		return
+	}
+	seeker, ok := body.(io.Seeker)
+	if !ok {
+		return
+	}
+	start, err := seeker.Seek(0, io.SeekCurrent)
+	if err != nil {
+		// The reader reports itself as seekable but cannot state its offset;
+		// fall back to a single, non-replayable attempt.
+		return
+	}
+	req.Body = io.NopCloser(body)
+	req.GetBody = func() (io.ReadCloser, error) {
+		if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+			return nil, err
+		}
+		return io.NopCloser(body), nil
+	}
+}
