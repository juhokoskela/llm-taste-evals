+// seekOnlyReader hides the concrete reader type so http.NewRequestWithContext
+// cannot derive GetBody on its own; replay must come from the io.Seeker path.
+type seekOnlyReader struct {
+	*strings.Reader
+}
+
+func TestRawClient_Do_RetriesSeekableBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	var bodies []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		payload, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, string(payload))
+		attempt := len(bodies)
+		mu.Unlock()
+
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	httpClient := NewHTTPClient(Config{
+		BaseURL:     srv.URL,
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &RetryPolicy{MaxAttempts: 2},
+	})
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	// Start the reader at a non-zero offset; replays must resend from the
+	// offset the body had when the request was built, not from zero.
+	underlying := strings.NewReader("XXpayload")
+	if _, err := io.ReadFull(underlying, make([]byte, 2)); err != nil {
+		t.Fatalf("advance reader: %v", err)
+	}
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/upload", nil, seekOnlyReader{underlying}, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok")
+	}
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	for i, body := range bodies {
+		if body != "payload" {
+			t.Fatalf("attempt %d sent body %q, want %q", i+1, body, "payload")
+		}
+	}
+}
+
+func TestRawClient_Do_DoesNotRetryNonSeekableBody(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	var attempts int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		attempts++
+		mu.Unlock()
+		w.WriteHeader(http.StatusTooManyRequests)
+	}))
+	t.Cleanup(srv.Close)
+
+	httpClient := NewHTTPClient(Config{
+		BaseURL:     srv.URL,
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &RetryPolicy{MaxAttempts: 3},
+	})
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	body := struct{ io.Reader }{strings.NewReader("payload")}
+	err = raw.Do(context.Background(), http.MethodPost, "/upload", nil, body, nil)
+	var rle *RateLimitError
+	if !errors.As(err, &rle) {
+		t.Fatalf("expected RateLimitError, got %T (%v)", err, err)
+	}
+	if attempts != 1 {
+		t.Fatalf("expected 1 attempt, got %d", attempts)
+	}
+}
