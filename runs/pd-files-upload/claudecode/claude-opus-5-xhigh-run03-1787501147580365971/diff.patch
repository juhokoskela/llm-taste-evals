+// A reader that cannot be rewound must not be retried: replaying it would
+// send a truncated body. The 429 is surfaced to the caller instead.
+func TestRawClient_Do_DoesNotRetryUnseekableBody(t *testing.T) {
+	t.Parallel()
+
+	var (
+		mu       sync.Mutex
+		attempts int
+	)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		mu.Lock()
+		attempts++
+		mu.Unlock()
+
+		w.Header().Set("Retry-After", "0")
+		w.WriteHeader(http.StatusTooManyRequests)
+		_, _ = w.Write([]byte(`{"success":false,"error":"rate limit exceeded"}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	raw := newRetryingRawClient(t, srv)
+
+	body := io.MultiReader(strings.NewReader("a"), strings.NewReader("b"))
+	err := raw.Do(context.Background(), http.MethodPost, "/files", nil, body, nil)
+
+	var rateLimit *RateLimitError
+	if !errors.As(err, &rateLimit) {
+		t.Fatalf("expected RateLimitError, got %T (%v)", err, err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if attempts != 1 {
+		t.Fatalf("expected 1 attempt, got %d", attempts)
+	}
+}
+
+func newRetryingRawClient(t *testing.T, srv *httptest.Server) *RawClient {
+	t.Helper()
+
+	policy := DefaultRetryPolicy()
+	policy.MaxAttempts = 2
+	policy.BaseDelay = time.Millisecond
+	policy.MaxDelay = time.Millisecond
+	policy.RetryAllMethods = true
+
+	raw, err := NewRawClient(srv.URL, NewHTTPClient(Config{
+		BaseURL:     srv.URL,
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	}))
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+	return raw
+}
+
+// openTempFile returns an *os.File positioned at the start of contents.
+func openTempFile(t *testing.T, contents string) *os.File {
+	t.Helper()
+
+	path := filepath.Join(t.TempDir(), "upload.txt")
+	if err := os.WriteFile(path, []byte(contents), 0o600); err != nil {
+		t.Fatalf("write temp file: %v", err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = f.Close() })
+	return f
+}
