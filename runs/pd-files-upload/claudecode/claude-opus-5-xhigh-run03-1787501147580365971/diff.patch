+// The reported failure: an upload read from os.Open under a rate limit. The
+// multipart body Upload builds is replayable, so the retry policy applies.
+func TestFilesService_Upload_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	var (
+		mu     sync.Mutex
+		bodies [][]byte
+	)
+	client := newTestClientWithConfig(t, retryTwiceConfig(), func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+			return
+		}
+
+		mu.Lock()
+		bodies = append(bodies, body)
+		attempt := len(bodies)
+		mu.Unlock()
+
+		if attempt == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"rate limit exceeded"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"contract.pdf"}}`))
+	})
+
+	file, err := client.Files.Upload(
+		context.Background(),
+		"contract.pdf",
+		openTempFile(t, "contract bytes"),
+		WithFileDealID(DealID(7)),
+	)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(bodies))
+	}
+	if !bytes.Equal(bodies[0], bodies[1]) {
+		t.Fatalf("retry sent a different body:\nfirst:  %q\nsecond: %q", bodies[0], bodies[1])
+	}
+	if !bytes.Contains(bodies[1], []byte("contract bytes")) {
+		t.Fatalf("retry body missing the file contents: %q", bodies[1])
+	}
+}
