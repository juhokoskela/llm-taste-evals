+// multipart/form-data body the API expects. Associate the file with a record
+// using options such as WithFileDealID.
+//
+// The encoded body is buffered in memory, which also makes it replayable, so
+// the client's retry policy covers the upload. Prefer this over Add unless you
+// have a reason to build the multipart body yourself.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...UploadFileOption) (*File, error) {
+	if fileName == "" || content == nil {
+		return nil, fmt.Errorf("file name and content are required")
+	}
+	cfg := newUploadFileOptions(opts)
+
+	contentType, body, err := multipartbody.NewFileWithFields("file", fileName, content, cfg.form)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", cfg.query, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
