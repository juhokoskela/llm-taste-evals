+// enableBodyReplay makes seekable reader bodies (such as *os.File) safe to
+// retry. http.NewRequestWithContext only wires up GetBody for in-memory
+// readers, and without GetBody the retry transport cannot resend the body, so
+// uploads would fail on the first 429/5xx instead of retrying. Each attempt
+// rewinds the reader to the offset it had when Do was called.
+//
+// The reader is deliberately shielded from the transport's Close so it stays
+// usable across attempts; the caller keeps ownership of readers it passes in
+// and is responsible for closing them.
+func enableBodyReplay(req *http.Request, body io.Reader) error {
+	if body == nil || req.GetBody != nil {
+		return nil
+	}
+	seeker, ok := body.(io.Seeker)
+	if !ok {
+		return nil
+	}
+	start, err := seeker.Seek(0, io.SeekCurrent)
+	if err != nil {
+		// Not actually seekable; leave the request as a one-shot body.
+		return nil
+	}
+	if end, err := seeker.Seek(0, io.SeekEnd); err == nil {
+		if end >= start {
+			req.ContentLength = end - start
+		}
+		if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+			return fmt.Errorf("rewind request body: %w", err)
+		}
+	}
+	req.Body = io.NopCloser(body)
+	req.GetBody = func() (io.ReadCloser, error) {
+		if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+			return nil, fmt.Errorf("rewind request body: %w", err)
+		}
+		return io.NopCloser(body), nil
+	}
+	return nil
+}
