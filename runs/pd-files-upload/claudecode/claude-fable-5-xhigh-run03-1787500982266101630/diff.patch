+func TestRawClient_Do_RetriesSeekableBodyOn429(t *testing.T) {
+	t.Parallel()
+
+	const content = "file upload payload"
+
+	var calls int
+	var bodies []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		bodies = append(bodies, string(body))
+		if got := r.ContentLength; got != int64(len(content)) {
+			t.Errorf("attempt %d: unexpected content length: %d", calls, got)
+		}
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	policy := DefaultRetryPolicy()
+	policy.MaxAttempts = 2
+	policy.BaseDelay = time.Millisecond
+	policy.MaxDelay = time.Millisecond
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	f, err := os.Create(filepath.Join(t.TempDir(), "upload.txt"))
+	if err != nil {
+		t.Fatalf("create file: %v", err)
+	}
+	if _, err := f.WriteString(content); err != nil {
+		t.Fatalf("write file: %v", err)
+	}
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek file: %v", err)
+	}
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/files", nil, f, &out); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok")
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 attempts, got %d", calls)
+	}
+	for i, body := range bodies {
+		if body != content {
+			t.Fatalf("attempt %d: unexpected body %q", i+1, body)
+		}
+	}
+	if err := f.Close(); err != nil {
+		t.Fatalf("caller-owned file was closed by the client: %v", err)
+	}
+}
+
