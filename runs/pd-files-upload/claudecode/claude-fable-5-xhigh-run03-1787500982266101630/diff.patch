+)
+
+func TestNewFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "doc.txt", strings.NewReader("hello"))
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	form := parseForm(t, contentType, body)
+	assertFilePart(t, form, "file", "doc.txt", "hello")
+	if len(form.Value) != 0 {
+		t.Fatalf("unexpected form values: %#v", form.Value)
+	}
+}
+
+func TestNewFileWithFields(t *testing.T) {
+	t.Parallel()
+
+	fields := url.Values{}
+	fields.Set("deal_id", "42")
+	fields.Add("tag", "a")
+	fields.Add("tag", "b")
+
+	contentType, body, err := NewFileWithFields("file", "doc.txt", strings.NewReader("hello"), fields)
+	if err != nil {
+		t.Fatalf("NewFileWithFields error: %v", err)
+	}
+
+	form := parseForm(t, contentType, body)
+	assertFilePart(t, form, "file", "doc.txt", "hello")
+	if got := form.Value["deal_id"]; len(got) != 1 || got[0] != "42" {
+		t.Fatalf("unexpected deal_id: %#v", got)
+	}
+	if got := form.Value["tag"]; len(got) != 2 || got[0] != "a" || got[1] != "b" {
+		t.Fatalf("unexpected tag values: %#v", got)
+	}
+}
+
+func TestNewFileWithFields_Validation(t *testing.T) {
+	t.Parallel()
+
+	if _, _, err := NewFileWithFields("", "doc.txt", strings.NewReader("x"), nil); err == nil {
+		t.Fatalf("expected error for missing field name")
+	}
+	if _, _, err := NewFileWithFields("file", "", strings.NewReader("x"), nil); err == nil {
+		t.Fatalf("expected error for missing file name")
+	}
+	if _, _, err := NewFileWithFields("file", "doc.txt", nil, nil); err == nil {
+		t.Fatalf("expected error for missing content")
+	}
+}
+
+func parseForm(t *testing.T, contentType string, body io.Reader) *multipart.Form {
+	t.Helper()
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("unexpected media type: %q", mediaType)
+	}
+	form, err := multipart.NewReader(body, params["boundary"]).ReadForm(1 << 20)
+	if err != nil {
+		t.Fatalf("read form: %v", err)
+	}
+	t.Cleanup(func() { _ = form.RemoveAll() })
+	return form
+}
+
+func assertFilePart(t *testing.T, form *multipart.Form, fieldName, fileName, content string) {
+	t.Helper()
+
+	files := form.File[fieldName]
+	if len(files) != 1 {
+		t.Fatalf("expected 1 file part %q, got %#v", fieldName, form.File)
+	}
+	if files[0].Filename != fileName {
+		t.Fatalf("unexpected file name: %q", files[0].Filename)
+	}
+	part, err := files[0].Open()
+	if err != nil {
+		t.Fatalf("open file part: %v", err)
+	}
+	defer part.Close()
+	data, err := io.ReadAll(part)
+	if err != nil {
+		t.Fatalf("read file part: %v", err)
+	}
+	if string(data) != content {
+		t.Fatalf("unexpected file content: %q", string(data))
+	}
+}
