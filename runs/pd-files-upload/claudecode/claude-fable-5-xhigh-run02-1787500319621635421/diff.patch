+func WithUploadRequestOptions(opts ...pipedrive.RequestOption) UploadFileOption {
+	return uploadFileOptionFunc(func(cfg *uploadFileOptions) {
+		cfg.requestOptions = append(cfg.requestOptions, opts...)
+	})
+}
+
+func uploadFieldOption(key, value string) UploadFileOption {
+	return uploadFileOptionFunc(func(cfg *uploadFileOptions) {
+		if cfg.fields == nil {
+			cfg.fields = url.Values{}
+		}
+		cfg.fields.Set(key, value)
+	})
+}
