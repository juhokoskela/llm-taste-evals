+// Upload adds a file, encoding content as the multipart/form-data body the
+// endpoint expects. Association options such as WithUploadDealID become form
+// fields alongside the file part. The body is buffered in memory, which makes
+// it replayable, so rate-limit and transient-error retries work regardless of
+// what content is. Use Add to supply a fully custom request body instead.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...UploadFileOption) (*File, error) {
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+	cfg := newUploadFileOptions(opts)
+
+	contentType, body, err := multipartbody.NewForm("file", fileName, content, cfg.fields)
+	if err != nil {
+		return nil, err
+	}
+
+	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
+	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
+
+	var payload struct {
+		Data *File `json:"data"`
+	}
+	if err := s.client.Raw.Do(ctx, http.MethodPost, "/files", nil, body, &payload, reqOpts...); err != nil {
+		return nil, err
+	}
+	if payload.Data == nil {
+		return nil, fmt.Errorf("missing file data in response")
+	}
+	return payload.Data, nil
+}
