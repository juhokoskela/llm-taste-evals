+// seekReader is an io.ReadSeeker whose concrete type http.NewRequest does not
+// recognize, so GetBody is not populated by the standard library.
+type seekReader struct {
+	r *strings.Reader
+}
+
+func newSeekReader(s string) *seekReader {
+	return &seekReader{r: strings.NewReader(s)}
+}
+
+func (s *seekReader) Read(p []byte) (int, error) {
+	return s.r.Read(p)
+}
+
+func (s *seekReader) Seek(offset int64, whence int) (int64, error) {
+	return s.r.Seek(offset, whence)
+}
