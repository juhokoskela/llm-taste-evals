+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if ct := r.Header.Get("Content-Type"); !strings.HasPrefix(ct, "multipart/form-data;") {
+			t.Fatalf("unexpected content type: %q", ct)
+		}
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Fatalf("parse multipart: %v", err)
+		}
+		part, header, err := r.FormFile("file")
+		if err != nil {
+			t.Fatalf("form file: %v", err)
+		}
+		defer part.Close()
+		if header.Filename != "contract.pdf" {
+			t.Fatalf("unexpected filename: %q", header.Filename)
+		}
+		contents, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read file part: %v", err)
+		}
+		if string(contents) != "hello world" {
+			t.Fatalf("unexpected file contents: %q", string(contents))
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"contract.pdf"}}`))
+	})
+
+	file, err := client.Files.Upload(
+		context.Background(),
+		"contract.pdf",
+		strings.NewReader("hello world"),
+	)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "contract.pdf" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
