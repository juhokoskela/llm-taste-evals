+// Add with a non-replayable stream (as documented) cannot be retried: the body
+// is consumed on the first 429 and the request fails instead of retrying.
+func TestFilesService_Add_NonReplayableBodyDoesNotRetry(t *testing.T) {
+	t.Parallel()
+
+	var attempts atomic.Int32
+	cfg := pipedrive.Config{RetryPolicy: &pipedrive.RetryPolicy{
+		MaxAttempts: 3,
+		BaseDelay:   time.Millisecond,
+		MaxDelay:    time.Millisecond,
+		Jitter:      func(d time.Duration) time.Duration { return d },
+	}}
+	client := newTestClientWithConfig(t, cfg, func(w http.ResponseWriter, r *http.Request) {
+		attempts.Add(1)
+		w.WriteHeader(http.StatusTooManyRequests)
+		_, _ = w.Write([]byte(`{"success":false}`))
+	})
+
+	// io.NopCloser wraps the reader in a type net/http cannot rewind, so no
+	// GetBody is synthesized.
+	body := io.NopCloser(strings.NewReader("file"))
+	_, err := client.Files.Add(context.Background(), body, "multipart/form-data; boundary=test")
+	var rateLimit *pipedrive.RateLimitError
+	if !errors.As(err, &rateLimit) {
+		t.Fatalf("expected RateLimitError, got %T (%v)", err, err)
+	}
+	if got := attempts.Load(); got != 1 {
+		t.Fatalf("expected exactly 1 attempt (no retry), got %d", got)
+	}
+}
