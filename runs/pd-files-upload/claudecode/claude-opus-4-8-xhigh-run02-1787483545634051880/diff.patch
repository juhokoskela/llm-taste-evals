+// Upload buffers the upload into a *bytes.Reader, so unlike Add with a raw
+// stream the request carries a GetBody and is replayed on 429. The handler
+// verifies the file contents survive the retry.
+func TestFilesService_Upload_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	var attempts atomic.Int32
+	cfg := pipedrive.Config{RetryPolicy: &pipedrive.RetryPolicy{
+		MaxAttempts: 3,
+		BaseDelay:   time.Millisecond,
+		MaxDelay:    time.Millisecond,
+		Jitter:      func(d time.Duration) time.Duration { return d },
+	}}
+	client := newTestClientWithConfig(t, cfg, func(w http.ResponseWriter, r *http.Request) {
+		n := attempts.Add(1)
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Errorf("attempt %d: parse multipart: %v", n, err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		part, _, err := r.FormFile("file")
+		if err != nil {
+			t.Errorf("attempt %d: form file: %v", n, err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		defer part.Close()
+		contents, _ := io.ReadAll(part)
+		if string(contents) != "retry me" {
+			t.Errorf("attempt %d: unexpected file contents: %q", n, string(contents))
+		}
+		if n == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":99,"name":"doc"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "doc", strings.NewReader("retry me"))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 99 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if got := attempts.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+}
