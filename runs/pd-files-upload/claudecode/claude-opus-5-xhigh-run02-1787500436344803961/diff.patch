+func TestFilesService_Upload_RetriesRateLimitedUpload(t *testing.T) {
+	t.Parallel()
+
+	var mu sync.Mutex
+	var uploads []string
+
+	policy := pipedrive.DefaultRetryPolicy()
+	policy.MaxAttempts = 2
+	policy.BaseDelay = 0
+
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Errorf("parse multipart form: %v", err)
+			return
+		}
+		part, header, err := r.FormFile("file")
+		if err != nil {
+			t.Errorf("form file: %v", err)
+			return
+		}
+		defer part.Close()
+		content, err := io.ReadAll(part)
+		if err != nil {
+			t.Errorf("read file part: %v", err)
+			return
+		}
+
+		mu.Lock()
+		uploads = append(uploads, header.Filename+":"+string(content))
+		attempt := len(uploads)
+		mu.Unlock()
+
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"message":"rate limited"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":16,"name":"report.csv"}}`))
+	})
+
+	file, err := client.Files.Upload(context.Background(), "report.csv", openTestFile(t, "a,b,c"))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 16 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(uploads) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(uploads))
+	}
+	for i, upload := range uploads {
+		if upload != "report.csv:a,b,c" {
+			t.Fatalf("attempt %d sent %q", i+1, upload)
+		}
+	}
+}
