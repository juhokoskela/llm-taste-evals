+func TestFilesService_Upload_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	var calls atomic.Int32
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     3,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		n := calls.Add(1)
+		if n == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":99,"name":"retried.txt"}}`))
+	})
+
+	// Use a non-seekable reader to prove the SDK buffers internally.
+	r := io.NopCloser(strings.NewReader("data"))
+	file, err := client.Files.Upload(context.Background(), "retried.txt", r)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 99 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("expected 2 server calls (1 retry), got %d", got)
+	}
+}
