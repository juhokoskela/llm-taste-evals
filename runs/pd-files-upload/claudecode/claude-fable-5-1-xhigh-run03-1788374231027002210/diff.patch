+func TestRawClient_Do_MakesReaderBodyReplayableForRetries(t *testing.T) {
+	t.Parallel()
+
+	var (
+		calls  atomic.Int32
+		mu     sync.Mutex
+		bodies []string
+		length []int64
+	)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, string(data))
+		length = append(length, r.ContentLength)
+		mu.Unlock()
+
+		if calls.Add(1) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	httpClient := NewHTTPClient(Config{
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &RetryPolicy{MaxAttempts: 3},
+	})
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	// io.NopCloser hides the underlying *strings.Reader, so net/http cannot
+	// derive GetBody on its own: this body is not replayable by default.
+	body := io.NopCloser(strings.NewReader("payload"))
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	if err := raw.Do(context.Background(), http.MethodPost, "/upload", nil, body, &out, WithHeader("Content-Type", "application/octet-stream")); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok=true")
+	}
+
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) != 2 || bodies[0] != "payload" || bodies[1] != "payload" {
+		t.Fatalf("expected both attempts to carry the full body, got %q", bodies)
+	}
+	for i, l := range length {
+		if l != int64(len("payload")) {
+			t.Fatalf("attempt %d: expected Content-Length %d, got %d", i+1, len("payload"), l)
+		}
+	}
+}
+
+type closeRecorder struct {
+	io.Reader
+	closed atomic.Bool
+}
+
+func (c *closeRecorder) Close() error {
+	c.closed.Store(true)
+	return nil
+}
+
+func TestRawClient_Do_ClosesCallerReadCloser(t *testing.T) {
+	t.Parallel()
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(srv.Close)
+
+	raw, err := NewRawClient(srv.URL, srv.Client())
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	body := &closeRecorder{Reader: strings.NewReader("payload")}
+	if err := raw.Do(context.Background(), http.MethodPost, "/upload", nil, body, nil); err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !body.closed.Load() {
+		t.Fatalf("expected caller-supplied ReadCloser to be closed")
+	}
+}
+
+func TestRawClient_Do_ReturnsReaderBodyError(t *testing.T) {
