+func TestFilesService_Add_RetriesRateLimitWithFileBody(t *testing.T) {
+	t.Parallel()
+
+	const content = "raw multipart body"
+	var (
+		calls  atomic.Int32
+		mu     sync.Mutex
+		bodies []string
+	)
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{MaxAttempts: 3, RetryAllMethods: true},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/files" {
+			t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
+		}
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, string(data))
+		mu.Unlock()
+
+		if calls.Add(1) == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.bin"}}`))
+	})
+
+	// *os.File is the body type from the bug report: net/http cannot derive
+	// GetBody for it, so without SDK help the retry transport gives up on 429.
+	f := writeTempFile(t, content)
+	file, err := client.Files.Add(context.Background(), f, "multipart/form-data; boundary=test")
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) != 2 || bodies[0] != content || bodies[1] != content {
+		t.Fatalf("expected both attempts to carry the full body, got %q", bodies)
+	}
+}
