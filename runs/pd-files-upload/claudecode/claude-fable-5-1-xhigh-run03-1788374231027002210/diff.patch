+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	const content = "pdf-bytes"
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.Header.Get("X-Test"); got != "upload" {
+			t.Fatalf("unexpected header X-Test: %q", got)
+		}
+		if ct := r.Header.Get("Content-Type"); !strings.HasPrefix(ct, "multipart/form-data;") {
+			t.Fatalf("unexpected content type: %q", ct)
+		}
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Fatalf("parse multipart form: %v", err)
+		}
+
+		want := map[string]string{
+			"deal_id":     "42",
+			"person_id":   "7",
+			"org_id":      "8",
+			"product_id":  "9",
+			"activity_id": "10",
+			"lead_id":     "adf21080-0e10-11eb-879b-05d71fb426ec",
+			"project_id":  "11",
+		}
+		for key, value := range want {
+			if got := r.FormValue(key); got != value {
+				t.Fatalf("unexpected %s: %q", key, got)
+			}
+		}
+		if len(r.MultipartForm.Value) != len(want) {
+			t.Fatalf("unexpected form fields: %#v", r.MultipartForm.Value)
+		}
+
+		part, header, err := r.FormFile("file")
+		if err != nil {
+			t.Fatalf("form file: %v", err)
+		}
+		defer part.Close()
+		if header.Filename != "contract.pdf" {
+			t.Fatalf("unexpected file name: %q", header.Filename)
+		}
+		data, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatalf("read file part: %v", err)
+		}
+		if string(data) != content {
+			t.Fatalf("unexpected file content: %q", data)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"contract.pdf","file_name":"contract.pdf","deal_id":42}}`))
+	})
+
+	file, err := client.Files.Upload(
+		context.Background(),
+		"contract.pdf",
+		strings.NewReader(content),
+		WithFileDealID(DealID(42)),
+		WithFilePersonID(PersonID(7)),
+		WithFileOrganizationID(OrganizationID(8)),
+		WithFileProductID(ProductID(9)),
+		WithFileActivityID(ActivityID(10)),
+		WithFileLeadID(LeadID("adf21080-0e10-11eb-879b-05d71fb426ec")),
+		WithFileProjectID(ProjectID(11)),
+		WithFilesRequestOptions(pipedrive.WithHeader("X-Test", "upload")),
+	)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.Name != "contract.pdf" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if file.DealID == nil || *file.DealID != 42 {
+		t.Fatalf("unexpected deal id: %#v", file.DealID)
+	}
+}
