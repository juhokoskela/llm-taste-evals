+// ensureReplayableBody guarantees the request can be sent more than once,
+// which the retry transport requires before it retries a 429/5xx response
+// (and net/http requires to follow a 307/308 redirect with a body).
+//
+// http.NewRequest derives GetBody only for *bytes.Buffer, *bytes.Reader and
+// *strings.Reader. Any other body, such as an *os.File, a pipe, or an
+// io.NopCloser wrapper, is buffered into memory here so every attempt sends
+// the same bytes with an explicit Content-Length. The caller's body is
+// closed once consumed, as http.Client would otherwise have done.
+func ensureReplayableBody(req *http.Request) error {
+	if req.Body == nil || req.Body == http.NoBody || req.GetBody != nil {
+		return nil
+	}
+
+	buf, readErr := io.ReadAll(req.Body)
+	closeErr := req.Body.Close()
+	if readErr != nil {
+		return fmt.Errorf("read request body: %w", readErr)
+	}
+	if closeErr != nil {
+		return fmt.Errorf("close request body: %w", closeErr)
+	}
+
+	if len(buf) == 0 {
+		req.Body = http.NoBody
+		req.ContentLength = 0
+		req.GetBody = func() (io.ReadCloser, error) { return http.NoBody, nil }
+		return nil
+	}
+
+	req.Body = io.NopCloser(bytes.NewReader(buf))
+	req.ContentLength = int64(len(buf))
+	req.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(buf)), nil
+	}
+	return nil
+}
