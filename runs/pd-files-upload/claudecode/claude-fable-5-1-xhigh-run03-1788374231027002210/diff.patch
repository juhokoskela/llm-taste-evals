+func TestFilesService_Upload_RetriesRateLimitWithFileBody(t *testing.T) {
+	t.Parallel()
+
+	const content = "pdf-bytes"
+	var (
+		calls atomic.Int32
+		mu    sync.Mutex
+		seen  []string
+	)
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{MaxAttempts: 3, RetryAllMethods: true},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Errorf("parse multipart form: %v", err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		part, header, err := r.FormFile("file")
+		if err != nil {
+			t.Errorf("form file: %v", err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		defer part.Close()
+		data, _ := io.ReadAll(part)
+		mu.Lock()
+		seen = append(seen, header.Filename+":"+string(data)+":"+r.FormValue("deal_id"))
+		mu.Unlock()
+
+		if calls.Add(1) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":14,"name":"contract.pdf"}}`))
+	})
+
+	f := writeTempFile(t, content)
+	file, err := client.Files.Upload(context.Background(), "contract.pdf", f, WithFileDealID(DealID(42)))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 14 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	want := "contract.pdf:" + content + ":42"
+	if len(seen) != 2 || seen[0] != want || seen[1] != want {
+		t.Fatalf("expected both attempts to carry the same multipart body, got %q", seen)
