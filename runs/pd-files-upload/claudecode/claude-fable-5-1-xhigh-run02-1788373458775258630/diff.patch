+// replayableBody returns a request body the retry transport can resend.
+//
+// net/http derives Request.GetBody only for *bytes.Buffer, *bytes.Reader and
+// *strings.Reader. Any other reader — an *os.File, a pipe, an io.NopCloser
+// wrapper — leaves GetBody nil, so the first 429 or 5xx would be returned to
+// the caller instead of retried, and the body would be sent chunked. Such
+// readers are drained into memory once, giving every attempt identical bytes
+// and an explicit Content-Length. When the reader is an io.Closer it is
+// closed after draining, matching what net/http does with request bodies.
+func replayableBody(body io.Reader) (io.Reader, error) {
+	switch body.(type) {
+	case *bytes.Buffer, *bytes.Reader, *strings.Reader:
+		return body, nil
+	}
+	if body == http.NoBody {
+		return body, nil
+	}
+
+	data, err := io.ReadAll(body)
+	if closer, ok := body.(io.Closer); ok {
+		_ = closer.Close()
+	}
+	if err != nil {
+		return nil, fmt.Errorf("read request body: %w", err)
+	}
+	return bytes.NewReader(data), nil
+}
