+	}
+}
+
+func TestRawClient_Do_ReturnsBodyReadError(t *testing.T) {
+	t.Parallel()
+
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(srv.Close)
+
+	raw, err := NewRawClient(srv.URL, srv.Client())
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	boom := errors.New("boom")
+	err = raw.Do(context.Background(), http.MethodPost, "/x", nil, &failingReader{err: boom}, nil)
+	if !errors.Is(err, boom) {
+		t.Fatalf("expected %v, got %v", boom, err)
+	}
