+// fileName is sent verbatim as the multipart file name. Pass a base name such
+// as filepath.Base(path) unless directory components should be preserved.
+func (s *FilesService) Upload(ctx context.Context, fileName string, content io.Reader, opts ...UploadFileOption) (*File, error) {
+	if fileName == "" {
+		return nil, fmt.Errorf("file name is required")
+	}
+	if content == nil {
+		return nil, fmt.Errorf("file content is required")
+	}
+	cfg := newUploadFileOptions(opts)
+	fields, err := cfg.payload.fields()
+	if err != nil {
+		return nil, err
+	}
+
+	contentType, body, err := multipartbody.NewFile("file", fileName, content, fields...)
+	if err != nil {
+		return nil, err
+	}
+	return s.add(ctx, body, contentType, cfg.filesOptions)
+}
 
+func (s *FilesService) add(ctx context.Context, body io.Reader, contentType string, cfg filesOptions) (*File, error) {
 	reqOpts := append([]pipedrive.RequestOption{}, cfg.requestOptions...)
 	reqOpts = append(reqOpts, pipedrive.WithHeader("Content-Type", contentType))
 
