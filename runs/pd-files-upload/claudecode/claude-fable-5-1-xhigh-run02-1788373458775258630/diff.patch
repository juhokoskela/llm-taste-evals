+func TestFilesService_Add_RetriesRateLimitedFileUpload(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("%PDF-1.7 signed contract")
+	path := filepath.Join(t.TempDir(), "contract.pdf")
+	if err := os.WriteFile(path, content, 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+
+	var attempts atomic.Int32
+	var mu sync.Mutex
+	var received [][]byte
+	policy := pipedrive.RetryPolicy{MaxAttempts: 3, RetryAllMethods: true}
+	client := newTestClientWithConfig(t, pipedrive.Config{RetryPolicy: &policy}, func(w http.ResponseWriter, r *http.Request) {
+		attempt := attempts.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("attempt %d: read body: %v", attempt, err)
+		}
+		mu.Lock()
+		received = append(received, body)
+		mu.Unlock()
+
+		w.Header().Set("Content-Type", "application/json")
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"success":false,"error":"Too many requests"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"contract.pdf"}}`))
+	})
+
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatalf("open fixture: %v", err)
+	}
+	defer f.Close()
+
+	file, err := client.Files.Add(context.Background(), f, "application/pdf")
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if got := attempts.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	for i, body := range received {
+		if !bytes.Equal(body, content) {
+			t.Fatalf("attempt %d: body = %q, want %q", i+1, body, content)
+		}
+	}
