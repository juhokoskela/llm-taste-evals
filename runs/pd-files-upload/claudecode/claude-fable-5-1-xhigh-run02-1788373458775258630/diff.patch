+		{name: "person_id", value: "7"},
+		{name: "file", fileName: "contract.pdf", value: "payload"},
+	}
+	if len(parts) != len(want) {
+		t.Fatalf("parts = %#v, want %#v", parts, want)
+	}
+	for i := range want {
+		if parts[i] != want[i] {
+			t.Fatalf("part %d = %#v, want %#v", i, parts[i], want[i])
+		}
+	}
