+func TestFilesService_Upload_RejectsInvalidInput(t *testing.T) {
+	t.Parallel()
+
+	client := newTestClient(t, func(http.ResponseWriter, *http.Request) {
+		t.Fatal("unexpected request")
+	})
+
+	cases := []struct {
+		name     string
+		fileName string
+		content  io.Reader
+		opts     []UploadFileOption
+		want     string
+	}{
+		{name: "missing file name", content: strings.NewReader("x"), want: "file name is required"},
+		{name: "missing content", fileName: "a.txt", want: "file content is required"},
+		{name: "invalid deal id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFileDealID(0)}, want: "invalid deal id"},
+		{name: "invalid person id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFilePersonID(-1)}, want: "invalid person id"},
+		{name: "invalid organization id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFileOrganizationID(0)}, want: "invalid organization id"},
+		{name: "invalid product id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFileProductID(0)}, want: "invalid product id"},
+		{name: "invalid activity id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFileActivityID(0)}, want: "invalid activity id"},
+		{name: "invalid lead id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFileLeadID("not-a-uuid")}, want: "lead id"},
+		{name: "invalid project id", fileName: "a.txt", content: strings.NewReader("x"), opts: []UploadFileOption{WithUploadFileProjectID(0)}, want: "invalid project id"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			_, err := client.Files.Upload(context.Background(), tc.fileName, tc.content, tc.opts...)
+			if err == nil || !strings.Contains(err.Error(), tc.want) {
+				t.Fatalf("expected error containing %q, got %v", tc.want, err)
+			}
+		})
+	}
+}
