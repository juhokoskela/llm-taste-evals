+func TestRawClient_Do_BuffersUnreplayableBodyForRetry(t *testing.T) {
+	t.Parallel()
+
+	const payload = "binary file contents"
+
+	var attempts atomic.Int32
+	bodies := make(chan string, 2)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		attempt := attempts.Add(1)
+		got, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("attempt %d: read body: %v", attempt, err)
+		}
+		if r.ContentLength != int64(len(payload)) {
+			t.Errorf("attempt %d: content length = %d, want %d", attempt, r.ContentLength, len(payload))
+		}
+		bodies <- string(got)
+
+		if attempt == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte(`{"error":"rate limit"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	policy := RetryPolicy{MaxAttempts: 2}
+	httpClient := NewHTTPClient(Config{BaseURL: srv.URL, HTTPClient: srv.Client(), RetryPolicy: &policy})
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
+	// io.NopCloser hides the underlying *strings.Reader, so net/http cannot
+	// derive GetBody for it. An *os.File body is in the same situation.
+	body := io.NopCloser(strings.NewReader(payload))
+
+	var out struct {
+		Ok bool `json:"ok"`
+	}
+	err = raw.Do(context.Background(), http.MethodPost, "/files", nil, body, &out, WithHeader("Content-Type", "application/octet-stream"))
+	if err != nil {
+		t.Fatalf("Do error: %v", err)
+	}
+	if !out.Ok {
+		t.Fatalf("expected ok=true")
+	}
+	if got := attempts.Load(); got != 2 {
+		t.Fatalf("expected 2 attempts, got %d", got)
+	}
+	for attempt := 1; attempt <= 2; attempt++ {
+		if got := <-bodies; got != payload {
+			t.Fatalf("attempt %d: body = %q, want %q", attempt, got, payload)
+		}
+	}
+}
+
+func TestRawClient_Do_ClosesBufferedBody(t *testing.T) {
+	t.Parallel()
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(srv.Close)
+
+	raw, err := NewRawClient(srv.URL, srv.Client())
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+
