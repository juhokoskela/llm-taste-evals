+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("%PDF-1.7 signed contract")
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.URL.Query().Get("extra"); got != "1" {
+			t.Fatalf("unexpected extra query: %q", got)
+		}
+		if got := r.Header.Get("X-Test"); got != "upload" {
+			t.Fatalf("unexpected header X-Test: %q", got)
+		}
+		if r.ContentLength <= 0 {
+			t.Fatalf("expected an explicit content length, got %d", r.ContentLength)
+		}
+
+		mediaType, params, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+		if err != nil {
+			t.Fatalf("parse content type: %v", err)
+		}
+		if mediaType != "multipart/form-data" {
+			t.Fatalf("unexpected media type: %s", mediaType)
+		}
+		form, err := multipart.NewReader(r.Body, params["boundary"]).ReadForm(1 << 20)
+		if err != nil {
+			t.Fatalf("read form: %v", err)
+		}
+		defer form.RemoveAll()
+
+		wantFields := map[string]string{
+			"deal_id":     "123",
+			"person_id":   "45",
+			"org_id":      "67",
+			"product_id":  "89",
+			"activity_id": "10",
+			"lead_id":     "adf21080-0e10-11eb-879b-46d8c8d3d3e3",
+			"project_id":  "11",
+		}
+		if len(form.Value) != len(wantFields) {
+			t.Fatalf("unexpected form fields: %#v", form.Value)
+		}
+		for name, want := range wantFields {
+			if got := form.Value[name]; len(got) != 1 || got[0] != want {
+				t.Fatalf("field %s = %v, want %q", name, got, want)
+			}
+		}
+
+		files := form.File["file"]
+		if len(files) != 1 {
+			t.Fatalf("expected one file part, got %d", len(files))
+		}
+		if files[0].Filename != "contract.pdf" {
+			t.Fatalf("unexpected file name: %q", files[0].Filename)
+		}
+		fh, err := files[0].Open()
+		if err != nil {
+			t.Fatalf("open file part: %v", err)
+		}
+		defer fh.Close()
+		got, err := io.ReadAll(fh)
+		if err != nil {
+			t.Fatalf("read file part: %v", err)
+		}
+		if !bytes.Equal(got, content) {
+			t.Fatalf("unexpected file content: %q", got)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"contract.pdf","file_name":"contract.pdf","deal_id":123}}`))
+	})
+
+	file, err := client.Files.Upload(
+		context.Background(),
+		"contract.pdf",
+		bytes.NewReader(content),
+		nil,
+		WithUploadFileDealID(DealID(123)),
+		WithUploadFilePersonID(PersonID(45)),
+		WithUploadFileOrganizationID(OrganizationID(67)),
+		WithUploadFileProductID(ProductID(89)),
+		WithUploadFileActivityID(ActivityID(10)),
+		WithUploadFileLeadID(LeadID("adf21080-0e10-11eb-879b-46d8c8d3d3e3")),
+		WithUploadFileProjectID(ProjectID(11)),
+		WithFilesQuery(url.Values{"extra": []string{"1"}}),
+		WithFilesRequestOptions(pipedrive.WithHeader("X-Test", "upload")),
+	)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 || file.FileName != "contract.pdf" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if file.DealID == nil || *file.DealID != 123 {
+		t.Fatalf("unexpected deal id: %#v", file.DealID)
+	}
+}
