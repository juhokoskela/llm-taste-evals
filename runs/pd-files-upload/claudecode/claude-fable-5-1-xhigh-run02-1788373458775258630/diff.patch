+func TestNewFile_WritesFieldsBeforeFile(t *testing.T) {
+	t.Parallel()
+
+	contentType, body, err := NewFile("file", "contract.pdf", strings.NewReader("payload"),
+		Field{Name: "deal_id", Value: "42"},
+		Field{Name: "person_id", Value: "7"},
+	)
+	if err != nil {
+		t.Fatalf("NewFile error: %v", err)
+	}
+
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		t.Fatalf("parse content type: %v", err)
+	}
+	if mediaType != "multipart/form-data" {
+		t.Fatalf("media type = %q, want multipart/form-data", mediaType)
+	}
+
+	type part struct {
+		name, fileName, value string
+	}
+	var parts []part
+	reader := multipart.NewReader(body, params["boundary"])
+	for {
+		p, err := reader.NextPart()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			t.Fatalf("next part: %v", err)
+		}
+		value, err := io.ReadAll(p)
+		if err != nil {
+			t.Fatalf("read part: %v", err)
+		}
+		parts = append(parts, part{name: p.FormName(), fileName: p.FileName(), value: string(value)})
+	}
