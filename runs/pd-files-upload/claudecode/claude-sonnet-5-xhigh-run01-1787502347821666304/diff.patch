+func TestFilesService_Upload_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	var calls int32
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts: 3,
+			BaseDelay:   time.Millisecond,
+			MaxDelay:    time.Millisecond,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		if atomic.AddInt32(&calls, 1) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":12,"name":"upload.txt"}}`))
+	})
+
+	// Wrap the reader so its concrete type is hidden behind io.Reader, the
+	// same way an *os.File passed in by a caller would look to the
+	// transport: not one of the types (*bytes.Buffer, *bytes.Reader,
+	// *strings.Reader) that net/http can auto-replay.
+	content := struct{ io.Reader }{strings.NewReader("file")}
+
+	file, err := client.Files.Upload(context.Background(), "upload.txt", content)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 12 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if got := atomic.LoadInt32(&calls); got != 2 {
+		t.Fatalf("expected 2 calls (1 rate limited + 1 retry), got %d", got)
+	}
+}
