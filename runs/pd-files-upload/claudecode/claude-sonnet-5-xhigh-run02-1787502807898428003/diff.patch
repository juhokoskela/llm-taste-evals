+func TestFilesService_AddFile_RetriesOn429(t *testing.T) {
+	t.Parallel()
+
+	var calls int
+	var contents []string
+	client := newTestClientWithConfig(t, pipedrive.Config{
+		RetryPolicy: &pipedrive.RetryPolicy{
+			MaxAttempts:     2,
+			BaseDelay:       time.Millisecond,
+			MaxDelay:        time.Millisecond,
+			RetryAllMethods: true,
+		},
+	}, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Fatalf("parse multipart form: %v", err)
+		}
+		f, _, err := r.FormFile("file")
+		if err != nil {
+			t.Fatalf("form file: %v", err)
+		}
+		defer f.Close()
+		content, err := io.ReadAll(f)
+		if err != nil {
+			t.Fatalf("read form file: %v", err)
+		}
+		contents = append(contents, string(content))
+
+		if calls == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":22,"name":"retry.txt"}}`))
+	})
+
+	file, err := client.Files.AddFile(context.Background(), "retry.txt", strings.NewReader("retry me"))
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if file.ID != 22 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if calls != 2 {
+		t.Fatalf("expected 2 calls, got %d", calls)
+	}
+	if len(contents) != 2 || contents[0] != "retry me" || contents[1] != "retry me" {
+		t.Fatalf("unexpected contents across attempts: %#v", contents)
+	}
+}
