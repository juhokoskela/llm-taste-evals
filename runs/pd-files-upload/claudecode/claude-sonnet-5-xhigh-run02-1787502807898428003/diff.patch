+func TestFilesService_AddFile(t *testing.T) {
+	t.Parallel()
+
+	var gotFields map[string]string
+	var gotFileContent []byte
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Fatalf("parse multipart form: %v", err)
+		}
+		gotFields = map[string]string{}
+		for key, values := range r.MultipartForm.Value {
+			if len(values) > 0 {
+				gotFields[key] = values[0]
+			}
+		}
+		f, _, err := r.FormFile("file")
+		if err != nil {
+			t.Fatalf("form file: %v", err)
+		}
+		defer f.Close()
+		gotFileContent, err = io.ReadAll(f)
+		if err != nil {
+			t.Fatalf("read form file: %v", err)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":21,"name":"upload.txt"}}`))
+	})
+
+	file, err := client.Files.AddFile(
+		context.Background(),
+		"upload.txt",
+		strings.NewReader("file content"),
+		WithFileDealID(DealID(7)),
+		WithFilePersonID(PersonID(9)),
+	)
+	if err != nil {
+		t.Fatalf("AddFile error: %v", err)
+	}
+	if file.ID != 21 || file.Name != "upload.txt" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if string(gotFileContent) != "file content" {
+		t.Fatalf("unexpected file content: %q", string(gotFileContent))
+	}
+	if gotFields["deal_id"] != "7" || gotFields["person_id"] != "9" {
+		t.Fatalf("unexpected fields: %#v", gotFields)
+	}
+}
