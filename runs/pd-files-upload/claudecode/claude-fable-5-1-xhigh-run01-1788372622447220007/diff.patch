+// replayableBody makes a request body that implements io.ReaderAt and
+// io.Seeker replayable, mirroring what http.NewRequest does for
+// *bytes.Reader, *bytes.Buffer and *strings.Reader. Without a GetBody the
+// retry transport cannot resend the body and gives up on the first 429 or
+// 5xx, which is how uploads from an *os.File used to fail.
+//
+// Every attempt reads through its own io.SectionReader over the same
+// io.ReaderAt, rather than seeking a shared reader back to the start. When a
+// server answers 429 before the whole body has been written, net/http may
+// still be draining the previous attempt while the retry starts; independent
+// readers keep that late writer from corrupting the retried body.
+//
+// The transport only ever sees the section readers, so the original body is
+// no longer closed by net/http. The returned io.Closer, when non-nil, is the
+// original body and must be closed by the caller once the request finishes.
+// It returns nil when the request already has a GetBody or the body cannot be
+// positioned, leaving the request untouched.
+func replayableBody(req *http.Request, body io.Reader) io.Closer {
+	if req.GetBody != nil || body == nil {
+		return nil
+	}
+	readerAt, ok := body.(io.ReaderAt)
+	if !ok {
+		return nil
+	}
+	seeker, ok := body.(io.Seeker)
+	if !ok {
+		return nil
+	}
+
+	start, err := seeker.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return nil
+	}
+	end, err := seeker.Seek(0, io.SeekEnd)
+	if err != nil {
+		return nil
+	}
+	if _, err := seeker.Seek(start, io.SeekStart); err != nil {
+		return nil
+	}
+
+	size := end - start
+	if size < 0 {
+		size = 0
+	}
+	newBody := func() io.ReadCloser {
+		if size == 0 {
+			return http.NoBody
+		}
+		return io.NopCloser(io.NewSectionReader(readerAt, start, size))
+	}
+
+	req.Body = newBody()
+	req.ContentLength = size
+	req.GetBody = func() (io.ReadCloser, error) {
+		return newBody(), nil
+	}
+
+	closer, _ := body.(io.Closer)
+	return closer
+}
