+func TestReplayableBody_IndependentReadersFromCurrentOffset(t *testing.T) {
+	t.Parallel()
+
+	body := io.NewSectionReader(strings.NewReader("abcdef"), 0, 6)
+	if _, err := body.Seek(2, io.SeekStart); err != nil {
+		t.Fatalf("seek: %v", err)
+	}
+	req, err := http.NewRequest(http.MethodPost, "https://example.test", body)
+	if err != nil {
+		t.Fatalf("NewRequest error: %v", err)
+	}
+	if req.GetBody != nil {
+		t.Fatalf("precondition: net/http should not know how to replay an io.SectionReader")
+	}
+
+	if closer := replayableBody(req, body); closer != nil {
+		t.Fatalf("expected no closer for a body without Close, got %T", closer)
+	}
+	if req.ContentLength != 4 {
+		t.Fatalf("expected Content-Length 4, got %d", req.ContentLength)
+	}
+
+	// A replay reader obtained before the first body is consumed must not
+	// observe reads made through the first body, and vice versa.
+	replay, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	head := make([]byte, 2)
+	if _, err := io.ReadFull(req.Body, head); err != nil {
+		t.Fatalf("read body: %v", err)
+	}
+	replayed, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatalf("read replay: %v", err)
+	}
+	rest, err := io.ReadAll(req.Body)
+	if err != nil {
+		t.Fatalf("read rest of body: %v", err)
+	}
+	if string(head)+string(rest) != "cdef" {
+		t.Fatalf("unexpected first body %q", string(head)+string(rest))
+	}
+	if string(replayed) != "cdef" {
+		t.Fatalf("unexpected replayed body %q", replayed)
+	}
+}
