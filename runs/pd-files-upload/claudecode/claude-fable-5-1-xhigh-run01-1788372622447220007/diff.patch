+func TestFilesService_Upload(t *testing.T) {
+	t.Parallel()
+
+	content := []byte("%PDF-1.7 contract")
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Fatalf("unexpected method: %s", r.Method)
+		}
+		if r.URL.Path != "/files" {
+			t.Fatalf("unexpected path: %s", r.URL.Path)
+		}
+		if got := r.Header.Get("X-Test"); got != "upload" {
+			t.Fatalf("unexpected header X-Test: %q", got)
+		}
+		if ct := r.Header.Get("Content-Type"); !strings.HasPrefix(ct, "multipart/form-data;") {
+			t.Fatalf("unexpected content type: %q", ct)
+		}
+		if r.ContentLength <= 0 {
+			t.Fatalf("expected Content-Length to be set, got %d", r.ContentLength)
+		}
+
+		reader, err := r.MultipartReader()
+		if err != nil {
+			t.Fatalf("multipart reader: %v", err)
+		}
+		fields := url.Values{}
+		var fileName, filePayload string
+		for {
+			part, err := reader.NextPart()
+			if err == io.EOF {
+				break
+			}
+			if err != nil {
+				t.Fatalf("multipart part: %v", err)
+			}
+			data, err := io.ReadAll(part)
+			if err != nil {
+				t.Fatalf("read part: %v", err)
+			}
+			if part.FileName() != "" {
+				if part.FormName() != "file" {
+					t.Fatalf("unexpected file field name: %q", part.FormName())
+				}
+				fileName = part.FileName()
+				filePayload = string(data)
+				continue
+			}
+			fields.Add(part.FormName(), string(data))
+		}
+		if fileName != "contract.pdf" {
+			t.Fatalf("unexpected file name: %q", fileName)
+		}
+		if filePayload != string(content) {
+			t.Fatalf("unexpected file payload: %q", filePayload)
+		}
+		want := url.Values{
+			"deal_id":     {"7"},
+			"person_id":   {"8"},
+			"org_id":      {"9"},
+			"product_id":  {"10"},
+			"activity_id": {"11"},
+			"lead_id":     {"adf21080-0e10-11eb-879b-46d8c8b5bdb9"},
+			"project_id":  {"12"},
+		}
+		if got, want := fields.Encode(), want.Encode(); got != want {
+			t.Fatalf("unexpected form fields:\n got: %s\nwant: %s", got, want)
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":42,"name":"contract.pdf","deal_id":7}}`))
+	})
+
+	file, err := client.Files.Upload(
+		context.Background(),
+		"contract.pdf",
+		bytes.NewReader(content),
+		WithFilesDealID(DealID(7)),
+		WithFilesPersonID(PersonID(8)),
+		WithFilesOrganizationID(OrganizationID(9)),
+		WithFilesProductID(ProductID(10)),
+		WithFilesActivityID(ActivityID(11)),
+		WithFilesLeadID(LeadID("adf21080-0e10-11eb-879b-46d8c8b5bdb9")),
+		WithFilesProjectID(ProjectID(12)),
+		WithFilesRequestOptions(pipedrive.WithHeader("X-Test", "upload")),
+	)
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 42 || file.Name != "contract.pdf" {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+	if file.DealID == nil || *file.DealID != 7 {
+		t.Fatalf("unexpected deal id: %#v", file.DealID)
+	}
+}
