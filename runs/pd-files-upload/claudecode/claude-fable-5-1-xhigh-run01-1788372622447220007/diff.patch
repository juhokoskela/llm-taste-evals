+// newRetryingRawClient returns a RawClient whose transport retries quickly
+// so body replay can be exercised without real backoff delays.
+func newRetryingRawClient(t *testing.T, srv *httptest.Server) *RawClient {
+	t.Helper()
+
+	policy := RetryPolicy{
+		MaxAttempts: 3,
+		BaseDelay:   time.Millisecond,
+		MaxDelay:    time.Millisecond,
+	}
+	httpClient := NewHTTPClient(Config{
+		BaseURL:     srv.URL,
+		HTTPClient:  srv.Client(),
+		RetryPolicy: &policy,
+	})
+	raw, err := NewRawClient(srv.URL, httpClient)
+	if err != nil {
+		t.Fatalf("NewRawClient error: %v", err)
+	}
+	return raw
+}
+
+// rateLimitOnceServer answers the first request with 429 and every later
+// request with 200, recording each request body and Content-Length.
+func rateLimitOnceServer(t *testing.T) (*httptest.Server, func() ([]string, []int64)) {
+	t.Helper()
+
+	var (
+		mu      sync.Mutex
+		bodies  []string
+		lengths []int64
+	)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		mu.Lock()
+		bodies = append(bodies, string(body))
+		lengths = append(lengths, r.ContentLength)
+		n := len(bodies)
+		mu.Unlock()
+
+		if n == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	t.Cleanup(srv.Close)
+
+	return srv, func() ([]string, []int64) {
+		mu.Lock()
+		defer mu.Unlock()
+		return append([]string(nil), bodies...), append([]int64(nil), lengths...)
+	}
+}
+
