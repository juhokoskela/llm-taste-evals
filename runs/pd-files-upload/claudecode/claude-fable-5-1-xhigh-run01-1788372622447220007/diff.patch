+func TestFilesService_Upload_RetriesOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	rec := &multipartUploadRecorder{}
+	client := newTestClientWithConfig(t, fastRetryConfig(), rec.handler(t))
+
+	// A one-shot reader is enough: Upload buffers the multipart body so the
+	// retry transport can replay it.
+	content := struct{ io.Reader }{strings.NewReader("streamed-bytes")}
+	file, err := client.Files.Upload(context.Background(), "contract.pdf", content, WithFilesDealID(DealID(7)))
+	if err != nil {
+		t.Fatalf("Upload error: %v", err)
+	}
+	if file.ID != 42 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	files, values := rec.attempts()
+	if len(files) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(files))
+	}
+	for i := range files {
+		if files[i] != "streamed-bytes" {
+			t.Fatalf("attempt %d: unexpected file payload %q", i+1, files[i])
+		}
+		if got := values[i].Get("deal_id"); got != "7" {
+			t.Fatalf("attempt %d: unexpected deal_id %q", i+1, got)
+		}
+	}
+}
