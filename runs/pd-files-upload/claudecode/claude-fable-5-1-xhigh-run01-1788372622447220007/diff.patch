+// fastRetryConfig retries 429s immediately so upload replay can be tested
+// without real backoff delays.
+func fastRetryConfig() pipedrive.Config {
+	policy := pipedrive.RetryPolicy{
+		MaxAttempts: 3,
+		BaseDelay:   time.Millisecond,
+		MaxDelay:    time.Millisecond,
+	}
+	return pipedrive.Config{RetryPolicy: &policy}
+}
+
+// multipartUploadRecorder answers the first request with 429 and later
+// requests with a file payload, capturing the parsed multipart form of
+// every attempt so the retried body can be compared with the original.
+type multipartUploadRecorder struct {
+	mu       sync.Mutex
+	files    []string
+	values   []url.Values
+	statuses []int
+}
+
+func (m *multipartUploadRecorder) handler(t *testing.T) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/files" {
+			t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
+		}
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Errorf("parse multipart form: %v", err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		var content string
+		if f, _, err := r.FormFile("file"); err == nil {
+			data, _ := io.ReadAll(f)
+			_ = f.Close()
+			content = string(data)
+		} else {
+			t.Errorf("form file: %v", err)
+		}
+
+		m.mu.Lock()
+		m.files = append(m.files, content)
+		m.values = append(m.values, r.MultipartForm.Value)
+		attempt := len(m.files)
+		m.mu.Unlock()
+
+		if attempt == 1 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"data":{"id":42,"name":"contract.pdf"}}`))
+	}
+}
+
+func (m *multipartUploadRecorder) attempts() ([]string, []url.Values) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return append([]string(nil), m.files...), append([]url.Values(nil), m.values...)
+}
