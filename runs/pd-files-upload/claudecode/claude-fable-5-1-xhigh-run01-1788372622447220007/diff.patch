+func TestFilesService_Add_RetriesFileBodyOnRateLimit(t *testing.T) {
+	t.Parallel()
+
+	rec := &multipartUploadRecorder{}
+	client := newTestClientWithConfig(t, fastRetryConfig(), rec.handler(t))
+
+	// Build the multipart body by hand into a file on disk and hand the
+	// *os.File to Add, as callers did before Upload existed.
+	path := filepath.Join(t.TempDir(), "body.multipart")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatalf("create file: %v", err)
+	}
+	writer := multipart.NewWriter(f)
+	part, err := writer.CreateFormFile("file", "contract.pdf")
+	if err != nil {
+		t.Fatalf("create form file: %v", err)
+	}
+	if _, err := part.Write([]byte("on-disk-bytes")); err != nil {
+		t.Fatalf("write part: %v", err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatalf("close writer: %v", err)
+	}
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		t.Fatalf("seek: %v", err)
+	}
+	defer f.Close()
+
+	file, err := client.Files.Add(context.Background(), f, writer.FormDataContentType())
+	if err != nil {
+		t.Fatalf("Add error: %v", err)
+	}
+	if file.ID != 42 {
+		t.Fatalf("unexpected file: %#v", file)
+	}
+
+	files, _ := rec.attempts()
+	if len(files) != 2 {
+		t.Fatalf("expected 2 attempts, got %d", len(files))
+	}
+	for i := range files {
+		if files[i] != "on-disk-bytes" {
+			t.Fatalf("attempt %d: unexpected file payload %q", i+1, files[i])
+		}
+	}
