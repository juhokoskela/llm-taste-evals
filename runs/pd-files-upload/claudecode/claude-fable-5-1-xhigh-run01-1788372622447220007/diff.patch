+	replay, err := req.GetBody()
+	if err != nil {
+		t.Fatalf("GetBody error: %v", err)
+	}
+	data, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatalf("read replay: %v", err)
+	}
+	if string(data) != "payload" {
+		t.Fatalf("unexpected replay %q", data)
+	}
